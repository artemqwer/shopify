{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}

<style>
  .product-gallery-main img { transition: opacity 0.35s ease; }
  .product-thumb { cursor: pointer; border: 2px solid transparent; transition: border-color 0.2s; }
  .product-thumb.active { border-color: #222; }
  .product-thumb:hover { border-color: #aaa; }

  /* Color swatch */
  .color-swatch {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: border-color 0.2s;
    outline: none;
  }
  .color-swatch.active,
  .color-swatch:hover { border-color: #222; }

  /* Size btn */
  .size-btn {
    min-width: 40px;
    height: 40px;
    padding: 0 10px;
    border: 1.5px solid #d1d1d1;
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    background: transparent;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
  }
  .size-btn.active { border-color: #DE2077 !important; background: #DE2077 !important; color: #fff !important; }
  .size-btn:hover:not(.active) { border-color: #888; }

  /* Accordion */
  .accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .accordion-content.open { max-height: 600px; }
  .accordion-icon { transition: transform 0.3s; }
  .accordion-icon.open { transform: rotate(45deg); }

  /* Size Guide Modal */
  #size-guide-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 99990;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow-y: auto;
  }
  #size-guide-overlay.active { display: flex; }
  #size-guide-modal {
    background: #fff; width: 100%; max-width: 860px;
    position: relative; overflow: hidden;
    margin: auto;
  }
  #size-guide-modal .sg-close {
    position: absolute; top: 16px;
    background: none; border: none; cursor: pointer;
    padding: 8px; z-index: 10; display: flex; align-items: center; justify-content: center;
  }
  #size-guide-overlay[dir="ltr"] .sg-close { right: 16px; }
  #size-guide-overlay[dir="rtl"] .sg-close { left: 16px; }

  #size-guide-modal .sg-body { display: flex; min-height: 420px; position: relative; }
  #size-guide-modal .sg-left {
    flex: 1; padding: 60px 40px 60px 60px;
    display: flex; flex-direction: column; justify-content: center;
  }
  #size-guide-overlay[dir="rtl"] .sg-left { padding: 60px 60px 60px 40px; }
  #size-guide-modal .sg-right {
    width: 320px; flex-shrink: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 60px 40px;
  }
  #size-guide-modal .sg-right img {
    width: 100%; height: auto; display: block;
    mix-blend-mode: multiply;
  }
  #size-guide-modal .sg-right-label {
    text-align: center; color: #555; font-size: 11px;
    font-weight: 500; letter-spacing: 0.05em; margin-bottom: 12px;
    text-transform: uppercase;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
  }
  #size-guide-modal h2.sg-title {
    font-size: 22px; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase; color: #111; margin: 0 0 28px;
    line-height: 1.2; font-family: var(--font-montserrat), Montserrat, sans-serif;
  }
  #size-guide-modal .sg-row {
    border: 1px solid #ccc; padding: 14px 20px;
    font-size: 15px; font-weight: 400; color: #111;
    text-align: center; margin-bottom: 10px;
    font-family: var(--font-montserrat), Montserrat, sans-serif; letter-spacing: 0.03em;
  }
  @media (max-width: 640px) {
    #size-guide-modal .sg-body { flex-direction: column; min-height: unset; }
    #size-guide-modal .sg-left {
      padding: 52px 24px 24px;
      align-items: flex-start;
      order: 1;
    }
    #size-guide-overlay[dir="rtl"] .sg-left { padding: 52px 24px 24px; }
    #size-guide-modal h2.sg-title { font-size: 16px; margin-bottom: 20px; }
    #size-guide-modal .sg-row { font-size: 13px; padding: 12px 16px; }
    #size-guide-modal .sg-right { width: 100%; padding: 0 24px 32px; order: 2; }
    #size-guide-modal .sg-right-label { font-size: 10px; }
    #size-guide-modal .sg-close { top: 10px; }
    #size-guide-overlay[dir="ltr"] .sg-close { right: 10px; }
    #size-guide-overlay[dir="rtl"] .sg-close { left: 10px; }
  }

  /* Buttons */
  .btn-cart {
    width: 100%;
    background: #DE2077 !important;
    color: #fff !important;
    height: 52px;
    font-size: 14px;
    letter-spacing: 0.08em;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-cart:hover { background: #222; }
  .btn-buy {
    width: 100%;
    background: transparent;
    color: #222;
    height: 52px;
    font-size: 14px;
    letter-spacing: 0.08em;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    font-weight: 600;
    border: 1.5px solid #222;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .btn-buy:hover { background: #222; color: #fff; }

  /* ── Product layout ── */
  .product-layout { display: flex; gap: 48px; }
  @media (max-width: 768px) {
    .product-layout { flex-direction: column; gap: 0; }
    .product-gallery-col { width: 100%; }
    .product-info-col { width: 100%; padding: 20px 0 0; }
    /* Remove desktop padding on mobile */
    .product-info-col h1 { font-size: 22px !important; }
    .product-info-col p.price-line { font-size: 15px !important; }
  }

  @media (max-width: 768px) {
    /* Thumbnails hidden on mobile — replaced by full slider + dots */
    .product-thumbs-row { display: none !important; }
    /* Full bleed image on mobile */
    .product-gallery-main {
      margin-left: -1rem;
      margin-right: -1rem;
      width: calc(100% + 2rem) !important;
    }
  }
</style>

{% comment %} ───────── DATA MAPPING ─────────────────────────────
  When a real Shopify product is linked (product.id != blank),
  we use product.title, product.description, product.price, product.images.
  Otherwise we fall through to demo asset-based images + hardcoded copy.
{% endcomment %}

{% comment %} Detect real product vs demo placeholder {% endcomment %}
{% if product.id != blank %}
  {% assign use_real_product = true %}
{% else %}
  {% assign use_real_product = false %}
{% endif %}

{% assign p1_imgs = "product-image-1.png" | split: "," %}
{% assign p2_imgs = "product-image-2.png" | split: "," %}
{% assign p3_imgs = "product-image-3.png" | split: "," %}
{% assign p4_imgs = "product-image-4.png,product-image-5.png,product-image-6.png" | split: "," %}

{% comment %} Choose demo gallery based on handle {% endcomment %}
{% if product.handle == 'leopard-print-scarf' or product.handle == 'leopard-scarf' %}
  {% assign gallery_imgs = p1_imgs %}
  {% assign ui_title_en = "Leopard Scarf" %}
  {% assign ui_title_he = "מטפחת מנומרת" %}
  {% assign ui_desc_en = "Discover the element of wildlife with our Leopard Scarf. Made of premium materials, it has a noble matte sheen and an incredibly pleasant texture. The unique print and deep palette make it not just an accessory, but the centerpiece of your look — from a business suit to a luxurious evening outfit." %}
  {% assign ui_desc_he = "פתחו את עולם הטבע הפראי עם המטפחת המנומרת שלנו. עשויה מחומרים פרמיה עם ברק מט ומרקם נעים במיוחד למגע. הדוגמה הייחודית ופלטת הצבעים העמוקה הופכות אותה לאלמנט מרכזי בכל מתלבש." %}
{% elsif product.handle == 'blue-silk-scarf' or product.handle == 'blue-scarf' %}
  {% assign gallery_imgs = p2_imgs %}
  {% assign ui_title_en = "Blue Silk Scarf" %}
  {% assign ui_title_he = "מטפחת משי כחולה" %}
  {% assign ui_desc_en = "Refined blue silk in its purest form. This scarf is made of natural silk. Pleasant to the touch and incredibly elegant — the perfect choice for those who appreciate quality and style." %}
  {% assign ui_desc_he = "משי כחול מעודן בצורתו הטהורה. מטפחת זו עשויה ממשי טבעי בשיטת הדפסה וינטג'. נעימה למגע ואלגנטית להפליא." %}
{% elsif product.handle == 'pink-scarf' or product.handle == 'rose-scarf' %}
  {% assign gallery_imgs = p3_imgs %}
  {% assign ui_title_en = "Pink Scarf" %}
  {% assign ui_title_he = "מטפחת וורודה" %}
  {% assign ui_desc_en = "Bright and energetic — the pink scarf will be the best accent of your look. Made of high-quality satin, it drapes perfectly and keeps its shape all day long." %}
  {% assign ui_desc_he = "עזה ואנרגטית — המטפחת הוורודה תהיה האקסנט הטוב ביותר בלוקים שלכם. עשויה מסאטן איכותי, שומרת על צורתה לאורך היום." %}
{% else %}
  {% assign gallery_imgs = p4_imgs %}
  {% assign ui_title_en = "Vintage Scarf" %}
  {% assign ui_title_he = "מטפחת וינטג'" %}
  {% assign ui_desc_en = "Feel the aesthetics of past decades in a modern execution. This scarf is inspired by classic 60s looks. Made of premium natural silk, it has a noble matte sheen and an incredibly pleasant texture. The unique print and deep palette make it not just an accessory, but a centerpiece of your look." %}
  {% assign ui_desc_he = "חוו את אסתטיקת העשורים האחרונים בביצוע מודרני. מטפחת זו — שיק צנוע בבית, בהשראת לוקים קלאסיים של שנות ה-60. עשויה ממשי טבעי פרמיה, יש לה ברק מט אצילי ומרקם נעים להפליא למגע. הדוגמה הייחודית ופלטת הצבעים העמוקה הופכות אותה לא רק לאקססוריז, אלא לאלמנט מרכזי של הלוק שלכם." %}
{% endif %}

{% comment %} Locale-aware texts {% endcomment %}
{% if request.locale.iso_code == 'he' %}
  {% if use_real_product %}
    {% assign ui_title = product.title %}
    {% assign ui_desc = product.description | strip_html %}
  {% else %}
    {% assign ui_title = ui_title_he %}
    {% assign ui_desc = ui_desc_he %}
  {% endif %}
  {% assign txt_home = "דף הבית" %}
  {% assign txt_catalog = "קטלוג" %}
  {% assign txt_scarf = "מטפחת" %}
  {% assign txt_buy = "רכישה מידית" %}
  {% assign txt_size_guide = "מדריך מידות" %}
  {% assign txt_material = "חומר" %}
  {% assign txt_care = "טיפול" %}
  {% assign txt_add_cart = "הוסף לסל" %}
  {% assign txt_buy_now = "רכישה עכשיו" %}
  {% assign care_text = "- אל תכבסו במכונת כביסה; השתמשו בניקוי יבש או הלבנה עדינה בידיים עם מגבת לחה לסיבים.\n- ייבשו שטוחים ואל תייבשו במייבש; צאו לאוויר הפתוח בצורה מרווחת לשמור על צורתו.\n- אחסנו בצורה מקופלת ולא תלויה, כדי למנוע עיוות.\n- לטיפול מהיר: כאשר אתם מגהצים את החומר, השתמשו בנייר בין הברזל לבד, ואל תגעו בברזל ישירות." %}
  {% assign material_text = "משי טבעי 100%" %}
{% else %}
  {% if use_real_product %}
    {% assign ui_title = product.title %}
    {% assign ui_desc = product.description | strip_html %}
  {% else %}
    {% assign ui_title = ui_title_en %}
    {% assign ui_desc = ui_desc_en %}
  {% endif %}
  {% assign txt_home = "Home" %}
  {% assign txt_catalog = "Catalog" %}
  {% assign txt_scarf = "Scarf" %}
  {% assign txt_buy = "Buy Now" %}
  {% assign txt_size_guide = "Size Guide" %}
  {% assign txt_material = "Material" %}
  {% assign txt_care = "Care" %}
  {% assign txt_add_cart = "Add to cart" %}
  {% assign txt_buy_now = "Buy Now" %}
  {% assign care_text = "- Cleaning: do not machine wash; use dry cleaning or gently remove dirt with a damp cloth.\n- Drying: do not dry on a radiator; leave it to rest in a well-ventilated area, keeping its shape.\n- Store in a dry place, away from direct sunlight; preferably in a box to prevent deformation.\n- Fabric care: refresh the material with steam from a distance occasionally; do not touch directly with an iron." %}
  {% assign material_text = "100% natural silk" %}
{% endif %}

{% comment %} ─── PRICE ─── {% endcomment %}
{% if use_real_product and product.price > 0 %}
  {% assign product_price = product.price | money %}
{% else %}
  {% assign product_price = "$ 80" %}
{% endif %}

{% comment %} ─── GALLERY IMAGES ─── {% endcomment %}
{% if product.images.size > 0 %}
  {% assign use_shopify_imgs = true %}
{% else %}
  {% assign use_shopify_imgs = false %}
{% endif %}

<div class="w-full max-w-[1920px] mx-auto px-4 md:px-[160px] pt-[12px] pb-[64px]" {% if request.locale.iso_code == 'he' %}dir="rtl"{% endif %}>

  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 mb-[28px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
    {% if request.locale.iso_code == 'he' %}
      <span class="text-[10px] tracking-[0.12em] uppercase text-gray-800" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ ui_title | upcase }}</span>
      <span class="text-gray-300 text-[10px]">‹</span>
      <span class="text-[10px] tracking-[0.12em] uppercase text-gray-400">{{ txt_scarf }}</span>
      <span class="text-gray-300 text-[10px]">‹</span>
      <a href="{{ routes.all_products_collection_url }}" class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_catalog }}</a>
      <span class="text-gray-300 text-[10px]">‹</span>
      <a href="{{ routes.root_url }}" class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_home }}</a>
    {% else %}
      <a href="{{ routes.root_url }}" class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_home }}</a>
      <span class="text-gray-300 text-[10px]">›</span>
      <a href="{{ routes.all_products_collection_url }}" class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_catalog }}</a>
      <span class="text-gray-300 text-[10px]">›</span>
      <span class="text-[10px] tracking-[0.12em] uppercase text-gray-400">{{ txt_scarf }}</span>
      <span class="text-gray-300 text-[10px]">›</span>
      <span class="text-[10px] tracking-[0.12em] uppercase text-gray-800">{{ ui_title | upcase }}</span>
    {% endif %}
  </nav>

  <!-- Main Product Layout -->
  <div class="product-layout">

    <!-- ═══ LEFT: GALLERY ═══ -->
    <div class="product-gallery-col w-full md:w-[55%] flex-shrink-0">

      <!-- Main big image -->
      <div class="product-gallery-main relative w-full overflow-hidden mb-3" style="aspect-ratio: 3/4;">
        {% if use_shopify_imgs %}
          <img id="gallery-main-img"
               src="{{ product.images[0] | image_url: width: 1000 }}"
               alt="{{ product.title }}"
               class="absolute inset-0 w-full h-full object-cover"
               loading="eager" />
        {% else %}
          <img id="gallery-main-img"
               src="{{ gallery_imgs[0] | asset_url }}"
               alt="{{ ui_title | escape }}"
               class="absolute inset-0 w-full h-full object-cover"
               loading="eager" />
        {% endif %}

      </div>

      <!-- Thumbnails row (2 side by side below) -->
      {% if use_shopify_imgs %}
        {% if product.images.size > 1 %}
          <div class="product-thumbs-row grid gap-3" style="grid-template-columns: repeat({{ product.images.size | minus: 1 | at_least: 1 }}, 1fr);">
            {% for image in product.images offset: 1 %}
              <div class="product-thumb relative overflow-hidden"
                   style="aspect-ratio: 1/1;"
                   onclick="setMainImg('{{ image | image_url: width: 1000 }}', this)">
                <img src="{{ image | image_url: width: 400 }}"
                     alt="{{ product.title }}"
                     class="absolute inset-0 w-full h-full object-cover" />
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        {% if gallery_imgs.size > 1 %}
          <div class="product-thumbs-row grid gap-3" style="grid-template-columns: repeat({{ gallery_imgs.size | minus: 1 | at_least: 1 }}, 1fr);">
            {% for img_name in gallery_imgs offset: 1 %}
              <div class="product-thumb relative overflow-hidden"
                   style="aspect-ratio: 1/1;"
                   onclick="setMainImg('{{ img_name | asset_url }}', this)">
                <img src="{{ img_name | asset_url }}"
                     alt="{{ ui_title | escape }}"
                     class="absolute inset-0 w-full h-full object-cover" />
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}


    </div><!-- /gallery -->

    <!-- ═══ RIGHT: PRODUCT INFO ═══ -->
    <div class="product-info-col flex-1 flex flex-col pt-0">

      <!-- Title -->
      <h1 class="text-[22px] md:text-[32px] font-bold text-[#222] tracking-wider uppercase mb-1"
          style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        {{ ui_title }}
      </h1>

      <!-- Price -->
      <p class="text-[18px] text-[#444] mb-5"
         style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        {{ product_price }}
      </p>

      <!-- Description -->
      <p class="text-[13px] text-[#555] leading-[1.75] mb-7"
         style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        {{ ui_desc }}
      </p>

      <!-- Color swatches + size guide link -->
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <button class="color-swatch active" style="background:#1b2536;" aria-label="Dark Blue"></button>
          <button class="color-swatch" style="background:#63141f;" aria-label="Bordeaux"></button>
          <button class="color-swatch" style="background:#3d2b2b;" aria-label="Dark brown"></button>
        </div>
        <button type="button" onclick="openSizeGuide()" class="text-[12px] text-[#888] underline hover:text-[#333] transition-colors bg-transparent border-none cursor-pointer p-0"
           style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
          {{ txt_size_guide }}
        </button>
      </div>

      <!-- Size selector -->
      <div class="mb-7">
        <div class="flex items-center gap-3">
          <button class="size-btn" onclick="selectSize(this)">S</button>
          <button class="size-btn active" onclick="selectSize(this)">M</button>
          <button class="size-btn" onclick="selectSize(this)">L</button>
        </div>
      </div>

      <!-- Add to cart -->
      <div class="flex flex-col gap-3 mb-8">
        <button type="button" id="btn-add-cart" class="btn-cart"
                data-variant-id="{{ product.variants.first.id }}"
                data-title="{{ ui_title | escape }}"
                data-price="{{ product_price | escape }}"
                data-image="{% if use_shopify_imgs %}{{ product.images[0] | image_url: width: 400 }}{% else %}{{ gallery_imgs[0] | asset_url }}{% endif %}"
                onclick="handleAddToCart(this)">
          {{ txt_add_cart }}
        </button>
        <a href="{% if use_real_product and product.variants.first.id != blank %}{{ routes.search_url }}?view=order{% else %}{{ routes.search_url }}?view=order{% endif %}" class="btn-buy">{{ txt_buy_now }}</a>
      </div>

      <!-- Accordion: Material -->
      <div class="border-t border-[#e5e5e5]">
        <button class="w-full flex items-center justify-between py-4 text-left" onclick="toggleAccordion('acc-material')">
          <span class="text-[13px] font-medium text-[#222] tracking-wider"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ txt_material }}</span>
          <span id="acc-material-icon" class="accordion-icon text-[20px] font-light text-[#222] leading-none">+</span>
        </button>
        <div id="acc-material" class="accordion-content">
          <p class="text-[13px] text-[#555] leading-[1.75] pb-4"
             style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
            {{ material_text }}
          </p>
        </div>
      </div>

      <!-- Accordion: Care -->
      <div class="border-t border-[#e5e5e5]">
        <button class="w-full flex items-center justify-between py-4 text-left" onclick="toggleAccordion('acc-care')">
          <span class="text-[13px] font-medium text-[#222] tracking-wider"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ txt_care }}</span>
          <span id="acc-care-icon" class="accordion-icon text-[20px] font-light text-[#e61a7a] leading-none">–</span>
        </button>
        <div id="acc-care" class="accordion-content open">
          <div class="text-[13px] text-[#555] leading-[1.9] pb-4"
               style="font-family: var(--font-montserrat), Montserrat, sans-serif; white-space: pre-line;">{{ care_text }}</div>
        </div>
      </div>
      <div class="border-t border-[#e5e5e5]"></div>

    </div><!-- /info -->
  </div><!-- /flex layout -->
</div>

<!-- ═══ SIZE GUIDE MODAL ═══ -->
<div id="size-guide-overlay" onclick="if(event.target===this)closeSizeGuide()" dir="{% if request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}">
  <div id="size-guide-modal">
    <button class="sg-close" onclick="closeSizeGuide()" aria-label="Close">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <div class="sg-body">
      <div class="sg-left">
        <h2 class="sg-title">
          {% if request.locale.iso_code == 'he' %}מידה – היקף ראש{% else %}SIZE — HEAD CIRCUMFERENCE{% endif %}
        </h2>
        <div class="sg-row" dir="ltr">S - 56 {% if request.locale.iso_code == 'he' %}ס"מ{% else %}cm{% endif %}</div>
        <div class="sg-row" dir="ltr">M - 57 {% if request.locale.iso_code == 'he' %}ס"מ{% else %}cm{% endif %}</div>
        <div class="sg-row" dir="ltr">L - 58 {% if request.locale.iso_code == 'he' %}ס"מ{% else %}cm{% endif %}</div>
      </div>
      <div class="sg-right">
        <div class="sg-right-label">
          {% if request.locale.iso_code == 'he' %}מדוד לפי הקו הזה{% else %}MEASURE ALONG THIS LINE{% endif %}
        </div>
        <img src="{{ 'image2.svg' | asset_url }}" 
             alt="{% if request.locale.iso_code == 'he' %}מדידת ראש{% else %}Measurement{% endif %}" 
             loading="lazy">
      </div>
    </div>
  </div>
</div>

<script>
  // Size Guide modal
  function openSizeGuide() {
    const el = document.getElementById('size-guide-overlay');
    if (el) { el.classList.add('active'); document.body.style.overflow = 'hidden'; }
  }
  function closeSizeGuide() {
    const el = document.getElementById('size-guide-overlay');
    if (el) { el.classList.remove('active'); document.body.style.overflow = ''; }
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeSizeGuide();
  });

  // Gallery switcher
  function setMainImg(src, thumbEl) {
    const main = document.getElementById('gallery-main-img');
    if (main) { main.style.opacity = '0'; setTimeout(() => { main.src = src; main.style.opacity = '1'; }, 180); }
    document.querySelectorAll('.product-thumb').forEach(t => t.classList.remove('active'));
    if (thumbEl) thumbEl.classList.add('active');
  }

  // Mobile gallery swipe
  (function() {
    const mainImg = document.getElementById('gallery-main-img');
    if (!mainImg) return;
    const images = [mainImg.src];
    document.querySelectorAll('.product-thumbs-row img').forEach(img => images.push(img.src));
    if (images.length <= 1) return;
    let current = 0;
    function goTo(idx) {
      current = idx;
      mainImg.style.opacity = '0';
      setTimeout(() => { mainImg.src = images[idx]; mainImg.style.opacity = '1'; }, 180);
    }
    let startX = 0;
    mainImg.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
    mainImg.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) < 40) return;
      if (dx < 0 && current < images.length - 1) goTo(current + 1);
      else if (dx > 0 && current > 0) goTo(current - 1);
    });
  })();

  // Size selector
  function selectSize(btn) {
    document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  // Color swatch
  document.querySelectorAll('.color-swatch').forEach(sw => {
    sw.addEventListener('click', function() {
      document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
      this.classList.add('active');
    });
  });

  // Accordion
  function toggleAccordion(id) {
    const content = document.getElementById(id);
    const icon = document.getElementById(id + '-icon');
    if (!content) return;
    const isOpen = content.classList.contains('open');
    content.classList.toggle('open', !isOpen);
    if (icon) {
      icon.classList.toggle('open', !isOpen);
      icon.textContent = isOpen ? '+' : '–';
      if (id === 'acc-care') {
        icon.style.color = isOpen ? '#222' : '#e61a7a';
      }
    }
  }

  // Add to cart (real Shopify product OR demo mock)
  function handleAddToCart(btn) {
    const variantId = btn.dataset.variantId;
    const title     = btn.dataset.title  || 'Product';
    const price     = btn.dataset.price  || '$0';
    const image     = btn.dataset.image  || '';

    const original = btn.textContent.trim();
    btn.textContent = '...';
    btn.disabled = true;
    btn.style.opacity = '0.7';

    const restore = () => {
      btn.textContent = original;
      btn.disabled = false;
      btn.style.opacity = '';
    };

    if (window.EsterCart) {
      window.EsterCart.add(variantId, 1, { title, price, image })
        .catch(restore)
        .finally(restore);
    } else {
      restore();
    }
  }
</script>
