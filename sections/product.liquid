{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}

<style>
  .product-gallery-main img { transition: opacity 0.35s ease; }
  .product-thumb { cursor: pointer; border: 2px solid transparent; transition: border-color 0.2s; }
  .product-thumb.active { border-color: #222; }
  .product-thumb:hover { border-color: #aaa; }

  /* Color swatch */
  .color-swatch {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: border-color 0.2s;
    outline: none;
  }
  .color-swatch.active,
  .color-swatch:hover { border-color: #222; }

  /* Size btn */
  .size-btn {
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border: 1.5px solid #d1d1d1;
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    background: transparent;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
  }
  .size-btn.active { border-color: #222; background: #222; color: #fff; }
  .size-btn:hover:not(.active) { border-color: #888; }

  /* Accordion */
  .accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .accordion-content.open { max-height: 600px; }
  .accordion-icon { transition: transform 0.3s; }
  .accordion-icon.open { transform: rotate(45deg); }

  /* Buttons */
  .btn-cart {
    width: 100%;
    background: #222;
    color: #fff;
    height: 52px;
    font-size: 14px;
    letter-spacing: 0.08em;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-cart:hover { background: #444; }
  .btn-buy {
    width: 100%;
    background: transparent;
    color: #222;
    height: 52px;
    font-size: 14px;
    letter-spacing: 0.08em;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    font-weight: 600;
    border: 1.5px solid #222;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .btn-buy:hover { background: #222; color: #fff; }

  /* Zoom gallery on mobile */
  @media (max-width: 768px) {
    .product-layout { flex-direction: column; }
    .product-gallery-col { width: 100%; }
    .product-info-col { width: 100%; padding: 24px 0 0; }
  }
</style>

