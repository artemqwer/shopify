{% schema %}
{
  "name": "Returns & Exchange",
  "settings": []
}
{% endschema %}

<div class="w-full bg-white">
  <div class="max-w-[1280px] mx-auto px-5 md:px-[20px] pt-10 pb-16" style="font-family: Montserrat, sans-serif;">

    <p class="text-[15px] text-[#111] leading-[1.65] mb-8">{{ 'returns.intro' | t }}</p>

    <ol class="flex flex-col gap-7 list-none mb-8">

      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">1. {{ 'returns.condition_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.condition_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.condition_item2' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.condition_item3' | t }}</li>
        </ul>
      </li>

      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">2. {{ 'returns.deadline_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.deadline_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.deadline_item2' | t }}</li>
        </ul>
      </li>

      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">3. {{ 'returns.defect_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.defect_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.defect_item2' | t }}</li>
        </ul>
      </li>

      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">4. {{ 'returns.process_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.process_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.process_item2' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.process_item3' | t }}</li>
        </ul>
      </li>

      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">5. {{ 'returns.important_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.important_item1' | t }}</li>
        </ul>
      </li>

    </ol>

    <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'returns.outro' | t }}</p>

  </div>
</div>
