        <div class="flex flex-col space-y-1 md:space-y-1.5 px-0.5 md:px-1" {% if request.locale.iso_code == 'he' %}style="text-align: right; direction: rtl;"{% endif %}>
          <h3 class="text-[11px] md:text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors"
              style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
            {{ 'products.product_4' | t }}
          </h3>
          <p class="text-[11px] font-medium md:text-[13px] md:font-light text-gray-500" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
            $ 80
          </p>
        </div>
      </a>

      <!-- Product 3: Powder / Pink -->
      <a href="{{ routes.search_url }}?view=demo&product=pink-scarf" class="popular-card cursor-pointer flex flex-col group no-underline">
        <div class="relative aspect-[3/4] mb-3 md:mb-4 overflow-hidden w-full bg-gray-100">
          <img src="{{ 'product-image-3.png' | asset_url }}" alt="{{ 'products.product_3' | t }}"
               width="600" height="800"
               class="popular-card-img absolute inset-0 w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="flex flex-col space-y-1 md:space-y-1.5 px-0.5 md:px-1" {% if request.locale.iso_code == 'he' %}style="text-align: right; direction: rtl;"{% endif %}>
          <h3 class="text-[11px] md:text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors"
              style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
            {{ 'products.product_3' | t }}
          </h3>
          <p class="text-[11px] font-medium md:text-[13px] md:font-light text-gray-500" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
            $ 80
          </p>
        </div>
      </a>

      <!-- Product 4: Blue -->
      <a href="{{ routes.search_url }}?view=demo&product=blue-silk-scarf" class="popular-card cursor-pointer flex flex-col group no-underline">
        <div class="relative aspect-[3/4] mb-3 md:mb-4 overflow-hidden w-full bg-gray-100">
          <img src="{{ 'product-image-2.png' | asset_url }}" alt="{{ 'products.product_2' | t }}"
               width="600" height="800"
               class="popular-card-img absolute inset-0 w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="flex flex-col space-y-1 md:space-y-1.5 px-0.5 md:px-1" {% if request.locale.iso_code == 'he' %}style="text-align: right; direction: rtl;"{% endif %}>
          <h3 class="text-[11px] md:text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors"
              style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
            {{ 'products.product_2' | t }}
          </h3>
          <p class="text-[11px] font-medium md:text-[13px] md:font-light text-gray-500" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
            $ 80
          </p>
        </div>
      </a>
      
    {% endif %}

  </div>


</div>
