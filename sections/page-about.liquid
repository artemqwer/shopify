{% schema %}
{
  "name": "About Page",
  "settings": []
}
{% endschema %}

<div class="w-full bg-white">

  <!-- Text block 1 -->
  <div class="px-5 md:px-[160px] pt-10 pb-8">
    <h1 class="text-[26px] font-bold text-[#111] mb-7 leading-tight" style="font-family: Montserrat, sans-serif;">
      {{ 'about.title' | t }}
    </h1>
    <div class="flex flex-col gap-5">
      <p class="text-[15px] font-normal text-[#111] leading-[1.65]" style="font-family: Montserrat, sans-serif;">
        {{ 'about.p1' | t }}
      </p>
      <p class="text-[15px] font-normal text-[#111] leading-[1.65]" style="font-family: Montserrat, sans-serif;">
        {{ 'about.p2' | t }}
      </p>
      <p class="text-[15px] font-normal text-[#111] leading-[1.65]" style="font-family: Montserrat, sans-serif;">
        {{ 'about.p3' | t }}
      </p>
    </div>
  </div>

  <!-- Image 1 (full-width) -->
  <div class="w-full mb-8">
    <img
      src="{{ 'product-image-1.png' | asset_url }}"
      alt="{{ 'about.title' | t }}"
      class="w-full object-cover"
      loading="lazy"
    />
  </div>

  <!-- Text block 2 -->
  <div class="px-5 md:px-[160px] pb-8">
    <div class="flex flex-col gap-5">
      <p class="text-[15px] font-normal text-[#111] leading-[1.65]" style="font-family: Montserrat, sans-serif;">
        {{ 'about.p4' | t }}
      </p>
      <p class="text-[15px] font-normal text-[#111] leading-[1.65]" style="font-family: Montserrat, sans-serif;">
        {{ 'about.p5' | t }}
      </p>
    </div>
  </div>

  <!-- Image 2 (full-width) -->
  <div class="w-full pb-16">
    <img
      src="{{ 'product-image-4.png' | asset_url }}"
      alt="{{ 'about.title' | t }}"
      class="w-full object-cover"
      loading="lazy"
    />
  </div>

</div>
