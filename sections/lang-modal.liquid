<!-- ==========================================
     LANGUAGE SELECTION MODAL
=========================================== -->
<style>
  #lang-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 100000;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  #lang-modal-overlay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  #lang-modal {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100001;
    background: #fff;
    padding: 24px 20px 36px;
    transform: translateY(100%);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    visibility: hidden;
  }

  #lang-modal.is-visible {
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
  }

  #lang-modal .lang-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  #lang-modal .lang-modal-title {
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #222;
    margin: 0;
  }

  #lang-modal .lang-modal-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #222;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lang-modal .lang-modal-close:hover {
    opacity: 0.5;
  }

  #lang-modal .lang-options {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #lang-modal .lang-btn {
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    font-size: 13px;
    font-weight: 400;
    padding: 14px 16px;
    text-align: center;
    cursor: pointer;
    border: 1px solid #222;
    background: #fff;
    color: #222;
    width: 100%;
    transition: background 0.2s ease, color 0.2s ease;
    -webkit-appearance: none;
  }

  #lang-modal .lang-btn:hover {
    background: #f5f5f5;
  }

  #lang-modal .lang-btn.is-active {
    background: #e61a7a;
    color: #fff;
    border-color: #e61a7a;
  }

  @media (min-width: 640px) {
    #lang-modal-overlay {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #lang-modal {
      position: relative;
      bottom: auto;
      left: auto;
      right: auto;
      transform: translateY(20px);
      opacity: 0;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
      width: 360px;
      max-width: 90vw;
      pointer-events: none;
      visibility: hidden;
    }

    #lang-modal.is-visible {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }
  }
</style>

<div id="lang-modal-overlay"></div>

<div id="lang-modal" role="dialog" aria-modal="true" aria-labelledby="lang-modal-title">

  <div class="lang-modal-header">
    <h2 class="lang-modal-title" id="lang-modal-title">Choose your language</h2>
    <button type="button" class="lang-modal-close" id="lang-modal-close-btn" aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  {% form 'localization', class: 'lang-options' %}
    <button type="submit" name="locale_code" value="en"
            class="lang-btn {% if request.locale.iso_code == 'en' %}is-active{% endif %}">
      English
    </button>
    <button type="submit" name="locale_code" value="he"
            class="lang-btn {% if request.locale.iso_code == 'he' %}is-active{% endif %}">
      עברית
    </button>
    <button type="submit" name="locale_code" value="uk"
            class="lang-btn {% if request.locale.iso_code == 'uk' %}is-active{% endif %}">
      Українська
    </button>
    <button type="submit" name="locale_code" value="fr"
            class="lang-btn {% if request.locale.iso_code == 'fr' %}is-active{% endif %}">
      Français
    </button>
  {% endform %}

</div>

<script>
(function() {
  var LANG_KEY = 'lang_selected_v1';
  var overlay  = document.getElementById('lang-modal-overlay');
  var modal    = document.getElementById('lang-modal');
  var closeBtn = document.getElementById('lang-modal-close-btn');

  function showLangModal() {
    if (!overlay || !modal) return;
    overlay.classList.add('is-visible');
    setTimeout(function() { modal.classList.add('is-visible'); }, 30);
    document.body.style.overflow = 'hidden';
  }

  function hideLangModal() {
    if (!modal || !overlay) return;
    modal.classList.remove('is-visible');
    overlay.classList.remove('is-visible');
    document.body.style.overflow = '';
    try { localStorage.setItem(LANG_KEY, '1'); } catch(e) {}
    document.dispatchEvent(new CustomEvent('langModalDone'));
    if (typeof window._cookieBannerShow === 'function') {
      setTimeout(window._cookieBannerShow, 400);
      window._cookieBannerShow = null;
    }
  }

  /* Always register handlers */
  if (closeBtn) {
    closeBtn.addEventListener('click', hideLangModal);
  }
  if (overlay) {
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) hideLangModal();
    });
  }
  if (modal) {
    modal.querySelectorAll('.lang-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        try { localStorage.setItem(LANG_KEY, '1'); } catch(e) {}
        /* form will navigate — no need to dispatch, cookie banner reads key on next load */
      });
    });
  }

  /* Already selected — skip */
  try { if (localStorage.getItem(LANG_KEY)) return; } catch(e) {}

  /* First visit — show immediately */
  setTimeout(showLangModal, 500);
})();
</script>

{% schema %}
{
  "name": "Language Modal"
}
{% endschema %}
