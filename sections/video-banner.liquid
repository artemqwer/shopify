{% schema %}
{
  "name": "Video Banner",
  "settings": [
    {
      "type": "video",
      "id": "banner_video",
      "label": "Banner Video (Mobile)"
    }
  ]
}
{% endschema %}

<section class="w-full mt-8 md:mt-12 mb-[32px] md:mb-24 block md:hidden">
  <div class="relative w-full aspect-[390/500] overflow-hidden bg-black/5">
    {% if section.settings.banner_video != blank %}
      {{ section.settings.banner_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: 'master', class: 'absolute inset-0 w-full h-full object-cover', id: 'video-banner-el' }}
    {% else %}
      <div class="absolute inset-0 w-full h-full flex flex-col items-center justify-center bg-gray-100 text-gray-500 p-4 text-center">
        <svg fill="currentColor" class="w-8 h-8 mb-2" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
        <p class="text-sm font-medium">Please upload a video in Theme Customizer</p>
      </div>
    {% endif %}
  </div>
</section>
