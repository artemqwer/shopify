{% schema %}
{
  "name": "Reviews Slider",
  "settings": [],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Main Review Image"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Review Date (e.g. 'The day before')",
          "default": "The day before"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Amit Saror"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Is Verified",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating (1-5 stars)",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "review_text",
          "label": "Review Text (e.g. 'Whoa!')",
          "default": "Whoa!"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Thumbnail"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title / Description",
          "default": "A gray beam square handkerchief"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Slider",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}

<section class="max-w-[1280px] mx-auto px-4 md:px-[20px] pt-8 md:pt-12 pb-16 overflow-hidden">
  <div class="w-full">
    <div class="relative w-full overflow-x-auto scrollbar-hide snap-x snap-mandatory flex gap-[12px] md:gap-[24px] pb-6">
      {% for block in section.blocks %}
        <div class="min-w-[280px] md:min-w-[340px] flex-1 snap-start" {{ block.shopify_attributes }}>
          <div class="bg-white border border-[#eee] rounded-sm overflow-hidden flex flex-col h-full hover:border-gray-300 transition-colors">
            
            {% comment %} Top Image {% endcomment %}
            <div class="aspect-[4/5] w-full overflow-hidden bg-gray-50">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="Review photo" width="600" height="750" class="w-full h-full object-cover" loading="lazy" />
              {% else %}
                <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-200">
                  <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              {% endif %}
            </div>

            {% comment %} Content Area {% endcomment %}
            <div class="p-5 flex flex-col flex-1" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              
              <div class="flex items-center justify-between mb-4">
                <span class="text-[11px] text-gray-400 font-light uppercase tracking-wider">{{ block.settings.date }}</span>
                <div class="flex items-center gap-2">
                  {% if block.settings.verified %}
                    <span class="text-[#222] text-[10px] px-2 py-0.5 rounded-none border border-[#eee] uppercase tracking-widest font-normal">Verified</span>
                  {% endif %}
                  <span class="text-[12px] font-semibold text-gray-900 tracking-wide uppercase">{{ block.settings.author }}</span>
                </div>
              </div>

              {% comment %} Stars & Headline {% endcomment %}
              <div class="flex flex-col items-end space-y-1.5 mb-5">
                <div class="flex gap-0.5">
                  {% for i in (1..5) %}
                    <svg class="w-3.5 h-3.5 {% if i <= block.settings.rating %}text-black{% else %}text-gray-200{% endif %}" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                  {% endfor %}
                </div>
                <h4 class="text-[16px] font-medium text-gray-900 tracking-tight leading-tight">{{ block.settings.review_text }}</h4>
              </div>

              {% comment %} Product Snapshot {% endcomment %}
              <a href="{{ block.settings.product_url | default: '#' }}" class="mt-auto pt-4 border-t border-[#f5f5f5] flex items-center gap-3 group/prod">
                <div class="w-14 h-14 rounded-none overflow-hidden flex-shrink-0 bg-gray-50 border border-[#eee]">
                  {% if block.settings.product_image != blank %}
                    <img src="{{ block.settings.product_image | image_url: width: 200 }}" alt="Product" class="w-full h-full object-cover transition-transform duration-500 group-hover/prod:scale-110" />
                  {% else %}
                    <div class="w-full h-full flex items-center justify-center bg-gray-50 text-gray-200">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                  {% endif %}
                </div>
                <p class="text-[12px] font-semibold text-gray-900 leading-tight tracking-wide group-hover/prod:text-gray-500 transition-colors">{{ block.settings.product_title }}</p>
              </a>

            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
