{% schema %}
{
  "name": "Reviews Slider",
  "settings": [],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Main Review Image"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Review Date (e.g. 'The day before')",
          "default": "The day before"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Amit Saror"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Is Verified",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating (1-5 stars)",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "review_text",
          "label": "Review Text (e.g. 'Whoa!')",
          "default": "Whoa!"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Thumbnail"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title / Description",
          "default": "A gray beam square handkerchief"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Slider",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}

<section class="max-w-[1280px] mx-auto px-4 md:px-[20px] pt-8 md:pt-12 pb-16 overflow-hidden">
  <div class="w-full">
    <div class="relative w-full overflow-x-auto scrollbar-hide snap-x snap-mandatory flex gap-[16px] md:gap-[24px] pb-6">
      {% for block in section.blocks %}
        <div class="w-[210px] md:w-[320px] flex-shrink-0 snap-start group cursor-default" {{ block.shopify_attributes }}>
          <div class="flex flex-col h-full">
            
            {% comment %} Top Image {% endcomment %}
            <div class="relative aspect-[3/4] mb-3 md:mb-4 w-full overflow-hidden bg-gray-100">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="Review photo" width="600" height="800" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-105" loading="lazy" />
              {% else %}
                <div class="absolute inset-0 w-full h-full flex items-center justify-center bg-gray-100 text-gray-200">
                  <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              {% endif %}
            </div>

            {% comment %} Content Area {% endcomment %}
            <div class="flex flex-col flex-1 px-1" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              
              <div class="flex items-start justify-between mb-3">
                <div class="flex flex-col space-y-1">
                  <span class="text-[13px] font-semibold text-gray-900 tracking-wide">{{ block.settings.author }}</span>
                  <span class="text-[11px] text-gray-500 font-light">{{ block.settings.date }}</span>
                </div>
                <div class="flex flex-col items-end gap-1.5 pt-0.5">
                  <div class="flex gap-[1px]">
                    {% for i in (1..5) %}
                      <svg class="w-3 h-3 {% if i <= block.settings.rating %}text-black{% else %}text-gray-200{% endif %}" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                      </svg>
                    {% endfor %}
                  </div>
                  {% if block.settings.verified %}
                    <span class="text-[#e61a7a] text-[9px] px-1.5 py-[1px] rounded-[2px] border border-[#e61a7a]/20 bg-[#e61a7a]/5 uppercase tracking-wider font-semibold flex items-center gap-0.5">
                      <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                      </svg>
                      Verified
                    </span>
                  {% endif %}
                </div>
              </div>

              {% comment %} Headline {% endcomment %}
              <div class="mb-5">
                <h4 class="text-[14px] font-medium text-gray-900 tracking-tight leading-relaxed">{{ block.settings.review_text }}</h4>
              </div>

              {% comment %} Product Snapshot {% endcomment %}
              <a href="{{ block.settings.product_url | default: '#' }}" class="mt-auto pt-3 border-t border-gray-100 flex items-center gap-3 group/prod">
                <div class="w-10 h-10 overflow-hidden flex-shrink-0 bg-gray-50 border border-gray-100 rounded-sm">
                  {% if block.settings.product_image != blank %}
                    <img src="{{ block.settings.product_image | image_url: width: 200 }}" alt="Product" class="w-full h-full object-cover transition-opacity duration-300 group-hover/prod:opacity-75" />
                  {% else %}
                    <div class="w-full h-full flex items-center justify-center bg-gray-50 text-gray-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                  {% endif %}
                </div>
                <p class="text-[11px] font-medium text-gray-500 leading-tight tracking-wide group-hover/prod:text-[#e61a7a] transition-colors">{{ block.settings.product_title }}</p>
              </a>

            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
