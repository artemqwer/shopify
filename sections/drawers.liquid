<!-- ==========================================
     GLOBAL DRAWERS: CART & FILTERS
=========================================== -->
{% schema %}
{
  "name": "Drawers",
  "settings": []
}
{% endschema %}

<style>
  /* Base Drawer Overlay */
  #drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 10000;
    display: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(4px);
    cursor: pointer;
  }
  
  /* Sidebar Drawer Base */
  .side-drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    background: #ffffff;
    z-index: 10001;
    box-shadow: -10px 0 30px rgba(0,0,0,0.1);
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex !important;
    flex-direction: column;
    width: 100%;
  }

  @media (min-width: 640px) {
    #cart-drawer { width: 500px; }
    #filter-drawer { width: 450px; }
  }

  /* State: Visible */
  .side-drawer.is-open {
    transform: translateX(0) !important;
  }
</style>

<!-- Overlay remains fixed at body bottom -->
<div id="drawer-overlay"></div>

<!-- ==========================================
     SHOPPING CART DRAWER
=========================================== -->
<div id="cart-drawer" class="side-drawer flex flex-col h-full bg-white shadow-xl" role="dialog" aria-modal="true" aria-label="Cart">
  <!-- Header -->
  <div class="relative px-10 pt-10 pb-6 bg-white flex flex-col flex-shrink-0">
    <button type="button" class="drawer-close-btn absolute right-6 top-6 p-2 hover:opacity-50 transition-opacity">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="#222" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <h2 class="text-center text-[36px] font-medium text-[#222222] mt-4 mb-2 uppercase tracking-wide" style="font-family: var(--font-montserrat);">Shopping Cart</h2>
  </div>

  <!-- Items Content -->
  <div class="flex-1 overflow-y-auto px-10 bg-white">
    <!-- Item 1 -->
    <div class="flex py-6 border-b border-[#e5e5e5]">
      <div class="w-[100px] h-[100px] flex-shrink-0 mr-6">
        <img src="{{ 'product-image-1.png' | asset_url }}" alt="Vintage Scarf" class="w-full h-full object-cover">
      </div>
      <div class="flex-1 flex flex-col justify-between">
        <div>
          <h3 class="text-[18px] text-[#222222] font-normal" style="font-family: var(--font-montserrat);">Vintage Scarf</h3>
          <p class="text-[14px] text-[#a0a0a0] mt-1 font-light" style="font-family: var(--font-montserrat);">Price: $80<span class="px-[2px]">|</span>Size: M</p>
        </div>
        <div class="flex items-center justify-between mt-3">
          <div class="flex items-center border border-[#e5e5e5] h-8 w-24">
            <button class="flex-1 flex justify-center items-center h-full border-r border-[#e5e5e5] text-gray-500 hover:text-black">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 12H4"/></svg>
            </button>
            <span class="flex-1 flex justify-center items-center h-full text-[14px] text-gray-600" style="font-family: var(--font-montserrat);">1</span>
            <button class="flex-1 flex justify-center items-center h-full border-l border-[#e5e5e5] text-gray-500 hover:text-black">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/></svg>
            </button>
          </div>
          <button class="text-[#c1c1c1] hover:text-red-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Item 2 -->
    <div class="flex py-6 border-b border-[#e5e5e5]">
      <div class="w-[100px] h-[100px] flex-shrink-0 mr-6">
        <img src="{{ 'product-image-2.png' | asset_url }}" alt="Pink Scarf" class="w-full h-full object-cover">
      </div>
      <div class="flex-1 flex flex-col justify-between">
        <div>
          <h3 class="text-[18px] text-[#222222] font-normal" style="font-family: var(--font-montserrat);">Pink Scarf</h3>
          <p class="text-[14px] text-[#a0a0a0] mt-1 font-light" style="font-family: var(--font-montserrat);">Price: $80<span class="px-[2px]">|</span>Size: S</p>
        </div>
        <div class="flex items-center justify-between mt-3">
          <div class="flex items-center border border-[#e5e5e5] h-8 w-24">
            <button class="flex-1 flex justify-center items-center h-full border-r border-[#e5e5e5] text-gray-500 hover:text-black">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 12H4"/></svg>
            </button>
            <span class="flex-1 flex justify-center items-center h-full text-[14px] text-gray-600" style="font-family: var(--font-montserrat);">1</span>
            <button class="flex-1 flex justify-center items-center h-full border-l border-[#e5e5e5] text-gray-500 hover:text-black">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/></svg>
            </button>
          </div>
          <button class="text-[#c1c1c1] hover:text-red-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="px-10 pb-10 bg-white flex-shrink-0 pt-6">
    <div class="flex items-baseline justify-between mb-3">
      <span class="text-[48px] font-medium text-[#222222] leading-none tracking-tight" style="font-family: var(--font-montserrat);">$160</span>
      <span class="text-[14px] text-[#a0a0a0] font-light" style="font-family: var(--font-montserrat);">Subtotal before shipping</span>
    </div>
    
    <div class="h-[1px] bg-[#e5e5e5] w-full mb-6"></div>
    
    <button class="w-full py-4 bg-[#e61a7a] text-white text-[18px] font-medium tracking-wide uppercase hover:bg-black transition-colors" style="font-family: var(--font-montserrat);">
      Checkout
    </button>
    
    <div class="flex items-center justify-center my-6 relative">
      <div class="absolute w-full h-[1px] bg-[#e5e5e5]"></div>
      <span class="relative bg-white px-4 text-[14px] text-[#a0a0a0] font-light" style="font-family: var(--font-montserrat);">or</span>
    </div>
    
    <div class="text-center">
      <button type="button" class="drawer-close-btn text-[20px] font-medium text-[#222222] hover:text-gray-500 transition-colors pb-1 border-b-[2px] border-[#222222] hover:border-gray-500 inline-block" style="font-family: var(--font-montserrat);">
        Continue shopping
      </button>
    </div>
  </div>
</div>

<!-- ==========================================
     FILTER DRAWER
=========================================== -->
<div id="filter-drawer" class="side-drawer overflow-y-auto" role="dialog" aria-modal="true" aria-label="Filters">
  <div class="p-8 flex justify-end">
    <button type="button" class="drawer-close-btn p-2 hover:opacity-50 transition-opacity">
      <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="px-10 pb-16 space-y-12">
    <h3 class="text-[24px] font-semibold text-black tracking-tight" style="font-family: var(--font-montserrat);">FILTERS</h3>
    <p class="text-gray-400" style="font-family: var(--font-montserrat);">Filter functionality will be updated dynamically.</p>
  </div>
</div>

<script>
  (function() {
    // 1. SELECTORS
    const overlay = document.getElementById('drawer-overlay');
    const drawers = document.querySelectorAll('.side-drawer');
    const closeBtns = document.querySelectorAll('.drawer-close-btn');

    // 2. CORE FUNCTIONS
    function openDrawer(id) {
      const drawer = document.getElementById(id);
      if(!drawer || !overlay) return;
      
      overlay.style.display = 'block';
      document.body.style.overflow = 'hidden';
      
      setTimeout(() => {
        overlay.style.opacity = '1';
        drawer.classList.add('is-open');
      }, 50);
    }

    function closeAll() {
      drawers.forEach(d => d.classList.remove('is-open'));
      if(overlay) overlay.style.opacity = '0';
      document.body.style.overflow = '';
      
      setTimeout(() => {
        if(overlay) overlay.style.display = 'none';
      }, 400);
    }

    // 3. LISTENERS
    // Global delegation for data-drawer-trigger
    document.addEventListener('click', function(e) {
      const trigger = e.target.closest('[data-drawer-trigger]');
      if(trigger) {
        e.preventDefault();
        const targetId = trigger.getAttribute('data-drawer-trigger');
        openDrawer(targetId);
      }
    });

    // Close on overlay click
    if(overlay) overlay.addEventListener('click', closeAll);

    // Close on specific buttons
    closeBtns.forEach(btn => btn.addEventListener('click', closeAll));

    // Export functions to window if needed for inline use
    window.ShopifyDrawer = { open: openDrawer, close: closeAll };
  })();
</script>
