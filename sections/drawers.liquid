          </label>
          <label class="flex items-center cursor-pointer group">
            <div class="relative w-[14px] h-[14px] border border-[#222] mr-3 group-hover:border-[#e61a7a] transition-colors rounded-[1px]"></div>
            <span class="text-[13px] text-[#444]" style="font-family: var(--font-montserrat);">Headbands</span>
          </label>
          <label class="flex items-center cursor-pointer group">
            <div class="relative w-[14px] h-[14px] border border-[#222] mr-3 group-hover:border-[#e61a7a] transition-colors rounded-[1px]"></div>
            <span class="text-[13px] text-[#444]" style="font-family: var(--font-montserrat);">Sets</span>
          </label>
        </div>
      </div>
      
      <div class="h-[1px] bg-[#222] w-full mb-5 opacity-60"></div>
      
      <!-- Color section -->
      <div class="mb-5">
        <h3 class="text-[13px] font-bold text-[#222222] mb-[20px] uppercase tracking-widest" style="font-family: var(--font-montserrat);">Color</h3>
        <div class="flex flex-wrap gap-x-[14px] gap-y-[14px]">
          <button class="w-[20px] h-[20px] rounded-full border border-[#d1d1d1] bg-white hover:ring-1 hover:ring-gray-300 ring-offset-2 transition-all"></button>
          <button class="w-[20px] h-[20px] rounded-full border border-[#d1d1d1] bg-[#fbf0f4] hover:ring-1 hover:ring-gray-300 ring-offset-2 transition-all"></button>
          <button class="w-[20px] h-[20px] rounded-full bg-[#d2b48c] hover:ring-1 hover:ring-gray-300 ring-offset-2 transition-all"></button>
          <button class="w-[20px] h-[20px] rounded-full bg-[#a96e48] hover:ring-1 hover:ring-gray-300 ring-offset-2 transition-all"></button>
          <button class="w-[20px] h-[20px] rounded-full bg-[#3d2b2b] hover:ring-1 hover:ring-gray-300 ring-offset-2 transition-all"></button>
          
          <button class="w-[20px] h-[20px] rounded-full bg-[#d61a6b] hover:ring-1 hover:ring-gray-300 ring-offset-2 transition-all"></button>
          <button class="w-[20px] h-[20px] rounded-full bg-[#1b2536] hover:ring-1 hover:ring-gray-300 ring-offset-2 transition-all"></button>
          <button class="w-[20px] h-[20px] rounded-full bg-[#63141f] hover:ring-1 hover:ring-gray-300 ring-offset-2 transition-all"></button>
          <button class="w-[20px] h-[20px] rounded-full bg-[#91967d] hover:ring-1 hover:ring-gray-300 ring-offset-2 transition-all"></button>
        </div>
      </div>
      
      <div class="h-[1px] bg-[#222] w-full mb-5 opacity-60"></div>
      
      <!-- Material section -->
      <div class="mb-5">
        <div class="flex items-center justify-between mb-4 cursor-pointer">
          <h3 class="text-[13px] font-bold text-[#222222] uppercase tracking-widest" style="font-family: var(--font-montserrat);">Material</h3>
          <svg class="w-4 h-4 text-[#222]" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="transform: rotate(180deg); transition: transform 0.3s ease;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/></svg>
        </div>
        <div class="space-y-[12px]">
          <label class="flex items-center cursor-pointer group">
            <div class="relative w-[14px] h-[14px] border border-[#222] mr-3 group-hover:border-[#e61a7a] transition-colors rounded-[1px]"></div>
            <span class="text-[13px] text-[#444]" style="font-family: var(--font-montserrat);">Cashmere</span>
          </label>
          <label class="flex items-center cursor-pointer group">
            <div class="relative w-[14px] h-[14px] border border-[#222] mr-3 group-hover:border-[#e61a7a] transition-colors rounded-[1px]"></div>
            <span class="text-[13px] text-[#444]" style="font-family: var(--font-montserrat);">Angora</span>
          </label>
          <label class="flex items-center cursor-pointer group">
            <div class="relative w-[14px] h-[14px] border border-[#222] mr-3 group-hover:border-[#e61a7a] transition-colors rounded-[1px]"></div>
            <span class="text-[13px] text-[#444]" style="font-family: var(--font-montserrat);">Wool</span>
          </label>
          <label class="flex items-center cursor-pointer group">
            <div class="relative w-[14px] h-[14px] border border-[#e61a7a] bg-[#e61a7a] mr-3 flex items-center justify-center rounded-[1px]">
              <svg class="w-3 h-3 text-white block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-[13px] text-[#444]" style="font-family: var(--font-montserrat);">Silk</span>
          </label>
          <label class="flex items-center cursor-pointer group">
            <div class="relative w-[14px] h-[14px] border border-[#222] mr-3 group-hover:border-[#e61a7a] transition-colors rounded-[1px]"></div>
            <span class="text-[13px] text-[#444]" style="font-family: var(--font-montserrat);">Linen</span>
          </label>
          <label class="flex items-center cursor-pointer group">
            <div class="relative w-[14px] h-[14px] border border-[#222] mr-3 group-hover:border-[#e61a7a] transition-colors rounded-[1px]"></div>
            <span class="text-[13px] text-[#444]" style="font-family: var(--font-montserrat);">Cotton</span>
          </label>
          <label class="flex items-center cursor-pointer group">
            <div class="relative w-[14px] h-[14px] border border-[#222] mr-3 group-hover:border-[#e61a7a] transition-colors rounded-[1px]"></div>
            <span class="text-[13px] text-[#444]" style="font-family: var(--font-montserrat);">Eco-leather</span>
          </label>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<script>
(function() {
  /* ── DOM refs ─────────────────────────── */
  const overlay    = document.getElementById('drawer-overlay');
  const drawers    = document.querySelectorAll('.side-drawer');
  const closeBtns  = document.querySelectorAll('.drawer-close-btn');

  /* ── Drawer open / close ─────────────── */
  function openDrawer(id) {
    const drawer = document.getElementById(id);
    if (!drawer) return;
    
    // For filter drawer, skip the overlay and body lock — treat it like a floating small window.
    if (id === 'filter-drawer') {
      drawer.classList.add('is-open');
      return;
    }
    
    // For other drawers (like Cart), show the overlay and block scrolling
    if (overlay) {
      overlay.style.display = 'block';
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        overlay.style.opacity = '1';
      }, 30);
    }
    setTimeout(() => {
      drawer.classList.add('is-open');
    }, 30);
  }

  function closeAll() {
    drawers.forEach(d => d.classList.remove('is-open'));
    if (overlay) overlay.style.opacity = '0';
    document.body.style.overflow = '';
    setTimeout(() => { if (overlay) overlay.style.display = 'none'; }, 400);
  }

  /* ── Global click delegation ─────────── */
  document.addEventListener('click', function(e) {
    const trigger = e.target.closest('[data-drawer-trigger]');
    if (trigger) {
      e.preventDefault();
      const id = trigger.getAttribute('data-drawer-trigger');
      if (id === 'cart-drawer') { openDrawer(id); loadCart(); }
      else openDrawer(id);
    }
  });

  if (overlay) overlay.addEventListener('click', closeAll);
  closeBtns.forEach(btn => btn.addEventListener('click', closeAll));

  /* ══════════════════════════════════════
     MOCK CART (localStorage for demo/placeholders)
  ══════════════════════════════════════ */
  const MOCK_KEY = 'ester_mock_cart';

  function mockGet() {
    try { return JSON.parse(localStorage.getItem(MOCK_KEY)) || []; } catch(e) { return []; }
  }
  function mockSave(items) {
    localStorage.setItem(MOCK_KEY, JSON.stringify(items));
  }
  function mockAdd(meta) {
    const items = mockGet();
    const key = 'mock_' + meta.title.replace(/\s+/g,'_').toLowerCase();
    const existing = items.find(i => i.key === key);
    if (existing) { existing.quantity += 1; }
    else { items.push({ key, product_title: meta.title, variant_title: '', price: meta.price, image: meta.image, quantity: 1, isMock: true }); }
    mockSave(items);
    return items;
  }
  function mockChange(key, qty) {
    let items = mockGet();
    if (qty <= 0) { items = items.filter(i => i.key !== key); }
    else { const it = items.find(i => i.key === key); if (it) it.quantity = qty; }
    mockSave(items);
    return items;
  }
  function mockTotal(items) {
    return items.reduce((sum, i) => {
      const num = parseFloat(String(i.price).replace(/[^0-9.]/g, '')) || 0;
      return sum + num * i.quantity;
    }, 0);
  }
  function mockCount(items) { return items.reduce((s,i) => s + i.quantity, 0); }

  /* ══════════════════════════════════════
     UNIFIED CART DISPLAY
  ══════════════════════════════════════ */
  const elLoading  = document.getElementById('cart-loading');
  const elEmpty    = document.getElementById('cart-empty');
  const elList     = document.getElementById('cart-items-list');
  const elFooter   = document.getElementById('cart-footer');
  const elSubtotal = document.getElementById('cart-subtotal');
  const elCount    = document.getElementById('cart-count-label');

  function moneyFromCents(cents) { return '$' + (cents / 100).toFixed(2).replace(/\.00$/, ''); }
  function moneyFromFloat(f)     { return '$' + f.toFixed(2).replace(/\.00$/, ''); }

  function showLoading() {
    elLoading && (elLoading.style.display = 'flex');
    elEmpty   && elEmpty.classList.add('hidden');
    elList    && elList.classList.add('hidden');
    elFooter  && elFooter.classList.add('hidden');
  }
  function showEmpty() {
    elLoading && (elLoading.style.display = 'none');
    elEmpty   && elEmpty.classList.remove('hidden');
    elList    && elList.classList.add('hidden');
    elFooter  && elFooter.classList.add('hidden');
    if (elCount) { elCount.textContent = ''; elCount.classList.add('hidden'); }
  }
  function showAll(allItems, subtotal, count) {
    elLoading && (elLoading.style.display = 'none');
    elEmpty   && elEmpty.classList.add('hidden');
    elList    && elList.classList.remove('hidden');
    elFooter  && elFooter.classList.remove('hidden');
    if (elSubtotal) elSubtotal.textContent = subtotal;
    if (elCount) {
      elCount.textContent = count + ' item' + (count !== 1 ? 's' : '');
      elCount.classList.remove('hidden');
    }
    renderItems(allItems);
  }

  /* Render item rows (works for both real & mock items) */
  function renderItems(items) {
    if (!elList) return;
    elList.innerHTML = items.map(item => {
      const priceStr = item.isMock ? item.price : moneyFromCents(item.price);
      const imgHtml  = item.image
        ? `<img src="${item.image}" alt="${item.product_title}" class="w-full h-full object-cover">`
        : '<div class="w-full h-full bg-[#eee]"></div>';
      return `
      <div class="flex py-5 border-b border-[#f0f0f0]" data-key="${item.key}" data-mock="${item.isMock ? '1' : ''}">
        <div class="w-[90px] h-[90px] flex-shrink-0 mr-4 bg-[#f8f8f8] overflow-hidden">${imgHtml}</div>
        <div class="flex-1 flex flex-col justify-between min-w-0">
          <div>
            <p class="text-[14px] font-medium text-[#222] truncate" style="font-family:var(--font-montserrat)">${item.product_title}</p>
            ${item.variant_title ? `<p class="text-[12px] text-[#aaa] mt-0.5" style="font-family:var(--font-montserrat)">${item.variant_title}</p>` : ''}
            <p class="text-[13px] text-[#888] mt-1" style="font-family:var(--font-montserrat)">${priceStr}</p>
          </div>
          <div class="flex items-center justify-between mt-2">
            <div class="flex items-center border border-[#e5e5e5] h-7" style="direction:ltr">
              <button class="cart-qty-btn w-7 h-full flex items-center justify-center border-r border-[#e5e5e5] text-gray-400 hover:text-black transition-colors"
                      data-key="${item.key}" data-delta="-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 12H4"/></svg>
              </button>
              <span class="w-8 text-center text-[13px] text-gray-600" style="font-family:var(--font-montserrat)">${item.quantity}</span>
              <button class="cart-qty-btn w-7 h-full flex items-center justify-center border-l border-[#e5e5e5] text-gray-400 hover:text-black transition-colors"
                      data-key="${item.key}" data-delta="1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/></svg>
              </button>
            </div>
            <button class="cart-remove-btn text-[#ccc] hover:text-red-500 transition-colors" data-key="${item.key}">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
      </div>`;
    }).join('');

    elList.querySelectorAll('.cart-qty-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.key;
        const delta = parseInt(btn.dataset.delta);
        const row = elList.querySelector(`[data-key="${key}"]`);
        const isMock = row && row.dataset.mock === '1';
        const qtyEl = row && row.querySelector('span');
        const curQty = qtyEl ? parseInt(qtyEl.textContent) : 1;
        const newQty = Math.max(0, curQty + delta);
        if (isMock) { mockChange(key, newQty); loadCart(); }
        else updateRealCartItem(key, newQty);
      });
    });
    elList.querySelectorAll('.cart-remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.key;
        const row = elList.querySelector(`[data-key="${key}"]`);
        const isMock = row && row.dataset.mock === '1';
        if (isMock) { mockChange(key, 0); loadCart(); }
        else updateRealCartItem(key, 0);
      });
    });
  }

  /* Load & merge real + mock carts */
  function loadCart() {
    showLoading();
    fetch('/cart.js')
      .then(r => r.json())
      .then(realCart => {
        const mockItems = mockGet();
        const allItems  = [...realCart.items, ...mockItems];
        const mockSub   = mockTotal(mockItems);
        const realSub   = realCart.total_price / 100;
        const totalSub  = moneyFromFloat(realSub + mockSub);
        const totalCount = realCart.item_count + mockCount(mockItems);
        updateCartBadge(totalCount);
        if (allItems.length === 0) showEmpty();
        else showAll(allItems, totalSub, totalCount);
      })
      .catch(() => {
        // Offline / no Shopify — show only mock cart
        const mockItems = mockGet();
        const sub = moneyFromFloat(mockTotal(mockItems));
        const cnt = mockCount(mockItems);
        updateCartBadge(cnt);
        if (mockItems.length === 0) showEmpty();
        else showAll(mockItems, sub, cnt);
      });
  }

  /* Update real Shopify cart item */
  function updateRealCartItem(key, qty) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    }).then(() => loadCart());
  }

  /* EsterCart — used by product page */
  window.EsterCart = {
    add: function(variantId, qty, meta) {
      qty = qty || 1;
      meta = meta || {};
      // If no real variant → mock cart
      if (!variantId || variantId === '' || variantId === '0') {
        mockAdd({ title: meta.title || 'Product', price: meta.price || '$0', image: meta.image || '' });
        const mockItems = mockGet();
        const cnt = mockCount(mockItems);
        updateCartBadge(cnt);
        openDrawer('cart-drawer');
        loadCart();
        return Promise.resolve();
      }
      // Real Shopify product
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: qty })
      })
      .then(r => r.json())
      .then(() => {
        openDrawer('cart-drawer');
        loadCart();
      })
      .catch(() => {
        // If add fails (e.g. invalid ID) → treat as mock
        mockAdd({ title: meta.title || 'Product', price: meta.price || '$0', image: meta.image || '' });
        const cnt = mockCount(mockGet());
        updateCartBadge(cnt);
        openDrawer('cart-drawer');
        loadCart();
      });
    }
  };

  /* Badge */
  function updateCartBadge(count) {
    document.querySelectorAll('[data-cart-count]').forEach(el => {
      el.textContent = count;
      // Always show the number, so it displays (0) instead of ()
      el.style.display = '';
    });
  }

  /* Init badge on load */
  fetch('/cart.js')
    .then(r => r.json())
    .then(c => {
      const total = c.item_count + mockCount(mockGet());
      updateCartBadge(total);
    })
    .catch(() => updateCartBadge(mockCount(mockGet())));

  /* ══════════════════════════════════════
     FILTER DRAWER INTERACTIVITY
  ══════════════════════════════════════ */
  const filterDrawer = document.getElementById('filter-drawer');
  if (filterDrawer) {

    /* Accordion headers */
    filterDrawer.querySelectorAll('.mb-5 > .flex.items-center.justify-between').forEach(header => {
      const icon = header.querySelector('svg');
      header.addEventListener('click', () => {
        const content = header.nextElementSibling;
        if (!content) return;
        const isOpen = content.style.display !== 'none' && content.style.display !== '';
        content.style.display = isOpen ? 'none' : 'block';
        if (icon) icon.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
      });
    });

    /* Custom checkboxes */
    filterDrawer.querySelectorAll('label').forEach(label => {
      label.addEventListener('click', e => {
        e.preventDefault();
        const box = label.querySelector('div.relative');
        if (!box) return;
        const active = box.classList.contains('bg-\\[\\#e61a7a\\]') || box.style.backgroundColor === 'rgb(230, 26, 122)';
        if (active) {
          box.style.backgroundColor = '';
          box.style.borderColor = '';
          const s = box.querySelector('svg');
          if (s) s.remove();
        } else {
          box.style.backgroundColor = '#e61a7a';
          box.style.borderColor = '#e61a7a';
          if (!box.querySelector('svg')) {
            box.style.display = 'flex';
            box.style.alignItems = 'center';
            box.style.justifyContent = 'center';
            box.innerHTML = '<svg style="width:10px;height:10px;color:white" fill="none" stroke="white" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>';
          }
        }
      });
    });

    /* Size buttons toggle */
    filterDrawer.querySelectorAll('button').forEach(btn => {
      if (btn.closest('.space-y-\\[12px\\]')) return;
      btn.addEventListener('click', () => {
        const active = btn.style.borderColor === 'rgb(34, 34, 34)';
        btn.style.borderColor = active ? '' : '#222';
        btn.style.color = active ? '' : '#222';
        btn.style.fontWeight = active ? '' : '500';
      });
    });
  }

  /* Export */
  window.ShopifyDrawer = { open: openDrawer, close: closeAll };
})();
</script>

