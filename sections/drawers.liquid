<!-- ==========================================
     GLOBAL DRAWERS: CART & FILTERS
=========================================== -->
{% schema %}
{
  "name": "Drawers",
  "settings": []
}
{% endschema %}

<style>
  /* Base Drawer Overlay */
  #drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 10000;
    display: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(4px);
    cursor: pointer;
  }
  
  /* Sidebar Drawer Base */
  .side-drawer {
    position: fixed;
    top: 0;
    {% if request.locale.iso_code == 'he' %}
      left: 0;
      transform: translateX(-100%);
      box-shadow: 10px 0 30px rgba(0,0,0,0.1);
    {% else %}
      right: 0;
      transform: translateX(100%);
      box-shadow: -10px 0 30px rgba(0,0,0,0.1);
    {% endif %}
    height: 100%;
    background: #ffffff;
    z-index: 10001;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex !important;
    flex-direction: column;
    width: 100%;
  }

  #filter-drawer {
    height: auto !important;
    max-height: 100vh;
    border-bottom: 1px solid #f0f0f0;
    box-shadow: -5px 15px 30px rgba(0,0,0,0.08);
  }

  @media (min-width: 640px) {
    #cart-drawer { width: 500px; }
    #filter-drawer { width: 455px; }
  }

  /* State: Visible */
  .side-drawer.is-open {
    transform: translateX(0) !important;
  }
</style>

<!-- Overlay remains fixed at body bottom -->
<div id="drawer-overlay"></div>

<!-- ==========================================
     SHOPPING CART DRAWER
=========================================== -->
<div id="cart-drawer" class="side-drawer flex flex-col h-full bg-white shadow-xl" role="dialog" aria-modal="true" aria-label="Cart">

  <!-- ── Header ─────────────────────────── -->
  <div class="relative px-8 pt-8 pb-5 bg-white flex-shrink-0 border-b border-[#f0f0f0]">
    <button type="button" class="drawer-close-btn absolute {% if request.locale.iso_code == 'he' %}left-6{% else %}right-6{% endif %} top-6 p-1 hover:opacity-50 transition-opacity">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="#222" stroke-width="1.5">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <h2 class="text-center text-[28px] font-medium text-[#222] mt-2 uppercase tracking-wide" style="font-family:var(--font-montserrat)">
      {% if request.locale.iso_code == 'he' %}סל הקניות שלי{% else %}Shopping Cart{% endif %}
    </h2>
    <p id="cart-count-label" class="text-center text-[13px] text-[#aaa] mt-1 hidden" style="font-family:var(--font-montserrat)"></p>
  </div>

  <!-- ── Body ───────────────────────────── -->
  <div class="flex-1 overflow-y-auto bg-white relative min-h-0">

    <!-- Loading spinner -->
    <div id="cart-loading" class="absolute inset-0 flex items-center justify-center">
      <svg class="animate-spin w-8 h-8 text-[#e61a7a]" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
      </svg>
    </div>

    <!-- Empty state -->
    <div id="cart-empty" class="hidden absolute inset-0 flex flex-col items-center justify-center px-8 text-center">
      <svg class="w-14 h-14 text-[#e0e0e0] mb-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <p class="text-[20px] font-medium text-[#222] mb-2" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}הסל ריק{% else %}Your cart is empty{% endif %}
      </p>
      <p class="text-[13px] text-[#bbb] mb-8" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}הוסיפי מוצרים כדי להמשיך{% else %}Add some products and come back{% endif %}
      </p>
      <button type="button" class="drawer-close-btn px-8 py-3 border border-[#222] text-[12px] text-[#222] uppercase tracking-widest hover:bg-[#222] hover:text-white transition-colors" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}המשיכי לקנות{% else %}Continue shopping{% endif %}
      </button>
    </div>

    <!-- Items rendered by JS -->
    <div id="cart-items-list" class="hidden px-8 py-2"></div>

  </div>

  <!-- ── Footer ─────────────────────────── -->
  <div id="cart-footer" class="hidden px-8 pb-8 flex-shrink-0 pt-5 border-t border-[#f0f0f0]">
    <div class="flex items-baseline justify-between mb-4">
      <span id="cart-subtotal" class="text-[38px] font-medium text-[#222] leading-none" style="font-family:var(--font-montserrat)">$0</span>
      <span class="text-[11px] text-[#aaa] uppercase tracking-wider" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}סיכום לפני משלוח{% else %}Subtotal before shipping{% endif %}
      </span>
    </div>
    <div class="h-[1px] bg-[#f0f0f0] mb-5"></div>
    <a href="/search?view=order" class="block w-full py-4 bg-[#e61a7a] text-white text-[14px] font-medium tracking-widest uppercase text-center hover:bg-black transition-colors" style="font-family:var(--font-montserrat)">
      {% if request.locale.iso_code == 'he' %}לתשלום{% else %}Checkout{% endif %}
    </a>
    <div class="flex items-center justify-center my-5 relative">
      <div class="absolute w-full h-[1px] bg-[#f0f0f0]"></div>
      <span class="relative bg-white px-4 text-[11px] text-[#aaa] uppercase tracking-wider" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}או{% else %}or{% endif %}
      </span>
    </div>
    <div class="text-center">
      <button type="button" class="drawer-close-btn text-[13px] font-medium text-[#222] hover:text-[#aaa] transition-colors pb-0.5 border-b border-[#222] uppercase tracking-widest" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}המשך קנייה{% else %}Continue shopping{% endif %}
      </button>
    </div>
  </div>

</div>



