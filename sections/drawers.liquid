<!-- ==========================================
     GLOBAL DRAWERS: CART & FILTERS
=========================================== -->
{% schema %}
{
  "name": "Drawers",
  "settings": []
}
{% endschema %}

<style>
  /* Base Drawer Overlay */
  #drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 10000;
    display: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(4px);
    cursor: pointer;
  }
  
  /* Sidebar Drawer Base */
  .side-drawer {
    position: fixed;
    top: 0;
    {% if request.locale.iso_code == 'he' %}
      left: 0;
      transform: translateX(-100%);
    {% else %}
      right: 0;
      transform: translateX(100%);
    {% endif %}
    height: 100%;
    background: #ffffff;
    z-index: 10001;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex !important;
    flex-direction: column;
    width: 100%;
  }

  #filter-drawer {
    height: auto !important;
    max-height: 100vh;
    border-bottom: 1px solid #f0f0f0;
  }

  @media (min-width: 640px) {
    #cart-drawer { width: 500px; }
    #filter-drawer { width: 455px; }
  }

  /* State: Visible */
  .side-drawer.is-open {
    transform: translateX(0) !important;
  }
</style>

<!-- Overlay remains fixed at body bottom -->
<div id="drawer-overlay"></div>

<!-- ==========================================
     SHOPPING CART DRAWER
=========================================== -->
<div id="cart-drawer" class="side-drawer flex flex-col h-full bg-white" role="dialog" aria-modal="true" aria-label="Cart" {% if request.locale.iso_code == 'he' %}dir="rtl"{% else %}dir="ltr"{% endif %}>

  <!-- ── Header ─────────────────────────── -->
  <div class="relative px-8 pt-8 pb-5 bg-white flex-shrink-0 border-b border-[#f0f0f0]">
    <button type="button" class="drawer-close-btn absolute {% if request.locale.iso_code == 'he' %}left-6{% else %}right-6{% endif %} top-6 p-1 hover:opacity-50 transition-opacity">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="#222" stroke-width="1.5">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <h2 class="text-center text-[28px] font-medium text-[#222] mt-2 uppercase tracking-wide" style="font-family:var(--font-montserrat)">
      {% if request.locale.iso_code == 'he' %}סל הקניות שלי{% else %}Shopping Cart{% endif %}
    </h2>
    <p id="cart-count-label" class="text-center text-[13px] text-[#aaa] mt-1 hidden" style="font-family:var(--font-montserrat)"></p>
  </div>

  <!-- ── Body ───────────────────────────── -->
  <div class="flex-1 overflow-y-auto bg-white relative min-h-0">

    <!-- Loading spinner -->
    <div id="cart-loading" class="absolute inset-0 flex items-center justify-center">
      <svg class="animate-spin w-8 h-8 text-[#e61a7a]" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
      </svg>
    </div>

    <!-- Empty state -->
    <div id="cart-empty" class="hidden absolute inset-0 flex flex-col items-center justify-center px-8 text-center">
      <svg class="w-14 h-14 text-[#e0e0e0] mb-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <p class="text-[20px] font-medium text-[#222] mb-2" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}הסל ריק{% else %}Your cart is empty{% endif %}
      </p>
      <p class="text-[13px] text-[#bbb] mb-8" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}הוסיפי מוצרים כדי להמשיך{% else %}Add some products and come back{% endif %}
      </p>
      <button type="button" class="drawer-close-btn px-8 py-3 border border-[#DE2077] text-[12px] text-[#DE2077] uppercase tracking-widest hover:bg-[#DE2077] hover:text-white transition-colors" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}המשיכי לקנות{% else %}Continue shopping{% endif %}
      </button>
    </div>

    <!-- Items rendered by JS -->
    <div id="cart-items-list" class="hidden px-8 py-2" {% if request.locale.iso_code == 'he' %}style="direction:rtl; text-align:right;"{% endif %}></div>

  </div>

  <!-- ── Footer ─────────────────────────── -->
  <div id="cart-footer" class="hidden px-8 pb-8 flex-shrink-0 pt-5 border-t border-[#f0f0f0]">
    <div class="flex items-baseline justify-between mb-4" {% if request.locale.iso_code == 'he' %}style="flex-direction:row-reverse;"{% endif %}>
      <span id="cart-subtotal" class="text-[38px] font-medium text-[#222] leading-none" style="font-family:var(--font-montserrat)">$0</span>
      <span class="text-[11px] text-[#aaa] uppercase tracking-wider" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}סיכום לפני משלוח{% else %}Subtotal before shipping{% endif %}
      </span>
    </div>
    <div class="h-[1px] bg-[#f0f0f0] mb-5"></div>
    <button type="button" id="cart-checkout-btn" class="block w-full py-4 bg-[#e61a7a] text-white text-[14px] font-medium tracking-widest uppercase text-center hover:bg-black transition-colors" style="font-family:var(--font-montserrat)">
      {% if request.locale.iso_code == 'he' %}לתשלום{% else %}Checkout{% endif %}
    </button>
    <div class="flex items-center justify-center my-5 relative">
      <div class="absolute w-full h-[1px] bg-[#f0f0f0]"></div>
      <span class="relative bg-white px-4 text-[11px] text-[#aaa] uppercase tracking-wider" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}או{% else %}or{% endif %}
      </span>
    </div>
    <div class="text-center">
      <button type="button" class="drawer-close-btn text-[13px] font-medium text-[#222] hover:text-[#aaa] transition-colors pb-0.5 border-b border-[#222] uppercase tracking-widest" style="font-family:var(--font-montserrat)">
        {% if request.locale.iso_code == 'he' %}המשך קנייה{% else %}Continue shopping{% endif %}
      </button>
    </div>
  </div>

</div>



<!-- ==========================================
     FILTER DRAWER — Dynamic Shopify Filters
     (only rendered on collection pages)
=========================================== -->
{% if template.name == 'collection' %}
<div id="filter-drawer" class="side-drawer flex flex-col bg-white" role="dialog" aria-modal="true" aria-label="Filters" {% if request.locale.iso_code == 'he' %}dir="rtl"{% else %}dir="ltr"{% endif %}>

  <!-- Header -->
  <div class="relative w-full pt-8 pb-4 bg-white flex {% if request.locale.iso_code == 'he' %}justify-start{% else %}justify-end{% endif %} px-10 flex-shrink-0">
    <button type="button" class="drawer-close-btn absolute {% if request.locale.iso_code == 'he' %}left-6{% else %}right-6{% endif %} top-6 hover:opacity-50 transition-opacity">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="#222" stroke-width="0.8">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <h2 class="sr-only">Filters</h2>
  </div>

  <!-- Active filters strip -->
  <div id="active-filters-strip" class="px-10 pb-3 flex flex-wrap gap-2 hidden">
    <!-- filled by JS -->
  </div>

  <!-- Scrollable filter body -->
  <div class="flex-1 overflow-y-auto px-10 pb-10 bg-white" id="filter-body">

    {% if collection.filters.size > 0 %}
      {% for filter in collection.filters %}
        <div class="filter-group mb-6" data-filter-name="{{ filter.label | upcase }}">
          
          {% comment %} Header {% endcomment %}
          <div class="flex items-center justify-start gap-2 mb-4 {% if filter.label != 'Size' and filter.label != 'Color' %}cursor-pointer filter-accordion-trigger{% endif %}">
            <h3 class="text-[13px] font-bold text-[#222] uppercase" style="font-family: var(--font-montserrat);">
              {{ filter.label }}
            </h3>
            {% if filter.label != 'Size' and filter.label != 'Color' %}
              <svg class="w-3.5 h-3.5 text-[#222] transition-transform filter-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/>
              </svg>
            {% endif %}
          </div>

          <div class="filter-content pt-1">
            {% if filter.type == 'price_range' %}
              {% comment %} ── PRICE ── {% endcomment %}
              <div class="flex gap-3 items-center mb-5">
                <div class="flex-1">
                  <span class="text-[10px] uppercase text-gray-400 block mb-1">From</span>
                  <input type="number" id="filter-price-min" name="{{ filter.min_value.param_name }}"
                         placeholder="0" class="w-full border border-[#ccc] text-[13px] px-3 py-2 outline-none">
                </div>
                <span class="text-gray-300 mt-4">—</span>
                <div class="flex-1">
                  <span class="text-[10px] uppercase text-gray-400 block mb-1">To</span>
                  <input type="number" id="filter-price-max" name="{{ filter.max_value.param_name }}"
                         placeholder="{{ filter.range_max | money_without_currency }}" class="w-full border border-[#ccc] text-[13px] px-3 py-2 outline-none">
                </div>
              </div>
              <button type="button" id="filter-price-apply" class="text-[11px] uppercase tracking-widest border border-[#222] px-10 py-2.5 bg-white hover:bg-[#222] hover:text-white transition-colors">Apply</button>

            {% elsif filter.type == 'list' %}
              {% assign lbl = filter.label | downcase %}
              
              {% if lbl contains 'color' or lbl contains 'колір' or lbl contains 'צבע' %}
                {% comment %} ── COLOR SWATCHES ── {% endcomment %}
                <div class="flex flex-wrap gap-3">
                  {% for value in filter.values %}
                    <button type="button" class="filter-swatch w-[24px] h-[24px] rounded-full transition-all border border-[#e5e5e5] {% if value.active %}ring-1 ring-offset-1 ring-[#e91e63]{% endif %}"
                            data-param="{{ value.param_name }}" data-value="{{ value.value | url_encode }}" data-active="{{ value.active }}"
                            style="background-color: {{ value.value | downcase }};" title="{{ value.label }}"></button>
                  {% endfor %}
                </div>

              {% elsif lbl contains 'size' or lbl contains 'розмір' or lbl contains 'גודל' %}
                {% comment %} ── SIZE GRID ── {% endcomment %}
                <div class="flex flex-wrap gap-2">
                  {% for value in filter.values %}
                    {% assign v_up = value.label | upcase %}
                    {% if v_up contains 'ONE SIZE' %}
                      <!-- Break to new line for ONE SIZE -->
                      <div class="w-full h-0 m-0 p-0 hidden"></div>
                      <button type="button" class="filter-size h-[28px] w-[80px] mt-1 border text-[12px] flex items-center justify-center transition-all bg-white
                                     {% if value.active %}border-[#222] font-semibold text-[#222]{% else %}border-[#e5e5e5] font-light text-[#444]{% endif %}"
                              data-param="{{ value.param_name }}" data-value="{{ value.value | url_encode }}" data-active="{{ value.active }}">
                        {{ value.label | upcase }}
                      </button>
                    {% else %}
                      <button type="button" class="filter-size h-[28px] w-[28px] border text-[12px] flex items-center justify-center transition-all bg-white
                                     {% if value.active %}border-[#222] font-semibold text-[#222]{% else %}border-[#e5e5e5] font-light text-[#444]{% endif %}"
                              data-param="{{ value.param_name }}" data-value="{{ value.value | url_encode }}" data-active="{{ value.active }}">
                        {{ value.label | upcase }}
                      </button>
                    {% endif %}
                  {% endfor %}
                </div>

              {% else %}
                {% comment %} ── CHECKBOX LIST (Category, Material, Availability) ── {% endcomment %}
                <div class="flex flex-col gap-3">
                  {% for value in filter.values %}
                    <div class="flex items-center cursor-pointer group filter-item" data-param="{{ value.param_name }}" data-value="{{ value.value | url_encode }}" data-active="{{ value.active }}">
                      <div class="w-[14px] h-[14px] border border-[#222] rounded-[1px] transition-colors flex items-center justify-center mr-2.5 shrink-0
                                  {% if value.active %}bg-[#e91e63] border-[#e91e63]{% else %}bg-transparent{% endif %}">
                        {% if value.active %}
                          <svg class="w-3 h-3 text-white translate-y-[1px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                          </svg>
                        {% endif %}
                      </div>
                      <span class="text-[13px] text-[#444] font-light leading-none" style="font-family: var(--font-montserrat);">{{ value.label }}</span>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            {% endif %}
          </div>
          
          <!-- Divider Line -->
          <div class="w-full h-[1px] bg-[#888] mt-6 mb-2"></div>
        </div>
      {% endfor %}
    {% else %}
      {% comment %} ── FALLBACK: no collection.filters (not on collection page, or filters not configured) ── {% endcomment %}
      <p class="text-[13px] text-gray-400 mt-4" style="font-family: var(--font-montserrat);">
        {{ 'catalog.no_filters' | t | default: 'Filters will appear once products are added.' }}
      </p>
    {% endif %}

  </div>{%- comment -%}#filter-body{%- endcomment -%}

  <!-- Sticky footer: Clear + Apply -->
  <div class="flex-shrink-0 border-t border-[#f0f0f0] px-10 py-5 flex gap-4">
    <button type="button" id="filter-clear-btn"
            class="flex-1 border border-[#222] text-[12px] uppercase tracking-widest py-3 text-[#222] hover:bg-gray-50 transition-colors"
            style="font-family: var(--font-montserrat);">
      {{ 'catalog.clear_filters' | t | default: 'Clear' }}
    </button>
    <button type="button" id="filter-apply-btn"
            class="flex-1 bg-[#222] text-white text-[12px] uppercase tracking-widest py-3 hover:bg-[#e61a7a] transition-colors"
            style="font-family: var(--font-montserrat);">
      {{ 'catalog.apply_filters' | t | default: 'Apply' }}
    </button>
  </div>

</div>
{% endif %}{%- comment -%}template.name == collection{%- endcomment -%}

<script>
(function() {
  /* ── DOM refs ─────────────────────────── */
  const overlay    = document.getElementById('drawer-overlay');
  const drawers    = document.querySelectorAll('.side-drawer');
  const closeBtns  = document.querySelectorAll('.drawer-close-btn');

  /* ── Drawer open / close ─────────────── */
  function openDrawer(id) {
    const drawer = document.getElementById(id);
    if (!drawer) return;
    if (overlay) {
      overlay.style.display = 'block';
      document.body.style.overflow = 'hidden';
      setTimeout(() => { overlay.style.opacity = '1'; }, 30);
    }
    setTimeout(() => { drawer.classList.add('is-open'); }, 30);
  }

  function closeAll() {
    drawers.forEach(d => d.classList.remove('is-open'));
    if (overlay) overlay.style.opacity = '0';
    document.body.style.overflow = '';
    setTimeout(() => { if (overlay) overlay.style.display = 'none'; }, 400);
  }

  /* ── Global click delegation ─────────── */
  document.addEventListener('click', function(e) {
    const trigger = e.target.closest('[data-drawer-trigger]');
    if (trigger) {
      e.preventDefault();
      const id = trigger.getAttribute('data-drawer-trigger');
      if (id === 'cart-drawer') { openDrawer(id); loadCart(); }
      else openDrawer(id);
    }
  });

  if (overlay) overlay.addEventListener('click', closeAll);
  closeBtns.forEach(btn => btn.addEventListener('click', closeAll));

  /* ══════════════════════════════════════
     DYNAMIC FILTER LOGIC
  ══════════════════════════════════════ */
  const filterDrawer = document.getElementById('filter-drawer');

  /* Pending filter state: { paramName: Set(values) } */
  let pendingFilters = {};

  /* Build pending state from currently active Shopify filter values (server-rendered) */
  function initPendingFromDOM() {
    pendingFilters = {};
    if (!filterDrawer) return;
    filterDrawer.querySelectorAll('[data-param][data-active="true"]').forEach(el => {
      const p = el.dataset.param;
      const v = el.dataset.value;
      if (!pendingFilters[p]) pendingFilters[p] = new Set();
      pendingFilters[p].add(v);
    });
  }
  initPendingFromDOM();

  /* Visual toggle of a filter control */
  function toggleControl(el, active) {
    const isSwatch = el.classList.contains('filter-swatch');
    const isSize   = el.classList.contains('filter-size');
    const isItem   = el.classList.contains('filter-item');

    if (isSwatch) {
      el.classList.toggle('ring-1', active);
      el.classList.toggle('ring-[#222]', active);
    } else if (isSize) {
      el.classList.toggle('border-[#222]', active);
      el.classList.toggle('font-bold', active);
      el.classList.toggle('border-[#ccc]', !active);
      el.classList.toggle('font-normal', !active);
    } else if (isItem) {
      const box = el.querySelector('div');
      if (box) {
        if (active) {
          box.classList.add('bg-[#e91e63]', 'border-[#e91e63]');
          box.innerHTML = '<svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>';
        } else {
          box.classList.remove('bg-[#e91e63]', 'border-[#e91e63]');
          box.innerHTML = '';
        }
      }
    }
    el.dataset.active = active ? 'true' : 'false';
  }

  /* Handle click on any filter control */
  function handleFilterClick(el) {
    const param = el.dataset.param;
    const value = el.dataset.value;
    if (!param || !value) return;

    if (!pendingFilters[param]) pendingFilters[param] = new Set();
    const active = pendingFilters[param].has(value);

    if (active) {
      pendingFilters[param].delete(value);
      toggleControl(el, false);
    } else {
      pendingFilters[param].add(value);
      toggleControl(el, true);
    }
  }

  if (filterDrawer) {
    /* Accordion toggle */
    filterDrawer.querySelectorAll('.filter-accordion-trigger').forEach(trigger => {
      trigger.addEventListener('click', () => {
        const group = trigger.closest('.filter-group');
        const content = group.querySelector('.filter-content');
        const icon = trigger.querySelector('.filter-chevron');
        if (!content) return;
        const isHidden = content.style.display === 'none';
        content.style.display = isHidden ? '' : 'none';
        if (icon) icon.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
      });
    });

    /* Click on filter items */
    filterDrawer.addEventListener('click', e => {
      const el = e.target.closest('.filter-swatch, .filter-size, .filter-item');
      if (el) handleFilterClick(el);
    });

    /* Apply button ─ build URL and navigate */
    const applyBtn = document.getElementById('filter-apply-btn');
    if (applyBtn) {
      applyBtn.addEventListener('click', () => {
        const url = new URL(window.location.href);
        /* Remove all existing filter params */
        [...url.searchParams.keys()]
          .filter(k => k.startsWith('filter.'))
          .forEach(k => url.searchParams.delete(k));

        /* Re-add selected ones */
        Object.entries(pendingFilters).forEach(([param, values]) => {
          values.forEach(v => url.searchParams.append(param, decodeURIComponent(v)));
        });

        /* Price range */
        const minEl = document.getElementById('filter-price-min');
        const maxEl = document.getElementById('filter-price-max');
        if (minEl && minEl.value) url.searchParams.set(minEl.name, minEl.value);
        if (maxEl && maxEl.value) url.searchParams.set(maxEl.name, maxEl.value);

        closeAll();
        window.location.href = url.toString();
      });
    }

    /* Clear button */
    const clearBtn = document.getElementById('filter-clear-btn');
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        const url = new URL(window.location.href);
        [...url.searchParams.keys()]
          .filter(k => k.startsWith('filter.'))
          .forEach(k => url.searchParams.delete(k));
        closeAll();
        window.location.href = url.toString();
      });
    }

    /* Price quick-apply */
    const priceApply = document.getElementById('filter-price-apply');
    if (priceApply) {
      priceApply.addEventListener('click', () => applyBtn && applyBtn.click());
    }
  }

  /* Expose filter count in the header button */
  (function updateFilterCount() {
    const url = new URL(window.location.href);
    let count = 0;
    url.searchParams.forEach((v, k) => {
      if (k.startsWith('filter.')) count++;
    });
    document.querySelectorAll('[data-filter-count]').forEach(el => {
      el.textContent = count;
    });
  })();

  /* ══════════════════════════════════════
     MOCK CART (localStorage for demo/placeholders)
  ══════════════════════════════════════ */
  const MOCK_KEY = 'ester_mock_cart';

  function mockGet() {
    try { return JSON.parse(localStorage.getItem(MOCK_KEY)) || []; } catch(e) { return []; }
  }
  function mockSave(items) {
    localStorage.setItem(MOCK_KEY, JSON.stringify(items));
  }
  function mockAdd(meta) {
    const items = mockGet();
    const key = 'mock_' + meta.title.replace(/\s+/g,'_').toLowerCase();
    const existing = items.find(i => i.key === key);
    if (existing) { existing.quantity += 1; }
    else { items.push({ key, product_title: meta.title, variant_title: '', price: meta.price, image: meta.image, quantity: 1, isMock: true }); }
    mockSave(items);
    return items;
  }
  function mockChange(key, qty) {
    let items = mockGet();
    if (qty <= 0) { items = items.filter(i => i.key !== key); }
    else { const it = items.find(i => i.key === key); if (it) it.quantity = qty; }
    mockSave(items);
    return items;
  }
  function mockTotal(items) {
    return items.reduce((sum, i) => {
      const num = parseFloat(String(i.price).replace(/[^0-9.]/g, '')) || 0;
      return sum + num * i.quantity;
    }, 0);
  }
  function mockCount(items) { return items.reduce((s,i) => s + i.quantity, 0); }

  /* ══════════════════════════════════════
     UNIFIED CART DISPLAY
  ══════════════════════════════════════ */
  const elLoading  = document.getElementById('cart-loading');
  const elEmpty    = document.getElementById('cart-empty');
  const elList     = document.getElementById('cart-items-list');
  const elFooter   = document.getElementById('cart-footer');
  const elSubtotal = document.getElementById('cart-subtotal');
  const elCount    = document.getElementById('cart-count-label');

  function moneyFromCents(cents) { var n = parseInt(cents) || 0; return '$' + (n / 100).toFixed(2).replace(/\.00$/, ''); }
  function moneyFromFloat(f)     { var n = parseFloat(f) || 0; return '$' + n.toFixed(2).replace(/\.00$/, ''); }

  function showLoading() {
    elLoading && (elLoading.style.display = 'flex');
    elEmpty   && elEmpty.classList.add('hidden');
    elList    && elList.classList.add('hidden');
    elFooter  && elFooter.classList.add('hidden');
  }
  function showEmpty() {
    elLoading && (elLoading.style.display = 'none');
    elEmpty   && elEmpty.classList.remove('hidden');
    elList    && elList.classList.add('hidden');
    elFooter  && elFooter.classList.add('hidden');
    if (elCount) { elCount.textContent = ''; elCount.classList.add('hidden'); }
  }
  function showAll(allItems, subtotal, count) {
    elLoading && (elLoading.style.display = 'none');
    elEmpty   && elEmpty.classList.add('hidden');
    elList    && elList.classList.remove('hidden');
    elFooter  && elFooter.classList.remove('hidden');
    if (elSubtotal) elSubtotal.textContent = subtotal;
    if (elCount) {
      elCount.textContent = count + ' item' + (count !== 1 ? 's' : '');
      elCount.classList.remove('hidden');
    }
    renderItems(allItems);
  }

  function renderItems(items) {
    if (!elList) return;
    elList.innerHTML = items.map(item => {
      const priceStr = item.isMock ? item.price : moneyFromCents(item.price);
      const safeTitle = (item.product_title || '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
      const safeImg  = (item.image || '').replace(/"/g,'&quot;');
      const imgHtml  = item.image
        ? `<img src="${safeImg}" alt="${safeTitle}" class="w-full h-full object-cover">`
        : '<div class="w-full h-full bg-[#eee]"></div>';
      return `
      <div class="flex py-5 border-b border-[#f0f0f0]" data-key="${item.key}" data-mock="${item.isMock ? '1' : ''}" style="direction:inherit">
        <div class="w-[90px] h-[90px] flex-shrink-0 bg-[#f8f8f8] overflow-hidden" style="margin-inline-end:16px">${imgHtml}</div>
        <div class="flex-1 flex flex-col justify-between min-w-0">
          <div>
            <p class="text-[14px] font-medium text-[#222] truncate" style="font-family:var(--font-montserrat)">${safeTitle}</p>
            ${item.variant_title ? `<p class="text-[12px] text-[#aaa] mt-0.5" style="font-family:var(--font-montserrat)">${(item.variant_title || '').replace(/&/g,'&amp;').replace(/</g,'&lt;')}</p>` : ''}
            <p class="text-[13px] text-[#888] mt-1" style="font-family:var(--font-montserrat)">${priceStr}</p>
          </div>
          <div class="flex items-center mt-2" style="direction:ltr">
            <div class="flex items-center border border-[#e5e5e5] h-7">
              <button class="cart-qty-btn w-7 h-full flex items-center justify-center border-r border-[#e5e5e5] text-gray-400 hover:text-black transition-colors"
                      data-key="${item.key}" data-delta="-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 12H4"/></svg>
              </button>
              <span class="w-8 text-center text-[13px] text-gray-600" style="font-family:var(--font-montserrat)">${item.quantity}</span>
              <button class="cart-qty-btn w-7 h-full flex items-center justify-center border-l border-[#e5e5e5] text-gray-400 hover:text-black transition-colors"
                      data-key="${item.key}" data-delta="1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/></svg>
              </button>
            </div>
            <button class="cart-remove-btn text-[#ccc] hover:text-red-500 transition-colors" data-key="${item.key}" style="margin-inline-start:auto">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
      </div>`;
    }).join('');

    elList.querySelectorAll('.cart-qty-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key   = btn.dataset.key;
        const delta = parseInt(btn.dataset.delta);
        const row   = elList.querySelector(`[data-key="${key}"]`);
        const isMock = row && row.dataset.mock === '1';
        const qtyEl  = row && row.querySelector('span');
        const curQty = qtyEl ? parseInt(qtyEl.textContent) : 1;
        const newQty = Math.max(0, curQty + delta);
        if (isMock) { mockChange(key, newQty); loadCart(); }
        else updateRealCartItem(key, newQty);
      });
    });
    elList.querySelectorAll('.cart-remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key   = btn.dataset.key;
        const row   = elList.querySelector(`[data-key="${key}"]`);
        const isMock = row && row.dataset.mock === '1';
        if (isMock) { mockChange(key, 0); loadCart(); }
        else updateRealCartItem(key, 0);
      });
    });
  }

  function loadCart() {
    showLoading();
    fetch('/cart.js')
      .then(r => r.json())
      .then(realCart => {
        const mockItems  = mockGet();
        const allItems   = [...(realCart.items || []), ...mockItems];
        const mockSub    = mockTotal(mockItems);
        const realSub    = realCart.total_price / 100;
        const totalSub   = moneyFromFloat(realSub + mockSub);
        const totalCount = realCart.item_count + mockCount(mockItems);
        updateCartBadge(totalCount);
        if (allItems.length === 0) showEmpty();
        else showAll(allItems, totalSub, totalCount);
      })
      .catch(() => {
        const mockItems = mockGet();
        const sub = moneyFromFloat(mockTotal(mockItems));
        const cnt = mockCount(mockItems);
        updateCartBadge(cnt);
        if (mockItems.length === 0) showEmpty();
        else showAll(mockItems, sub, cnt);
      });
  }

  function updateRealCartItem(key, qty) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    }).then(() => loadCart());
  }

  window.EsterCart = {
    add: function(variantId, qty, meta) {
      qty  = qty  || 1;
      meta = meta || {};
      if (!variantId || variantId === '' || variantId === '0') {
        mockAdd({ title: meta.title || 'Product', price: meta.price || '$0', image: meta.image || '' });
        const cnt = mockCount(mockGet());
        updateCartBadge(cnt);
        openDrawer('cart-drawer');
        loadCart();
        return Promise.resolve();
      }
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: qty })
      })
      .then(r => r.json())
      .then(() => { openDrawer('cart-drawer'); loadCart(); })
      .catch(() => {
        mockAdd({ title: meta.title || 'Product', price: meta.price || '$0', image: meta.image || '' });
        const cnt = mockCount(mockGet());
        updateCartBadge(cnt);
        openDrawer('cart-drawer');
        loadCart();
      });
    }
  };

  function updateCartBadge(count) {
    document.querySelectorAll('[data-cart-count], [data-cart-count-mobile]').forEach(el => {
      el.textContent = count;
      el.style.display = '';
    });
  }

  /* Initial badge count (single fetch on page load) */
  fetch('/cart.js')
    .then(r => r.json())
    .then(c => { updateCartBadge((c.item_count || 0) + mockCount(mockGet())); })
    .catch(() => updateCartBadge(mockCount(mockGet())));

  /* Checkout button handler */
  const checkoutBtn = document.getElementById('cart-checkout-btn');
  if (checkoutBtn) {
    checkoutBtn.addEventListener('click', function() {
      window.location.href = '/checkout';
    });
  }

  window.ShopifyDrawer = { open: openDrawer, close: closeAll };
})();
</script>
