<!-- ==========================================
     GLOBAL DRAWERS: CART & FILTERS
=========================================== -->
{% schema %}
{
  "name": "Drawers",
  "settings": []
}
{% endschema %}

<style>
  /* Base Drawer Overlay */
  #drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 10000;
    display: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(4px);
    cursor: pointer;
  }
  
  /* Sidebar Drawer Base */
  .side-drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    background: #ffffff;
    z-index: 10001;
    box-shadow: -10px 0 30px rgba(0,0,0,0.1);
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex !important;
    flex-direction: column;
    width: 100%;
  }

  @media (min-width: 640px) {
    #cart-drawer { width: 500px; }
    #filter-drawer { width: 450px; }
  }

  /* State: Visible */
  .side-drawer.is-open {
    transform: translateX(0) !important;
  }
</style>

<!-- Overlay remains fixed at body bottom -->
<div id="drawer-overlay"></div>

<!-- ==========================================
     SHOPPING CART DRAWER
=========================================== -->
<div id="cart-drawer" class="side-drawer" role="dialog" aria-modal="true" aria-label="Cart">
  <!-- Header -->
  <div class="px-8 py-6 flex justify-between items-center bg-white border-b border-gray-100">
    <h2 class="text-[32px] font-medium text-black uppercase tracking-tight" style="font-family: var(--font-montserrat);">Cart</h2>
    <button type="button" class="drawer-close-btn p-2 -mr-2 hover:opacity-50 transition-opacity">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Items Content -->
  <div class="flex-1 overflow-y-auto px-8 py-4 space-y-8">
    <!-- Empty state example -->
    <div class="mt-20 text-center">
      <p class="text-[18px] text-gray-400" style="font-family: var(--font-montserrat);">Your cart is empty</p>
    </div>
  </div>

  <!-- Footer -->
  <div class="p-8 space-y-6 bg-white border-t border-gray-100">
    <div class="flex items-baseline justify-between mb-4">
      <span class="text-[64px] font-normal text-black leading-none" style="font-family: var(--font-montserrat);">$0</span>
      <span class="text-[14px] text-gray-400" style="font-family: var(--font-montserrat);">Subtotal</span>
    </div>
    
    <button class="w-full py-5 bg-[#d62873] text-white text-[18px] font-medium tracking-[0.1em] uppercase hover:bg-black transition-colors" style="font-family: var(--font-montserrat);">
      Checkout
    </button>
    
    <div class="text-center">
      <button type="button" class="drawer-close-btn text-[24px] font-normal text-black border-b border-black pb-1 hover:text-gray-400 hover:border-gray-400 transition-all" style="font-family: var(--font-montserrat);">
        Continue shopping
      </button>
    </div>
  </div>
</div>

<!-- ==========================================
     FILTER DRAWER
=========================================== -->
<div id="filter-drawer" class="side-drawer overflow-y-auto" role="dialog" aria-modal="true" aria-label="Filters">
  <div class="p-8 flex justify-end">
    <button type="button" class="drawer-close-btn p-2 hover:opacity-50 transition-opacity">
      <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="px-10 pb-16 space-y-12">
    <h3 class="text-[24px] font-semibold text-black tracking-tight" style="font-family: var(--font-montserrat);">FILTERS</h3>
    <p class="text-gray-400" style="font-family: var(--font-montserrat);">Filter functionality will be updated dynamically.</p>
  </div>
</div>

<script>
  (function() {
    // 1. SELECTORS
    const overlay = document.getElementById('drawer-overlay');
    const drawers = document.querySelectorAll('.side-drawer');
    const closeBtns = document.querySelectorAll('.drawer-close-btn');

    // 2. CORE FUNCTIONS
    function openDrawer(id) {
      const drawer = document.getElementById(id);
      if(!drawer || !overlay) return;
      
      overlay.style.display = 'block';
      document.body.style.overflow = 'hidden';
      
      setTimeout(() => {
        overlay.style.opacity = '1';
        drawer.classList.add('is-open');
      }, 50);
    }

    function closeAll() {
      drawers.forEach(d => d.classList.remove('is-open'));
      if(overlay) overlay.style.opacity = '0';
      document.body.style.overflow = '';
      
      setTimeout(() => {
        if(overlay) overlay.style.display = 'none';
      }, 400);
    }

    // 3. LISTENERS
    // Global delegation for data-drawer-trigger
    document.addEventListener('click', function(e) {
      const trigger = e.target.closest('[data-drawer-trigger]');
      if(trigger) {
        e.preventDefault();
        const targetId = trigger.getAttribute('data-drawer-trigger');
        openDrawer(targetId);
      }
    });

    // Close on overlay click
    if(overlay) overlay.addEventListener('click', closeAll);

    // Close on specific buttons
    closeBtns.forEach(btn => btn.addEventListener('click', closeAll));

    // Export functions to window if needed for inline use
    window.ShopifyDrawer = { open: openDrawer, close: closeAll };
  })();
</script>
