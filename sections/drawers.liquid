{% schema %}
{
  "name": "Drawers",
  "settings": []
}
{% endschema %}

<!-- Drawer Overlay -->
<div id="drawer-overlay" class="fixed inset-0 bg-black/40 z-[100] hidden backdrop-blur-sm transition-opacity duration-300 opacity-0" onclick="closeAllDrawers()"></div>

<!-- ==========================================
     SHOPPING CART DRAWER
=========================================== -->
<div id="cart-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[500px] bg-white z-[110] translate-x-full transition-transform duration-500 shadow-2xl flex flex-col">
  <!-- Header -->
  <div class="p-8 flex justify-between items-center bg-white border-b border-gray-100">
    <h2 class="text-[32px] font-medium text-black uppercase tracking-tight" style="font-family: var(--font-montserrat);">Shopping Cart</h2>
    <button onclick="closeCart()" class="p-2 -mr-2 hover:opacity-50 transition-opacity">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Items -->
  <div class="flex-1 overflow-y-auto px-8 py-4 space-y-8">
    
    <!-- Item 1 -->
    <div class="flex gap-6 pb-8 border-b border-gray-50">
      <div class="w-[100px] aspect-[3/4] shrink-0 bg-gray-100 overflow-hidden">
        <img src="{{ 'product-image-4.png' | asset_url }}" class="w-full h-full object-cover" alt="Vintage Scarf">
      </div>
      <div class="flex-1 flex flex-col justify-between py-2">
        <div>
          <div class="flex justify-between items-start">
            <h3 class="text-[18px] font-normal text-black" style="font-family: var(--font-montserrat);">Vintage Scarf</h3>
            <button class="text-gray-300 hover:text-red-500 transition-colors">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6"/>
              </svg>
            </button>
          </div>
          <p class="text-[14px] text-gray-400 mt-1" style="font-family: var(--font-montserrat);">Price: $80 | Size: M</p>
        </div>
        <div class="flex items-center border border-gray-200 w-fit">
          <button class="w-8 h-8 flex items-center justify-center hover:bg-gray-50">−</button>
          <span class="w-8 h-8 flex items-center justify-center text-[14px]">1</span>
          <button class="w-8 h-8 flex items-center justify-center hover:bg-gray-50">+</button>
        </div>
      </div>
    </div>

    <!-- Item 2 -->
    <div class="flex gap-6 pb-8 border-b border-gray-50">
      <div class="w-[100px] aspect-[3/4] shrink-0 bg-gray-100 overflow-hidden">
        <img src="{{ 'product-image-3.png' | asset_url }}" class="w-full h-full object-cover" alt="Pink Scarf">
      </div>
      <div class="flex-1 flex flex-col justify-between py-2">
        <div>
          <div class="flex justify-between items-start">
            <h3 class="text-[18px] font-normal text-black" style="font-family: var(--font-montserrat);">Pink Scarf</h3>
            <button class="text-gray-300 hover:text-red-500 transition-colors">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6"/>
              </svg>
            </button>
          </div>
          <p class="text-[14px] text-gray-400 mt-1" style="font-family: var(--font-montserrat);">Price: $80 | Size: S</p>
        </div>
        <div class="flex items-center border border-gray-200 w-fit">
          <button class="w-8 h-8 flex items-center justify-center hover:bg-gray-50">−</button>
          <span class="w-8 h-8 flex items-center justify-center text-[14px]">1</span>
          <button class="w-8 h-8 flex items-center justify-center hover:bg-gray-50">+</button>
        </div>
      </div>
    </div>

  </div>

  <!-- Footer -->
  <div class="p-8 space-y-6">
    <div class="flex items-baseline justify-between">
      <span class="text-[64px] font-normal text-black leading-none" style="font-family: var(--font-montserrat);">$160</span>
      <span class="text-[14px] text-gray-400" style="font-family: var(--font-montserrat);">Subtotal before shipping</span>
    </div>
    <button class="w-full py-5 bg-[#d62873] text-white text-[18px] font-medium tracking-[0.1em] uppercase hover:bg-[#b01e5d] transition-colors" style="font-family: var(--font-montserrat);">
      Checkout
    </button>
    <div class="relative flex items-center justify-center">
      <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-200"></div></div>
      <span class="relative px-4 text-gray-400 text-[14px] bg-white">or</span>
    </div>
    <div class="text-center">
      <button onclick="closeCart()" class="text-[24px] font-normal text-black border-b border-black pb-1 hover:text-gray-400 hover:border-gray-400 transition-all" style="font-family: var(--font-montserrat);">
        Continue shopping
      </button>
    </div>
  </div>
</div>

<!-- ==========================================
     FILTER DRAWER
=========================================== -->
<div id="filter-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[450px] bg-white z-[110] translate-x-full transition-transform duration-500 shadow-2xl flex flex-col overflow-y-auto">
  <!-- Header -->
  <div class="p-8 flex justify-end">
    <button onclick="closeFilter()" class="p-2 hover:opacity-50 transition-opacity">
      <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <div class="px-10 pb-16 space-y-12">
    
    <!-- SIZE Section -->
    <div class="space-y-6">
      <h3 class="text-[20px] font-semibold text-black tracking-tight" style="font-family: var(--font-montserrat);">SIZE</h3>
      <div class="flex flex-wrap gap-4">
        {% for size in "S,M,L" | split: "," %}
          <button class="w-[48px] h-[36px] border border-gray-200 flex items-center justify-center text-[16px] text-gray-500 font-light hover:border-black hover:text-black transition-colors">{{ size }}</button>
        {% endfor %}
        <button class="px-4 h-[36px] border border-gray-200 flex items-center justify-center text-[16px] text-gray-500 font-light hover:border-black hover:text-black transition-colors uppercase">One Size</button>
      </div>
      <hr class="border-gray-400">
    </div>

    <!-- CATEGORY Section -->
    <div class="space-y-6">
      <div class="flex justify-between items-center cursor-pointer">
        <h3 class="text-[20px] font-semibold text-black tracking-tight uppercase" style="font-family: var(--font-montserrat);">Category</h3>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m18 15-6-6-6 6"/></svg>
      </div>
      <div class="space-y-4">
        {% assign categories = "Newsboy caps,Berets,Hats,Beanies,Caps,Bucket hats,Scarves,Headbands,Sets" | split: "," %}
        {% for cat in categories %}
          <label class="flex items-center gap-3 cursor-pointer group">
            <input type="checkbox" class="hidden peer" {% if cat == "Scarves" %}checked{% endif %}>
            <div class="w-4 h-4 border border-black flex items-center justify-center peer-checked:bg-[#d62873] peer-checked:border-[#d62873] transition-all">
               <svg class="w-3 h-3 text-white peer-checked:block hidden transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-[17px] font-light text-[#333] group-hover:text-black transition-colors">{{ cat }}</span>
          </label>
        {% endfor %}
      </div>
      <hr class="border-gray-400">
    </div>

    <!-- COLOR Section -->
    <div class="space-y-6">
      <h3 class="text-[20px] font-semibold text-black tracking-tight uppercase" style="font-family: var(--font-montserrat);">Color</h3>
      <div class="flex flex-wrap gap-4">
        {% assign colors = "white:#FFFFFF,pink:#FCEEEF,beige:#D4B692,tan:#B37554,brown:#4A3631,magenta:#D62873,navy:#1D2B41,burgundy:#6A1117,olive:#8E8F7A" | split: "," %}
        {% for c in colors %}
           {% assign c_parts = c | split: ":" %}
           <button class="w-9 h-9 rounded-full border border-gray-200 shadow-sm" style="background-color: {{ c_parts[1] }};" title="{{ c_parts[0] }}"></button>
        {% endfor %}
      </div>
      <hr class="border-gray-400">
    </div>

    <!-- MATERIAL Section -->
    <div class="space-y-6">
      <div class="flex justify-between items-center cursor-pointer">
        <h3 class="text-[20px] font-semibold text-black tracking-tight uppercase" style="font-family: var(--font-montserrat);">Material</h3>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m18 15-6-6-6 6"/></svg>
      </div>
      <div class="space-y-4">
        {% assign materials = "Cashmere,Angora,Wool,Silk,Linen,Cotton,Eco-leather" | split: "," %}
        {% for mat in materials %}
          <label class="flex items-center gap-3 cursor-pointer group">
            <input type="checkbox" class="hidden peer" {% if mat == "Silk" %}checked{% endif %}>
            <div class="w-4 h-4 border border-black flex items-center justify-center peer-checked:bg-[#d62873] peer-checked:border-[#d62873] transition-all">
               <svg class="w-3 h-3 text-white peer-checked:block hidden transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-[17px] font-light text-[#333] group-hover:text-black transition-colors">{{ mat }}</span>
          </label>
        {% endfor %}
      </div>
    </div>

  </div>
</div>


