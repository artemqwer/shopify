{% schema %}
{
  "name": "Custom Checkout",
  "settings": []
}
{% endschema %}

<style>
  /* Base fonts and forms */
  .checkout-container {
    font-family: var(--font-montserrat), Montserrat, sans-serif;
  }
  .chk-input {
    width: 100%;
    border: none;
    border-bottom: 1px solid #d1d1d1;
    padding: 12px 0 8px 0;
    font-size: 13px;
    color: #222;
    background: transparent;
    transition: border-color 0.2s;
    outline: none;
  }
  .chk-input::placeholder { color: #888; }
  .chk-input:focus { border-bottom-color: #222; }

  /* Select dropdown */
  .chk-select {
    width: 100%;
    border: none;
    border-bottom: 1px solid #d1d1d1;
    padding: 12px 24px 8px 0;
    font-size: 13px;
    color: #222;
    background: transparent;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    outline: none;
    cursor: pointer;
  }
  .chk-select-wrapper { position: relative; }
  .chk-select-wrapper::after {
    content: '';
    position: absolute;
    right: 0; top: 50%;
    transform: translateY(-20%);
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #222;
    pointer-events: none;
  }

  /* Custom Radio/Checkboxes */
  .chk-radio-box {
    appearance: none;
    width: 16px; height: 16px;
    border: 1.5px solid #d1d1d1;
    border-radius: 50%;
    outline: none; cursor: pointer;
    position: relative; top: 2px; flex-shrink: 0;
  }
  .chk-radio-box:checked { border-color: #e61a7a; }
  .chk-radio-box:checked::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 8px; height: 8px;
    background-color: #e61a7a;
    border-radius: 50%;
  }

  .chk-checkbox {
    appearance: none;
    width: 14px; height: 14px;
    border: 1px solid #d1d1d1;
    border-radius: 0;
    outline: none; cursor: pointer;
    position: relative; top: 2px; flex-shrink: 0;
  }
  .chk-checkbox:checked { background-color: transparent; border-color: #222; }
  .chk-checkbox:checked::after {
    content: '';
    position: absolute;
    left: 4px; top: 0px;
    width: 4px; height: 9px;
    border: solid #222;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* Order Summary Block */
  .order-summary-box {
    border: 1px solid #e5e5e5;
    background: #fff;
    padding: 24px;
  }
  @media (min-width: 640px) {
    .order-summary-box { padding: 32px; }
  }

  .btn-confirm {
    width: 100%;
    background: #000;
    color: #fff;
    font-size: 13px;
    letter-spacing: 0.1em;
    font-weight: 600;
    padding: 16px 0;
    text-align: center;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    text-transform: uppercase;
  }
  .btn-confirm:hover { background: #444; }

  /* Mobile: summary first, then form */
  @media (max-width: 1023px) {
    .checkout-cols { flex-direction: column !important; }
    .checkout-form-col { order: 2; }
    .checkout-summary-col { order: 1; width: 100% !important; }
  }
</style>

<div class="checkout-container w-full max-w-[1920px] mx-auto px-4 md:px-[80px] lg:px-[160px] pb-[80px]">
  
  <!-- Breadcrumb -->
  <div class="flex justify-center items-center py-[24px]" {% if request.locale.iso_code == 'he' %}style="direction: rtl;"{% endif %}>
    <a href="{{ routes.root_url }}" class="text-[11px] tracking-[0.15em] uppercase text-gray-400 hover:text-gray-700 transition-colors">
      {% if request.locale.iso_code == 'he' %}בית{% else %}HOME{% endif %}
    </a>
    <span class="mx-2 text-[11px] text-gray-300">{% if request.locale.iso_code == 'he' %}‹{% else %}›{% endif %}</span>
    <span class="text-[11px] tracking-[0.15em] uppercase text-gray-800 font-medium">
      {% if request.locale.iso_code == 'he' %}לתשלום{% else %}CHECKOUT{% endif %}
    </span>
  </div>

  <div class="checkout-cols flex flex-col lg:flex-row gap-[32px] lg:gap-[100px] mt-8" {% if request.locale.iso_code == 'he' %}style="direction: rtl; text-align: right;"{% endif %}>
    
    <!-- LEFT COLUMN: Forms -->
    <div class="checkout-form-col flex-1 max-w-full lg:max-w-[600px]">
      
      <!-- Customer Details -->
      <h2 class="text-[22px] md:text-[32px] font-medium text-[#222] tracking-wide mb-6 md:mb-8">
        {% if request.locale.iso_code == 'he' %}פרטי לקוח{% else %}Customer Details{% endif %}
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 mb-6">
        <div>
          <input type="text" class="chk-input" placeholder="{% if request.locale.iso_code == 'he' %}שם משפחה*{% else %}Last Name*{% endif %}" required>
        </div>
        <div>
          <input type="text" class="chk-input" placeholder="{% if request.locale.iso_code == 'he' %}שם פרטי*{% else %}First Name*{% endif %}" required>
        </div>
        <div>
          <input type="tel" class="chk-input" placeholder="{% if request.locale.iso_code == 'he' %}מספר טלפון*{% else %}Phone Number*{% endif %}" required>
        </div>
        <div>
          <input type="email" class="chk-input" placeholder="{% if request.locale.iso_code == 'he' %}אימייל*{% else %}Email*{% endif %}" required>
        </div>
      </div>
      
      <div class="mb-5 chk-select-wrapper" {% if request.locale.iso_code == 'he' %}style="direction: ltr; text-align: right;"{% endif %}>
        <select class="chk-select" required {% if request.locale.iso_code == 'he' %}style="direction: rtl;"{% endif %}>
          <option value="" disabled hidden>{% if request.locale.iso_code == 'he' %}אזור*{% else %}Region*{% endif %}</option>
          <option value="UKR" selected>{% if request.locale.iso_code == 'he' %}אוקראינה{% else %}Ukraine{% endif %}</option>
          <option value="INT">{% if request.locale.iso_code == 'he' %}בינלאומי{% else %}International{% endif %}</option>
        </select>
      </div>
      
      <div class="flex items-center gap-2 mb-14">
        <input type="checkbox" id="chk-order-details" class="chk-checkbox">
        <label for="chk-order-details" class="text-[12px] text-gray-500 cursor-pointer">
          {% if request.locale.iso_code == 'he' %}צרו קשר לפרטי הזמנה{% else %}Contact me for order details{% endif %}
        </label>
      </div>

      <!-- Delivery -->
      <h2 class="text-[22px] md:text-[32px] font-medium text-[#222] tracking-wide mb-6 md:mb-8">
        {% if request.locale.iso_code == 'he' %}משלוח{% else %}Delivery{% endif %}
      </h2>
      
      <div class="space-y-6 mb-12">
        <div class="chk-select-wrapper" {% if request.locale.iso_code == 'he' %}style="direction: ltr; text-align: right;"{% endif %}>
          <select class="chk-select" required {% if request.locale.iso_code == 'he' %}style="direction: rtl;"{% endif %}>
            <option value="" disabled selected hidden>{% if request.locale.iso_code == 'he' %}עיר{% else %}City{% endif %}</option>
            <option value="Kyiv">{% if request.locale.iso_code == 'he' %}קייב{% else %}Kyiv{% endif %}</option>
            <option value="Lviv">{% if request.locale.iso_code == 'he' %}לבוב{% else %}Lviv{% endif %}</option>
            <option value="Odesa">{% if request.locale.iso_code == 'he' %}אודסה{% else %}Odesa{% endif %}</option>
            <option value="Dnipro">{% if request.locale.iso_code == 'he' %}דניפרו{% else %}Dnipro{% endif %}</option>
            <option value="Kharkiv">{% if request.locale.iso_code == 'he' %}חרקוב{% else %}Kharkiv{% endif %}</option>
          </select>
        </div>
        
        <div class="chk-select-wrapper" {% if request.locale.iso_code == 'he' %}style="direction: ltr; text-align: right;"{% endif %}>
          <select class="chk-select" required {% if request.locale.iso_code == 'he' %}style="direction: rtl;"{% endif %}>
            <option value="" disabled selected hidden>{% if request.locale.iso_code == 'he' %}סניף{% else %}Branch{% endif %}</option>
            <option value="1">{% if request.locale.iso_code == 'he' %}סניף 1{% else %}Branch #1{% endif %}</option>
            <option value="2">{% if request.locale.iso_code == 'he' %}סניף 2{% else %}Branch #2{% endif %}</option>
            <option value="3">{% if request.locale.iso_code == 'he' %}סניף 3{% else %}Branch #3{% endif %}</option>
          </select>
        </div>
        
        <div>
          <input type="text" class="chk-input" placeholder="{% if request.locale.iso_code == 'he' %}הערות להזמנה (לא חובה){% else %}Order notes (optional){% endif %}">
        </div>
      </div>
      
    </div>

    <!-- RIGHT COLUMN: Order Summary -->
    <div class="checkout-summary-col w-full lg:w-[440px] flex-shrink-0">
      <div class="order-summary-box shadow-sm">
        
        <!-- Promo Code -->
        <div class="flex items-center justify-between border-b border-[#e5e5e5] pb-4 mb-6 cursor-pointer group">
          <span class="text-[13px] font-semibold tracking-wider text-[#222]">
            {% if request.locale.iso_code == 'he' %}קוד קופון{% else %}PROMO CODE{% endif %}
          </span>
          <span class="text-[18px] font-light text-[#222] group-hover:text-gray-500 transition-colors">+</span>
        </div>
        
        <!-- Your Order -->
        <h3 class="text-[14px] font-semibold tracking-wider text-[#222] mb-4 uppercase">
          {% if request.locale.iso_code == 'he' %}ההזמנה שלך{% else %}Your Order{% endif %}
        </h3>
        
        <!-- Items Container (Dynamic via JS, falling back to static HTML if empty/loading) -->
        <div id="checkout-items-container" class="space-y-3 mb-6">
          <div class="flex items-center justify-between text-[12px] text-[#555]">
            <span class="truncate pr-4">Loading order...</span>
            <span class="flex-shrink-0">...</span>
          </div>
        </div>
        
        <!-- Subtotal -->
        <div class="flex items-center justify-between border-b border-[#e5e5e5] pb-5 mb-6 text-[12px] text-[#222]">
          <span class="tracking-widest uppercase">
            {% if request.locale.iso_code == 'he' %}סכום ביניים{% else %}Subtotal{% endif %}
          </span>
          <span id="checkout-subtotal" class="font-medium">$0</span>
        </div>
        
        <!-- Payment Method -->
        <h3 class="text-[14px] font-semibold tracking-wider text-[#222] mb-4 uppercase">
          {% if request.locale.iso_code == 'he' %}תשלום{% else %}Payment Method{% endif %}
        </h3>
        <div class="space-y-3 mb-6">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="radio" name="payment_method" class="chk-radio-box" checked>
            <span class="text-[12px] text-[#555]">
              {% if request.locale.iso_code == 'he' %}כרטיס אשראי, Apple Pay, Google Pay{% else %}Card payment, Apple Pay, Google Pay{% endif %}
            </span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer border-b border-[#e5e5e5] pb-5">
            <input type="radio" name="payment_method" class="chk-radio-box">
            <span class="text-[12px] text-[#555]">
              {% if request.locale.iso_code == 'he' %}תשלום במזומן במועד האספקה{% else %}Cash on delivery{% endif %}
            </span>
          </label>
        </div>
        
        <!-- Shipping -->
        <h3 class="text-[14px] font-semibold tracking-wider text-[#222] mb-4 uppercase">
          {% if request.locale.iso_code == 'he' %}משלוח{% else %}Shipping{% endif %}
        </h3>
        <div class="space-y-3 mb-6 border-b border-[#e5e5e5] pb-5">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="radio" name="shipping_method" class="chk-radio-box" checked>
            <span class="text-[12px] text-[#555]">
              {% if request.locale.iso_code == 'he' %}נובה פושטה{% else %}Nova Poshta{% endif %}
            </span>
          </label>
        </div>
        
        <!-- Total -->
        <div class="flex items-center justify-between mb-6">
          <span class="text-[14px] font-semibold tracking-wider text-[#222] uppercase">
            {% if request.locale.iso_code == 'he' %}סך הכל לתשלום{% else %}Total to pay{% endif %}
          </span>
          <span id="checkout-total" class="font-bold text-[16px] text-[#222]">$0</span>
        </div>
        
        <!-- Info & Consent -->
        <p class="text-[11px] text-[#888] leading-[1.6] mb-5">
          {% if request.locale.iso_code == 'he' %}המידע האישי שלך ישמש לעיבוד ההזמנה, לשיפור חווית המשתמש ולמטרות נוספות המתוארות במדיניות הפרטיות.{% else %}Your personal data will be used to process your order, support your experience throughout this website, and for other purposes described in our privacy policy.{% endif %}
        </p>
        <div class="flex items-start gap-2 mb-8">
          <input type="checkbox" id="chk-terms" class="chk-checkbox mt-0.5">
          <label for="chk-terms" class="text-[11px] text-[#888] cursor-pointer leading-tight">
            {% if request.locale.iso_code == 'he' %}קראתי והסכמתי לתנאי האתר*{% else %}I have read and agree to the website terms and conditions*{% endif %}
          </label>
        </div>
        
        <button type="button" class="btn-confirm" onclick="confirmOrder()">
          {% if request.locale.iso_code == 'he' %}אישור הזמנה{% else %}Confirm Order{% endif %}
        </button>
      </div>
    </div>
    
  </div>
</div>

<script>
  function formatMoney(cents) {
    if (typeof cents === 'string' && cents.indexOf('$') !== -1) return cents;
    return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
  }
  
  function getMockCart() {
    try { return JSON.parse(localStorage.getItem('ester_mock_cart')) || []; } catch(e) { return []; }
  }

  function renderCheckout(cart, mockItems) {
    const container = document.getElementById('checkout-items-container');
    const subtotalEl = document.getElementById('checkout-subtotal');
    const totalEl = document.getElementById('checkout-total');
    
    let html = '';
    let realCents = cart ? cart.total_price : 0;
    
    // 1. Render Real Items
    if (cart && cart.items && cart.items.length > 0) {
      cart.items.forEach(item => {
        const title = item.product_title + (item.variant_title ? ' - ' + item.variant_title : '');
        html += `
          <div class="flex justify-between items-center text-[12px] text-[#555] mb-2">
            <div class="truncate pr-4">${title} ${item.quantity > 1 ? `<span class="text-gray-400">x${item.quantity}</span>` : ''}</div>
            <div class="flex-shrink-0">${formatMoney(item.original_line_price)}</div>
          </div>
        `;
      });
    }
    
    // 2. Render Mock Items
    let mockTotalVal = 0;
    if (mockItems && mockItems.length > 0) {
      mockItems.forEach(item => {
        const valStr = String(item.price).replace(/[^0-9.]/g, '');
        const unitVal = parseFloat(valStr) || 0;
        const lineVal = unitVal * item.quantity;
        mockTotalVal += lineVal;
        
        const title = item.product_title + (item.variant_title ? ' - ' + item.variant_title : '');
        html += `
          <div class="flex justify-between items-center text-[12px] text-[#555] mb-2">
            <div class="truncate pr-4">${title} ${item.quantity > 1 ? `<span class="text-gray-400">x${item.quantity}</span>` : ''}</div>
            <div class="flex-shrink-0">$${lineVal}</div>
          </div>
        `;
      });
    }
    
    if (html === '') {
      html = '<div class="text-[12px] text-[#888]">Your cart is empty.</div>';
    }
    
    container.innerHTML = html;
    
    // 3. Totals
    const finalTotal = (realCents / 100) + mockTotalVal;
    const finalTotalStr = '$' + finalTotal.toFixed(2).replace(/\.00$/, '');
    
    subtotalEl.textContent = finalTotalStr;
    totalEl.textContent = finalTotalStr;
  }

  document.addEventListener('DOMContentLoaded', function() {
    const mockItems = getMockCart();
    
    fetch('/cart.js')
      .then(r => r.json())
      .then(cart => {
        renderCheckout(cart, mockItems);
      })
      .catch(() => {
        renderCheckout(null, mockItems);
      });
  });

  function confirmOrder() {
    const terms = document.getElementById('chk-terms');
    if (!terms.checked) {
      alert(document.dir === 'rtl' ? "אנא אשר את תנאי האתר" : "Please agree to the terms and conditions before proceeding.");
      return;
    }
    
    const btn = document.querySelector('.btn-confirm');
    const og = btn.textContent;
    btn.textContent = document.dir === 'rtl' ? 'מעבד...' : 'Processing...';
    btn.disabled = true;
    
    setTimeout(() => {
      alert(document.dir === 'rtl' ? "תודה על ההזמנה! זו הדגמה." : "Thank you for your order! This is a custom demo checkout.");
      
      // Clear mock cart as demo
      localStorage.removeItem('ester_mock_cart');
      
      // Clear Shopify cart and redirect
      fetch('{{ routes.cart_clear_url }}', { method: 'POST' }).finally(() => {
        window.location.href = '{{ routes.root_url }}';
      });
    }, 1500);
  }
</script>
