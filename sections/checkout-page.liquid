<div class="checkout-container w-full max-w-[1280px] mx-auto px-4 md:px-[20px] pb-0 md:pb-[80px]" dir="{{ chk_dir }}">

  <!-- Breadcrumb -->
  <div class="flex justify-center items-center py-[24px]">
    <a href="{{ routes.root_url }}" class="text-[11px] tracking-[0.15em] uppercase text-gray-400 hover:text-gray-700 transition-colors">
      {{ txt_home }}
    </a>
    <span class="mx-2 text-[11px] text-gray-300">{{ txt_chevron }}</span>
    <span class="text-[11px] tracking-[0.15em] uppercase text-gray-800 font-medium">
      {{ txt_checkout }}
    </span>
  </div>

  <div class="checkout-cols flex flex-col lg:flex-row gap-[32px] lg:gap-[100px] mt-0">

    <!-- LEFT COLUMN: Forms -->
    <div class="checkout-form-col flex-1 max-w-full lg:max-w-[600px]">

      <!-- Customer Details -->
      <h2 class="text-[28px] md:text-[32px] font-light text-[#222] tracking-wide mb-6 md:mb-8">
        {{ txt_details }}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 mb-6">
        <div>
          <label for="chk-last-name" class="sr-only">{{ txt_last }}</label>
          <input type="text" id="chk-last-name" class="chk-input" placeholder="{{ txt_last }}" required autocomplete="family-name"
            value="{% if customer %}{{ customer.last_name }}{% endif %}">
        </div>
        <div>
          <label for="chk-first-name" class="sr-only">{{ txt_first }}</label>
          <input type="text" id="chk-first-name" class="chk-input" placeholder="{{ txt_first }}" required autocomplete="given-name"
            value="{% if customer %}{{ customer.first_name }}{% endif %}">
        </div>
        <div>
          <label for="chk-phone" class="sr-only">{{ txt_phone }}</label>
          <input type="tel" id="chk-phone" class="chk-input" placeholder="{{ txt_phone }}"
                 inputmode="tel" autocomplete="tel"
                 pattern="^[\+]?[\d\s\-\(\)]{7,20}$"
                 maxlength="20" required
                 value="{% if customer %}{{ customer.phone | default: customer.default_address.phone }}{% endif %}">
        </div>
        <div>
          <label for="chk-email" class="sr-only">{{ txt_email }}</label>
          <input type="email" id="chk-email" class="chk-input" placeholder="{{ txt_email }}" required autocomplete="email"
            value="{% if customer %}{{ customer.email }}{% endif %}">
        </div>
      </div>

      <div class="mb-5 chk-select-wrapper">
        <select class="chk-select" required>
          <option value="" disabled hidden>{{ txt_region }}</option>
          <option value="UKR" selected>{{ txt_ukraine }}</option>
          <option value="INT">{{ txt_intl }}</option>
        </select>
      </div>

      <div class="flex items-center gap-2 mb-14">
        <input type="checkbox" id="chk-order-details" class="chk-checkbox">
        <label for="chk-order-details" class="text-[12px] text-gray-500 cursor-pointer">
          {{ txt_contact_me }}
        </label>
      </div>

      <!-- Delivery -->
      <h2 class="text-[28px] md:text-[32px] font-light text-[#222] tracking-wide mb-6 md:mb-8">
        {{ txt_delivery }}
      </h2>

      <div class="space-y-6 mb-12">
        <div class="chk-select-wrapper">
          <label for="chk-city" class="sr-only">{{ txt_city }}</label>
          {% assign cust_city = customer.default_address.city | downcase %}
          <select id="chk-city" class="chk-select" required>
            <option value="" disabled {% unless cust_city %}selected{% endunless %} hidden>{{ txt_city }}</option>
            <option value="Kyiv" {% if cust_city == 'kyiv' or cust_city == 'київ' %}selected{% endif %}>Kyiv</option>
            <option value="Lviv" {% if cust_city == 'lviv' or cust_city == 'львів' %}selected{% endif %}>Lviv</option>
            <option value="Odesa" {% if cust_city == 'odesa' or cust_city == 'одеса' %}selected{% endif %}>Odesa</option>
            <option value="Dnipro" {% if cust_city == 'dnipro' or cust_city == 'дніпро' %}selected{% endif %}>Dnipro</option>
            <option value="Kharkiv" {% if cust_city == 'kharkiv' or cust_city == 'харків' %}selected{% endif %}>Kharkiv</option>
          </select>
        </div>

        <div class="chk-select-wrapper">
          <label for="chk-branch" class="sr-only">{{ txt_branch }}</label>
          <select id="chk-branch" class="chk-select" required>
            <option value="" disabled selected hidden>{{ txt_branch }}</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
          </select>
        </div>

        <div>
          <label for="chk-notes" class="sr-only">{{ txt_notes }}</label>
          <textarea id="chk-notes" class="chk-input" placeholder="{{ txt_notes }}" rows="3" style="resize:none; padding-top:12px;"></textarea>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: Order Summary -->
    <div class="checkout-summary-col w-full lg:w-[440px] flex-shrink-0">
      <div class="order-summary-box">

        <!-- Promo Code -->
        <div class="border-b border-[#e5e5e5] pb-4 mb-6">
          <div class="flex items-center justify-between cursor-pointer group" onclick="togglePromoField()">
            <span class="text-[13px] font-semibold tracking-wider text-[#222]">{{ txt_promo }}</span>
            <span id="promo-toggle-icon" class="text-[18px] font-light text-[#222] group-hover:text-gray-500 transition-colors">+</span>
          </div>
          <div id="promo-field" class="hidden mt-3">
            <div class="flex gap-2">
              <input type="text" id="promo-input" placeholder="{{ txt_promo_placeholder }}"
                class="flex-1 border border-[#ddd] px-3 py-2 text-[13px] outline-none focus:border-[#222] transition-colors rounded-none">
              <button type="button" onclick="applyPromoCode()"
                class="bg-[#222] text-white px-4 py-2 text-[12px] font-semibold tracking-wider hover:bg-[#444] transition-colors">
                {{ txt_promo_apply }}
              </button>
            </div>
            <div id="promo-message" class="text-[11px] mt-2 hidden"></div>
            <div id="promo-applied" class="hidden mt-2 flex items-center justify-between text-[12px]">
              <span class="text-green-600" id="promo-applied-text"></span>
              <button type="button" onclick="removePromoCode()" class="text-[#999] hover:text-[#222] text-[11px] underline">✕</button>
            </div>
          </div>
        </div>

        <!-- Your Order -->
        <h3 class="text-[14px] font-semibold tracking-wider text-[#222] mb-4 uppercase">{{ txt_your_order }}</h3>

        <!-- Items Container (Dynamic via JS) -->
        <div id="checkout-items-container" class="space-y-3 mb-6">
          <div class="flex items-center justify-between text-[12px] text-[#555]">
            <span class="truncate pr-4">Loading order...</span>
            <span class="flex-shrink-0">...</span>
          </div>
        </div>

        <!-- Discount row (hidden by default) -->
        <div id="discount-row" class="hidden flex items-center justify-between text-[12px] text-green-600 mb-4">
          <span id="discount-label"></span>
          <span id="discount-amount"></span>
        </div>

        <!-- Subtotal -->
        <div class="flex items-center justify-between border-b border-[#e5e5e5] pb-5 mb-6 text-[12px] text-[#222]">
          <span class="tracking-widest uppercase">{{ txt_subtotal }}</span>
          <span id="checkout-subtotal" class="font-medium">$0</span>
        </div>

        <!-- Payment Method -->
        <h3 class="text-[14px] font-semibold tracking-wider text-[#222] mb-4 uppercase">{{ txt_payment }}</h3>
        <div class="space-y-3 mb-6">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="radio" name="payment_method" value="applepay" class="chk-radio-box" checked>
            <img src="{{ 'apple-pay.svg' | asset_url }}" width="28" height="14" alt="Apple Pay">
          </label>
          <label class="flex items-center gap-3 cursor-pointer border-b border-[#e5e5e5] pb-5">
            <input type="radio" name="payment_method" value="card" class="chk-radio-box">
            <span class="text-[12px] text-[#555]">{{ txt_card_gpay }}</span>
          </label>
        </div>

        <!-- Shipping -->
        <h3 class="text-[14px] font-semibold tracking-wider text-[#222] mb-4 uppercase">{{ txt_shipping }}</h3>
        <div class="space-y-3 mb-6 border-b border-[#e5e5e5] pb-5">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="radio" name="shipping_method" class="chk-radio-box" checked>
            <span class="text-[12px] text-[#555]">{{ txt_nova }}</span>
          </label>
        </div>

        <!-- Total -->
        <div class="flex items-center justify-between mb-6">
          <span class="text-[14px] font-semibold tracking-wider text-[#222] uppercase">{{ txt_total }}</span>
          <span id="checkout-total" class="font-bold text-[16px] text-[#222]">$0</span>
        </div>

        <!-- Info & Consent -->
        <p class="text-[11px] text-[#888] leading-[1.6] mb-5">{{ txt_privacy_msg }}</p>
        <div class="flex items-start gap-2 mb-8">
          <input type="checkbox" id="chk-terms" class="chk-checkbox mt-0.5">
          <label for="chk-terms" class="text-[11px] text-[#888] cursor-pointer leading-tight">{{ txt_agree }}</label>
        </div>

        <!-- Dynamic confirm button -->
        <div id="chk-confirm-wrapper">
          <button type="button" class="btn-applepay" id="btn-applepay-confirm" onclick="confirmOrder('applepay')">
            <span>Pay with</span>
            <img src="{{ 'apple-pay.svg' | asset_url }}" width="44" height="22" style="filter:invert(1); margin-top:1px;" alt="Apple Pay">
          </button>
          <button type="button" class="btn-confirm" id="btn-regular-confirm" style="display:none;" onclick="confirmOrder('regular')">
            {{ txt_confirm }}
          </button>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
  // ── Phone mask ──
  (function() {
    var phoneEl = document.getElementById('chk-phone');
    if (!phoneEl) return;

    phoneEl.addEventListener('input', function(e) {
      var raw = e.target.value;
      var cleaned = raw.replace(/[^\d+]/g, '');
      if (cleaned.charAt(0) === '+') {
        cleaned = '+' + cleaned.slice(1).replace(/\+/g, '');
      } else {
        cleaned = cleaned.replace(/\+/g, '');
      }
      var digits = cleaned.replace(/[^\d]/g, '');
      if (digits.length > 15) {
        cleaned = cleaned.slice(0, cleaned.length - (digits.length - 15));
      }
      e.target.value = cleaned;
    });

    phoneEl.addEventListener('keydown', function(e) {
      var allow = ['Backspace','Delete','Tab','Enter','Escape','ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Home','End'];
      if (allow.includes(e.key)) return;
      if (e.ctrlKey || e.metaKey) return;
      if (!/[\d\+\-\s\(\)]/.test(e.key)) e.preventDefault();
    });

    phoneEl.addEventListener('paste', function(e) {
      e.preventDefault();
      var text = (e.clipboardData || window.clipboardData).getData('text');
      var cleaned = text.replace(/[^\d+\-\s\(\)]/g, '');
      var start = phoneEl.selectionStart;
      var before = phoneEl.value.substring(0, start);
      var after  = phoneEl.value.substring(phoneEl.selectionEnd);
      phoneEl.value = (before + cleaned + after).substring(0, 20);
    });
  })();

  // ── Payment method → update confirm button ──
  document.querySelectorAll('input[name="payment_method"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var appleBtn   = document.getElementById('btn-applepay-confirm');
      var regularBtn = document.getElementById('btn-regular-confirm');
      if (this.value === 'applepay') {
        appleBtn.style.display   = '';
        regularBtn.style.display = 'none';
      } else {
        appleBtn.style.display   = 'none';
        regularBtn.style.display = '';
        regularBtn.style.background = '#000';
      }
    });
  });

  // ── Promo Code Logic ──
  let activePromo = null; // { code, type: 'percent'|'fixed', value: number }

  function togglePromoField() {
    const field = document.getElementById('promo-field');
    const icon = document.getElementById('promo-toggle-icon');
    if (field.classList.contains('hidden')) {
      field.classList.remove('hidden');
      icon.textContent = '−';
      document.getElementById('promo-input').focus();
    } else {
      field.classList.add('hidden');
      icon.textContent = '+';
    }
  }

  function applyPromoCode() {
    const input = document.getElementById('promo-input');
    const msgEl = document.getElementById('promo-message');
    const code = input.value.trim().toUpperCase();

    if (!code) {
      showPromoMessage(msgEl, 'Please enter a promo code.', 'red');
      return;
    }

    // Check discount code via Shopify AJAX API
    fetch('/discount/' + encodeURIComponent(code), { method: 'GET', redirect: 'follow' })
      .then(r => {
        if (!r.ok) return Promise.reject('Invalid discount code');
        // After applying, check cart for discount
        return fetch('/cart.js').then(r => r.json());
      })
      .then(cart => {
        if (cart.total_discount && cart.total_discount > 0) {
          activePromo = { code: code, type: 'fixed', value: cart.total_discount / 100 };
          showAppliedPromo(code, cart.total_discount / 100);
          recalcTotals();
        } else {
          // Discount might not apply via AJAX — store locally for demo
          showPromoMessage(msgEl, 'Code applied! Discount will be calculated at final checkout.', 'green');
          activePromo = { code: code, type: 'percent', value: 0 };
          showAppliedPromo(code, 0);
        }
      })
      .catch(() => {
        showPromoMessage(msgEl, 'Could not verify code. It will be applied at checkout.', 'orange');
        activePromo = { code: code, type: 'percent', value: 0 };
        showAppliedPromo(code, 0);
      });
  }

  function showPromoMessage(el, text, color) {
    el.textContent = text;
    el.style.color = color;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 4000);
  }

  function showAppliedPromo(code, discount) {
    const appliedEl = document.getElementById('promo-applied');
    const appliedText = document.getElementById('promo-applied-text');
    const discountRow = document.getElementById('discount-row');
    const discountLabel = document.getElementById('discount-label');
    const discountAmount = document.getElementById('discount-amount');

    appliedText.textContent = code;
    appliedEl.classList.remove('hidden');
    document.getElementById('promo-input').disabled = true;

    if (discount > 0) {
      discountLabel.textContent = code;
      discountAmount.textContent = '-$' + discount.toFixed(2).replace(/\.00$/, '');
      discountRow.classList.remove('hidden');
    }
  }

  function removePromoCode() {
    activePromo = null;
    document.getElementById('promo-applied').classList.add('hidden');
    document.getElementById('discount-row').classList.add('hidden');
    document.getElementById('promo-input').value = '';
    document.getElementById('promo-input').disabled = false;
    // Clear Shopify discount
    fetch('/discount/clear', { method: 'GET' }).catch(() => {});
    recalcTotals();
  }

  function recalcTotals() {
    const mockItems = getMockCart();
    fetch('/cart.js')
      .then(r => r.json())
      .then(cart => renderCheckout(cart, mockItems))
      .catch(() => renderCheckout(null, mockItems));
  }

  function formatMoney(cents) {
    if (typeof cents === 'string' && cents.indexOf('$') !== -1) return cents;
    return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
  }

  function getMockCart() {
    try { return JSON.parse(localStorage.getItem('ester_mock_cart')) || []; } catch(e) { return []; }
  }

  function escHtml(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  function renderCheckout(cart, mockItems) {
    const container  = document.getElementById('checkout-items-container');
    const subtotalEl = document.getElementById('checkout-subtotal');
    const totalEl    = document.getElementById('checkout-total');

    let html = '';
    let realCents = cart ? cart.total_price : 0;

    if (cart && cart.items && cart.items.length > 0) {
      cart.items.forEach(item => {
        const title = escHtml(item.product_title + (item.variant_title ? ' - ' + item.variant_title : ''));
        html += `<div class="flex justify-between items-center text-[12px] text-[#555] mb-2">
          <div class="truncate pr-4">${title}${item.quantity > 1 ? ` <span class="text-gray-400">x${item.quantity}</span>` : ''}</div>
          <div class="flex-shrink-0">${formatMoney(item.original_line_price)}</div>
        </div>`;
      });
    }

    let mockTotalVal = 0;
    if (mockItems && mockItems.length > 0) {
      mockItems.forEach(item => {
        const valStr = String(item.price).replace(/[^0-9.]/g, '');
        const unitVal = parseFloat(valStr) || 0;
        const lineVal = unitVal * item.quantity;
        mockTotalVal += lineVal;
        const title = escHtml(item.product_title + (item.variant_title ? ' - ' + item.variant_title : ''));
        html += `<div class="flex justify-between items-center text-[12px] text-[#555] mb-2">
          <div class="truncate pr-4">${title}${item.quantity > 1 ? ` <span class="text-gray-400">x${item.quantity}</span>` : ''}</div>
          <div class="flex-shrink-0">$${lineVal}</div>
        </div>`;
      });
    }

    if (html === '') html = '<div class="text-[12px] text-[#888]">Your cart is empty.</div>';
    container.innerHTML = html;

    const subtotal = (realCents / 100) + mockTotalVal;
    const subtotalStr = '$' + subtotal.toFixed(2).replace(/\.00$/, '');
    subtotalEl.textContent = subtotalStr;

    let finalTotal = subtotal;
    if (activePromo && activePromo.value > 0) {
      finalTotal = Math.max(0, subtotal - activePromo.value);
    }
    const finalTotalStr = '$' + finalTotal.toFixed(2).replace(/\.00$/, '');
    totalEl.textContent = finalTotalStr;
  }

  document.addEventListener('DOMContentLoaded', function() {
    const mockItems = getMockCart();
    fetch('/cart.js')
      .then(r => r.json())
      .then(cart => renderCheckout(cart, mockItems))
      .catch(() => renderCheckout(null, mockItems));
  });

  function confirmOrder(method) {
    const terms = document.getElementById('chk-terms');
    const dir   = document.documentElement.getAttribute('dir') || document.body.dir || 'ltr';

    // ── Validate required fields ──
    const lastName  = document.getElementById('chk-last-name');
    const firstName = document.getElementById('chk-first-name');
    const phone     = document.getElementById('chk-phone');
    const email     = document.getElementById('chk-email');
    const city      = document.getElementById('chk-city');

    const required = [lastName, firstName, phone, email, city];
    for (const el of required) {
      if (!el || !el.value.trim()) {
        if (el) { el.focus(); el.style.borderColor = '#e61a7a'; setTimeout(() => { el.style.borderColor = ''; }, 2000); }
        return;
      }
    }

    if (!terms.checked) {
      alert(dir === 'rtl' ? 'אנא אשר את תנאי האתר' : 'Please agree to the terms and conditions before proceeding.');
      return;
    }

    // ── Show loading state ──
    const activeBtn = method === 'applepay'
      ? document.getElementById('btn-applepay-confirm')
      : document.getElementById('btn-regular-confirm');
    activeBtn.innerHTML = dir === 'rtl' ? 'מעבד...' : 'Processing...';
    activeBtn.disabled = true;

    // ── Save delivery info as cart note & attributes ──
    const notes  = document.getElementById('chk-notes');
    const branch = document.getElementById('chk-branch');
    const cityText = city.options[city.selectedIndex] ? city.options[city.selectedIndex].text : city.value;

    const noteVal = [
      lastName.value.trim() + ' ' + firstName.value.trim(),
      phone.value.trim(),
      email.value.trim(),
      'City: ' + cityText,
      branch && branch.value ? 'Branch: ' + branch.value : '',
      notes && notes.value.trim() ? 'Notes: ' + notes.value.trim() : ''
    ].filter(Boolean).join(' | ');

    const formData = new FormData();
    formData.append('note', noteVal);
    formData.append('attributes[Customer Name]', lastName.value.trim() + ' ' + firstName.value.trim());
    formData.append('attributes[Phone]', phone.value.trim());
    formData.append('attributes[Email]', email.value.trim());
    formData.append('attributes[City]', cityText);
    formData.append('attributes[Payment Method]', method);
    if (branch && branch.value) formData.append('attributes[Branch]', branch.value);
    if (notes && notes.value.trim()) formData.append('attributes[Notes]', notes.value.trim());

    // Update cart then go to real Shopify checkout
    fetch('/cart/update.js', { method: 'POST', body: formData })
      .catch(function() {})
      .finally(function() {
        localStorage.removeItem('ester_mock_cart');
        window.location.href = '/checkout';
      });
  }
</script>
