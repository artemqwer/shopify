{% schema %}
{
  "name": "Custom Checkout",
  "settings": []
}
{% endschema %}

<style>
  /* Base fonts and forms */
  .checkout-container {
    font-family: var(--font-montserrat), Montserrat, sans-serif;
  }
  .chk-input {
    width: 100%;
    border: 1px solid #d1d1d1;
    padding: 12px 14px;
    font-size: 13px;
    color: #222;
    background: transparent;
    transition: border-color 0.2s;
    outline: none;
  }
  .chk-input::placeholder { color: #888; }
  .chk-input:focus { border-color: #222; }

  /* Select dropdown */
  .chk-select {
    width: 100%;
    border: none;
    border-bottom: 1px solid #d1d1d1;
    padding: 12px 24px 8px 0;
    font-size: 13px;
    color: #222;
    background: transparent;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    outline: none;
    cursor: pointer;
  }
  .chk-select-wrapper { position: relative; }
  .chk-select-wrapper::after {
    content: '';
    position: absolute;
    right: 0; top: 50%;
    transform: translateY(-20%);
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #222;
    pointer-events: none;
  }

  /* Custom Radio/Checkboxes */
  .chk-radio-box {
    appearance: none;
    width: 16px; height: 16px;
    border: 1.5px solid #d1d1d1;
    border-radius: 50%;
    outline: none; cursor: pointer;
    position: relative; top: 2px; flex-shrink: 0;
  }
  .chk-radio-box:checked { border-color: #222; }
  .chk-radio-box:checked::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 8px; height: 8px;
    background-color: #222;
    border-radius: 50%;
  }

  .chk-checkbox {
    appearance: none;
    width: 14px; height: 14px;
    border: 1px solid #d1d1d1;
    border-radius: 0;
    outline: none; cursor: pointer;
    position: relative; top: 2px; flex-shrink: 0;
  }
  .chk-checkbox:checked { background-color: transparent; border-color: #222; }
  .chk-checkbox:checked::after {
    content: '';
    position: absolute;
    left: 4px; top: 0px;
    width: 4px; height: 9px;
    border: solid #222;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* Order Summary Block */
  .order-summary-box {
    border: 1px solid #e5e5e5;
    background: #fff;
    padding: 24px 24px 0;
  }
  @media (min-width: 640px) {
    .order-summary-box { padding: 32px 32px 0; }
  }
  @media (min-width: 1024px) {
    .order-summary-box { padding: 32px; }
  }

  /* Express Checkout button (Apple Pay style) */
  .btn-applepay {
    width: 100%;
    background: #000;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    padding: 15px 0;
    text-align: center;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    letter-spacing: 0.01em;
    transition: background 0.2s;
  }
  .btn-applepay:hover { background: #222; }

  /* "Or fill in your details" separator */
  .chk-or-separator {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 24px 0 28px;
    color: #888;
    font-size: 11px;
    letter-spacing: 0.03em;
  }
  .chk-or-separator::before,
  .chk-or-separator::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #d1d1d1;
  }

  /* Express Checkout title separator */
  .express-checkout-title {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .express-checkout-title::before,
  .express-checkout-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #d1d1d1;
  }

  .btn-confirm {
    width: 100%;
    background: #000;
    color: #fff;
    font-size: 13px;
    letter-spacing: 0.1em;
    font-weight: 600;
    padding: 16px 0;
    text-align: center;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    text-transform: uppercase;
  }
  .btn-confirm:hover { background: #444; }

  /* Mobile: form first, then summary */
  @media (max-width: 1023px) {
    .checkout-cols { flex-direction: column !important; }
    .checkout-form-col { order: 1; }
    .checkout-summary-col { order: 2; width: 100% !important; }
  }
</style>

