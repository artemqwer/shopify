{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Hero Video (mp4 recommended)"
    }
  ]
}
{% endschema %}

<!-- Mobile Video Hero -->
<section class="w-full relative h-[100dvh] block md:hidden">
  <div class="absolute inset-0 w-full h-full overflow-hidden bg-black/10">
    {% if section.settings.mobile_video != blank %}
      {{ section.settings.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: 'master', class: 'w-full h-full object-cover', id: 'hero-video-el' }}
    {% else %}
      <div class="w-full h-full flex items-center justify-center bg-gray-200">
        <p class="text-gray-500 font-medium">Please upload a video in Theme Settings</p>
      </div>
    {% endif %}
  </div>

  <div class="absolute inset-x-0 bottom-[12px] flex justify-center items-center gap-12 z-20">
    <a href="{{ routes.all_products_collection_url }}" class="text-white opacity-90 border-b border-white transition-all text-center" style="font-family: Montserrat, sans-serif; font-weight: 300; font-size: 12px; line-height: 1; letter-spacing: 0.03em; text-transform: none;">
      {{ 'hero.for_sea' | t }}
    </a>
    <a href="{{ routes.all_products_collection_url }}" class="text-white opacity-90 border-b border-white transition-all text-center" style="font-family: Montserrat, sans-serif; font-weight: 300; font-size: 12px; line-height: 1; letter-spacing: 0.03em; text-transform: none;">
      {{ 'hero.classic' | t }}
    </a>
  </div>
</section>

<!-- Desktop Image Grid Hero -->
<section class="hidden md:block px-4 md:px-12 lg:px-[160px] w-full mb-[32px] md:mb-24 md:mt-[102px]">
  <div class="grid grid-cols-1 md:grid-cols-[552fr_515fr_533fr] w-full aspect-[390/500] md:aspect-[1600/640] overflow-hidden">
        <div class="relative w-full h-full">
          <img 
            src="{{ 'hero-image-1.png' | asset_url }}" 
            alt="Hero Image 1" 
            width="600"
            height="800"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
        <div class="relative hidden md:block w-full h-full">
          <img 
            src="{{ 'hero-image-2.png' | asset_url }}" 
            alt="Hero Image 2" 
            width="600"
            height="800"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
        <div class="relative hidden md:block w-full h-full">
          <img 
            src="{{ 'hero-image-3.png' | asset_url }}" 
            alt="Hero Image 3" 
            width="600"
            height="800"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
  </div>
</section>
