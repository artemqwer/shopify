{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Hero Video (mp4 recommended)"
    },
    {
      "type": "header",
      "content": "Mobile Links"
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "Link 1 Text",
      "default": "For sea",
      "info": "Leave empty to use translation"
    },
    {
      "type": "collection",
      "id": "link_1_collection",
      "label": "Link 1 Collection (recommended)"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 Custom URL (optional)",
      "info": "Leave empty to use collection above"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Link 2 Text",
      "default": "Classic",
      "info": "Leave empty to use translation"
    },
    {
      "type": "collection",
      "id": "link_2_collection",
      "label": "Link 2 Collection (recommended)"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 Custom URL (optional)",
      "info": "Leave empty to use collection above"
    },
    {
      "type": "header",
      "content": "Desktop Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image_1",
      "label": "Desktop Image 1"
    },
    {
      "type": "image_picker",
      "id": "desktop_image_2",
      "label": "Desktop Image 2"
    },
    {
      "type": "image_picker",
      "id": "desktop_image_3",
      "label": "Desktop Image 3"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}

<!-- Mobile Video Hero -->
<section class="w-full relative h-[100dvh] block md:hidden">
  <div class="absolute inset-0 w-full h-full overflow-hidden bg-black/10">
    {% if section.settings.mobile_video != blank %}
      {{ section.settings.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: 'master', class: 'w-full h-full object-cover', id: 'hero-video-el' }}
    {% else %}
      <div class="w-full h-full flex items-center justify-center bg-gray-200">
        <p class="text-gray-500 font-medium">Please upload a video in Theme Settings</p>
      </div>
    {% endif %}
  </div>

  <div class="absolute inset-x-0 bottom-[12px] flex justify-center items-center gap-12 z-20">
    {% liquid
      assign link_1_href = section.settings.link_1_url
      if link_1_href == blank and section.settings.link_1_collection != blank
        assign link_1_href = section.settings.link_1_collection.url
      elsif link_1_href == blank
        assign link_1_href = routes.all_products_collection_url
      endif

      assign link_2_href = section.settings.link_2_url
      if link_2_href == blank and section.settings.link_2_collection != blank
        assign link_2_href = section.settings.link_2_collection.url
      elsif link_2_href == blank
        assign link_2_href = routes.all_products_collection_url
      endif
    %}
    <a href="{{ link_1_href }}" class="text-white opacity-90 border-b border-white transition-all text-center" style="font-family: Montserrat, sans-serif; font-weight: 300; font-size: 12px; line-height: 1; letter-spacing: 0.03em; text-transform: none;">
      {{ 'hero.for_sea' | t }}
    </a>
    <a href="{{ link_2_href }}" class="text-white opacity-90 border-b border-white transition-all text-center" style="font-family: Montserrat, sans-serif; font-weight: 300; font-size: 12px; line-height: 1; letter-spacing: 0.03em; text-transform: none;">
      {{ 'hero.classic' | t }}
    </a>
  </div>
</section>

<!-- Desktop Image Grid Hero -->
<section class="hidden md:block w-full mb-[32px] md:mb-0 md:mt-0">
  <div class="w-full">
    <div class="hidden md:flex flex-row w-full aspect-auto md:h-[500px] xl:h-[600px] 2xl:h-[700px] overflow-hidden">
        <div class="relative flex-1 h-full z-10 bg-gray-100">
          {% if section.settings.desktop_image_1 != blank %}
            <img src="{{ section.settings.desktop_image_1 | image_url: width: 800 }}" alt="{{ section.settings.desktop_image_1.alt | escape }}" width="600" height="800" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
          {% else %}
            <img src="{{ 'hero-image-1.png' | asset_url }}" alt="Hero Image 1" width="600" height="800" class="absolute inset-0 w-full h-full object-cover" />
          {% endif %}
        </div>
        <div class="relative flex-1 h-full z-0 -ml-[3px] bg-gray-100">
          {% if section.settings.desktop_image_2 != blank %}
            <img src="{{ section.settings.desktop_image_2 | image_url: width: 800 }}" alt="{{ section.settings.desktop_image_2.alt | escape }}" width="600" height="800" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
          {% else %}
            <img src="{{ 'hero-image-2.png' | asset_url }}" alt="Hero Image 2" width="600" height="800" class="absolute inset-0 w-full h-full object-cover" />
          {% endif %}
        </div>
        <div class="relative flex-1 h-full z-10 -ml-[3px] bg-gray-100">
          {% if section.settings.desktop_image_3 != blank %}
            <img src="{{ section.settings.desktop_image_3 | image_url: width: 800 }}" alt="{{ section.settings.desktop_image_3.alt | escape }}" width="600" height="800" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
          {% else %}
            <img src="{{ 'hero-image-3.png' | asset_url }}" alt="Hero Image 3" width="600" height="800" class="absolute inset-0 w-full h-full object-cover" />
          {% endif %}
        </div>
    </div>
    {% comment %} Mobile Fallback (Grid 1 column) {% endcomment %}
    <div class="grid grid-cols-1 md:hidden w-full aspect-[390/500] bg-gray-100">
        <div class="relative w-full h-full bg-gray-100">
           {% if section.settings.desktop_image_1 != blank %}
             <img src="{{ section.settings.desktop_image_1 | image_url: width: 800 }}" alt="{{ section.settings.desktop_image_1.alt | escape }}" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
           {% else %}
             <img src="{{ 'hero-image-1.png' | asset_url }}" alt="Hero Image 1" class="absolute inset-0 w-full h-full object-cover" />
           {% endif %}
        </div>
    </div>
  </div>
</section>
