{% schema %}
{
  "name": "Hero Section",
  "settings": []
}
{% endschema %}

<section class="mb-24 px-4 md:px-12 lg:px-[160px] w-full">
  <div class="grid grid-cols-1 md:grid-cols-[552fr_515fr_533fr] w-full aspect-[390/500] md:h-[640px] overflow-hidden">
        <div class="relative w-full h-full">
          <img 
            src="{{ 'hero-image-1.png' | asset_url }}" 
            alt="Hero Image 1" 
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
        <div class="relative hidden md:block w-full h-full">
          <img 
            src="{{ 'hero-image-2.png' | asset_url }}" 
            alt="Hero Image 2" 
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
        <div class="relative hidden md:block w-full h-full">
          <img 
            src="{{ 'hero-image-3.png' | asset_url }}" 
            alt="Hero Image 3" 
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
  </div>
</section>
