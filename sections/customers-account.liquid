  {% assign t_order_num    = 'הזמנה #' %}
  {% assign t_date         = 'תאריך' %}
  {% assign t_total        = 'סכום' %}
  {% assign t_status       = 'סטטוס' %}
  {% assign t_details      = 'פרטים' %}
