  {% assign t_no_orders    = 'Aucune commande pour le moment' %}
  {% assign t_shop_now     = 'Voir le catalogue' %}
  {% assign t_order_num    = 'Commande #' %}
  {% assign t_date         = 'Date' %}
  {% assign t_total        = 'Total' %}
  {% assign t_status       = 'Statut' %}
  {% assign t_details      = 'Détails' %}
  {% assign t_first        = 'Prénom' %}
  {% assign t_last         = 'Nom' %}
  {% assign t_email        = 'Email' %}
