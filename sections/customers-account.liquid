  {% assign t_save         = 'Enregistrer' %}
{% else %}
  {% assign t_account      = 'My Account' %}
  {% assign t_orders       = 'Orders' %}
  {% assign t_profile      = 'Profile' %}
  {% assign t_logout       = 'Log Out' %}
  {% assign t_no_orders    = 'No orders yet' %}
  {% assign t_shop_now     = 'Browse Catalog' %}
  {% assign t_order_num    = 'Order #' %}
  {% assign t_date         = 'Date' %}
  {% assign t_total        = 'Total' %}
  {% assign t_status       = 'Status' %}
  {% assign t_details      = 'Details' %}
