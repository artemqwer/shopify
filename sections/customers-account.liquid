<style>
  .dash-wrap {
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 16px 80px;
  }
  /* Header */
  .dash-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid #e5e5e5;
  }
  .dash-header h1 {
    font-size: 30px;
    font-weight: 300;
    letter-spacing: 0.05em;
    color: #222;
    margin: 0;
  }
  .dash-logout {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    padding-bottom: 1px;
  }
  .dash-logout:hover { color: #e61a7a; border-color: #e61a7a; }

  /* Tabs */
  .dash-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 36px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .dash-tab {
    padding: 14px 28px;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    background: none;
    border-top: none; border-left: none; border-right: none;
    outline: none;
    transition: color 0.2s;
    font-family: inherit;
  }
  .dash-tab:hover { color: #222; }
  .dash-tab.active { color: #e61a7a; border-bottom-color: #e61a7a; font-weight: 600; }

  /* Panels */
  .dash-panel { display: none; }
  .dash-panel.active { display: block; }

  /* Orders table */
  .orders-table { width: 100%; border-collapse: collapse; }
  .orders-table th {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #aaa;
    text-align: left;
    padding: 0 0 12px;
    font-weight: 500;
    border-bottom: 1px solid #f0f0f0;
  }
  .orders-table td {
    padding: 20px 0;
    font-size: 13px;
    color: #444;
    border-bottom: 1px solid #f7f7f7;
    vertical-align: middle;
  }
  .order-badge {
    display: inline-block;
    font-size: 10px;
    padding: 3px 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    border-radius: 20px;
  }
  .order-badge.fulfilled, .order-badge.paid    { background:#f0fff4; color:#2d7a2d; }
  .order-badge.unfulfilled, .order-badge.pending { background:#fff8e7; color:#b07e00; }
  .order-badge.cancelled, .order-badge.refunded  { background:#fff0f0; color:#c0134e; }
  .orders-table a { color: #222; font-size: 12px; text-decoration: underline; transition: color 0.2s; }
  .orders-table a:hover { color: #e61a7a; }

  /* Empty state */
  .dash-empty {
    text-align: center;
    padding: 64px 20px;
  }
  .dash-empty svg { width: 56px; height: 56px; color: #ddd; margin: 0 auto 20px; display: block; }
  .dash-empty p { font-size: 14px; color: #aaa; margin-bottom: 24px; }
  .dash-empty a {
    display: inline-block;
    padding: 14px 32px;
    background: #222;
    color: #fff;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s;
  }
  .dash-empty a:hover { background: #e61a7a; }

  /* Profile form */
  .profile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
  @media (max-width: 600px) { .profile-grid { grid-template-columns: 1fr; } }
  .prof-field { margin-bottom: 24px; }
  .prof-label {
    display: block;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 6px;
  }
  .prof-input {
    width: 100%;
    border: none;
    border-bottom: 1px solid #d1d1d1;
    padding: 10px 0;
    font-size: 14px;
    color: #222;
    background: transparent;
    outline: none;
    transition: border-color 0.2s;
    font-family: inherit;
  }
  .prof-input:focus { border-color: #e61a7a; }
  .prof-input:disabled { color: #bbb; cursor: not-allowed; }
  .prof-save {
    background: #222;
    color: #fff;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 14px 36px;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 8px;
    font-family: inherit;
  }
  .prof-save:hover { background: #e61a7a; }
  .prof-section-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #222;
    margin: 36px 0 20px;
    padding-top: 28px;
    border-top: 1px solid #f0f0f0;
  }

  @media (max-width: 640px) {
    .dash-header h1 { font-size: 22px; }
    .dash-tab { padding: 12px 16px; font-size: 10px; }
    .orders-table th:nth-child(3),
    .orders-table td:nth-child(3) { display: none; }
  }
</style>

<div class="dash-wrap" dir="{{ dir }}">

  <!-- Header -->
  <div class="dash-header">
    <h1>{{ t_account }}</h1>
    <a href="{{ routes.account_logout_url }}" class="dash-logout">{{ t_logout }}</a>
  </div>

  <!-- Tabs -->
  <div class="dash-tabs">
    <button class="dash-tab active" data-tab="orders">{{ t_orders }}</button>
    <button class="dash-tab" data-tab="profile">{{ t_profile }}</button>
  </div>

  <!-- ORDERS PANEL -->
  <div class="dash-panel active" id="tab-orders">
    {% if customer.orders.size > 0 %}
      <table class="orders-table">
        <thead>
          <tr>
            <th>{{ t_order_num }}</th>
            <th>{{ t_date }}</th>
            <th>{{ t_total }}</th>
            <th>{{ t_status }}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for order in customer.orders %}
            <tr>
              <td><strong>{{ t_order_num }}{{ order.order_number }}</strong></td>
              <td>{{ order.created_at | date: '%d.%m.%Y' }}</td>
              <td>{{ order.total_price | money }}</td>
              <td>
                {% assign badge = order.financial_status | downcase %}
                <span class="order-badge {{ badge }}">{{ order.financial_status }}</span>
              </td>
              <td>
                <a href="{{ order.customer_url }}">{{ t_details }} →</a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="dash-empty">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <p>{{ t_no_orders }}</p>
        <a href="{{ routes.all_products_collection_url }}">{{ t_shop_now }}</a>
      </div>
    {% endif %}
  </div>

  <!-- PROFILE PANEL -->
  <div class="dash-panel" id="tab-profile">
    {% form 'customer' %}
      <div class="profile-grid">
        <div class="prof-field">
          <label class="prof-label" for="p-first">{{ t_first }}</label>
          <input type="text" id="p-first" name="customer[first_name]" class="prof-input"
                 value="{{ customer.first_name }}" autocomplete="given-name">
        </div>
        <div class="prof-field">
          <label class="prof-label" for="p-last">{{ t_last }}</label>
          <input type="text" id="p-last" name="customer[last_name]" class="prof-input"
                 value="{{ customer.last_name }}" autocomplete="family-name">
        </div>
        <div class="prof-field">
          <label class="prof-label" for="p-email">{{ t_email }}</label>
          <input type="email" id="p-email" name="customer[email]" class="prof-input"
                 value="{{ customer.email }}" autocomplete="email" disabled>
        </div>
        <div class="prof-field">
          <label class="prof-label" for="p-phone">{{ t_phone }}</label>
          <input type="tel" id="p-phone" name="customer[phone]" class="prof-input"
                 value="{{ customer.phone }}" autocomplete="tel">
        </div>
      </div>
      <button type="submit" class="prof-save">{{ t_save }}</button>
    {% endform %}
  </div>

</div>

<script>
document.querySelectorAll('.dash-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    var id = this.dataset.tab;
    document.querySelectorAll('.dash-tab').forEach(function(t) { t.classList.remove('active'); });
    document.querySelectorAll('.dash-panel').forEach(function(p) { p.classList.remove('active'); });
    this.classList.add('active');
    var panel = document.getElementById('tab-' + id);
    if (panel) panel.classList.add('active');
  });
});
</script>
