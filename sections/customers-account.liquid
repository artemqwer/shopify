  {% assign t_orders       = 'Замовлення' %}
  {% assign t_profile      = 'Профіль' %}
  {% assign t_logout       = 'Вийти' %}
  {% assign t_no_orders    = 'Замовлень ще немає' %}
  {% assign t_shop_now     = 'Перейти до каталогу' %}
  {% assign t_order_num    = 'Замовлення №' %}
  {% assign t_date         = 'Дата' %}
  {% assign t_total        = 'Сума' %}
  {% assign t_status       = 'Статус' %}
  {% assign t_details      = 'Деталі' %}
  {% assign t_first        = "Ім'я" %}
  {% assign t_last         = 'Прізвище' %}
  {% assign t_email        = 'Email' %}
  {% assign t_phone        = 'Телефон' %}
  {% assign t_save         = 'Зберегти зміни' %}
{% elsif request.locale.iso_code == 'fr' %}
  {% assign t_account      = 'Mon compte' %}
  {% assign t_orders       = 'Commandes' %}
  {% assign t_profile      = 'Profil' %}
