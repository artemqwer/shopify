{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}

<header class="sticky top-0 w-full z-50 bg-white border-b-2 border-[#F5F5F5] transition-all duration-300 shadow-sm">
  <div class="w-full max-w-[1920px] mx-auto px-4 md:px-[160px]">
    <div class="flex justify-between items-center h-[60px] md:h-[102px]">

      <!-- Mobile Header Left: Hamburger Menu -->
      <div class="md:hidden flex-1 flex items-center">
        <button type="button" class="text-gray-900" aria-label="Menu" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
           </svg>
        </button>
      </div>

      <!-- Desktop Left Navigation -->
      <nav class="hidden md:flex items-center flex-1 space-x-12 rtl:space-x-reverse">
        <a href="/" class="text-[14px] font-medium tracking-widest text-gray-900 uppercase hover:text-[#d62873] transition-colors">
          {{ 'header.home' | t }}
        </a>

        <div class="relative group">
          <a href="/collections/all" class="flex items-center text-[14px] font-medium tracking-widest text-gray-900 uppercase hover:text-[#d62873] transition-colors py-8">
            {{ 'header.catalog' | t }}
            <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </a>
          <!-- Mega Menu Dropdown -->
          <div class="absolute top-[80%] left-0 rtl:right-0 pt-8 hidden group-hover:block z-50">
            <div class="bg-white border border-gray-100 w-[600px] shadow-lg p-8 grid grid-cols-4 gap-6 text-left rtl:text-right">
              <div class="flex flex-col space-y-3">
                <a href="/collections/all" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.all' | t }}</a>
                <a href="/collections/bestsellers" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.bestsellers' | t }}</a>
                <a href="/collections/kepi" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.kepi' | t }}</a>
              </div>
              <div class="flex flex-col space-y-3">
                <a href="/collections/hats" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.hats' | t }}</a>
                <a href="/collections/beretes" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.beretes' | t }}</a>
                <a href="/collections/beanies" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.beanies' | t }}</a>
              </div>
              <div class="flex flex-col space-y-3">
                <a href="/collections/caps" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.caps' | t }}</a>
                <a href="/collections/panamas" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.panamas' | t }}</a>
                <a href="/collections/scarves" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.scarves' | t }}</a>
              </div>
              <div class="flex flex-col space-y-3">
                <a href="/collections/scarfs" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.scarfs' | t }}</a>
                <a href="/collections/headbands" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.headbands' | t }}</a>
                <a href="/collections/sets" class="text-sm text-gray-800 hover:text-[#d62873]">{{ 'header.menu.sets' | t }}</a>
              </div>
            </div>
          </div>
        </div>

        <a href="/popular" class="text-[14px] font-medium tracking-widest text-gray-900 uppercase hover:text-[#d62873] transition-colors">
          {{ 'header.popular' | t }}
        </a>
      </nav>

      <!-- Logo Center -->
      <div class="shrink-0 flex items-center justify-center flex-1 md:flex-none">
        <a href="/" class="flex items-center justify-center">
            <img
              src="{{ 'logo-image.png' | asset_url }}"
              alt="Ester Wugman Logo"
              width="128"
              height="62"
              class="w-[80px] h-auto md:w-[128px] md:h-[62px] object-contain transition-all duration-300"
            />
        </a>
      </div>

      <!-- Header Right: Language, Search, Cart -->
      <div class="flex items-center flex-1 justify-end space-x-10 rtl:space-x-reverse">

        <!-- Language Selector -->
        <div class="hidden md:flex relative group cursor-pointer py-8 text-[14px] font-medium tracking-widest text-gray-900 uppercase hover:text-[#d62873] items-center transition-colors">
          {% if request.locale.iso_code == 'he' %}ЧўЧ‘{% elsif request.locale.iso_code == 'uk' %}UA{% elsif request.locale.iso_code == 'fr' %}FR{% else %}EN{% endif %}
          <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          <div class="absolute top-[80%] right-0 pt-8 z-50 hidden group-hover:flex">
             <div class="bg-white border border-gray-100 shadow-lg flex flex-col py-2 w-24">
               {% form 'localization', class: 'contents' %}
                 <button type="submit" name="locale_code" value="he" class="px-4 py-2 hover:bg-gray-50 text-[13px] tracking-widest transition-colors {% if request.locale.iso_code == 'he' %}text-[#d62873] font-bold{% else %}text-gray-600{% endif %} text-center w-full">ЧўЧ‘</button>
                 <button type="submit" name="locale_code" value="en" class="px-4 py-2 hover:bg-gray-50 text-[13px] tracking-widest transition-colors {% if request.locale.iso_code == 'en' %}text-[#d62873] font-bold{% else %}text-gray-600{% endif %} text-center w-full">ENG</button>
                 <button type="submit" name="locale_code" value="uk" class="px-4 py-2 hover:bg-gray-50 text-[13px] tracking-widest transition-colors {% if request.locale.iso_code == 'uk' %}text-[#d62873] font-bold{% else %}text-gray-600{% endif %} text-center w-full">UA</button>
               {% endform %}
             </div>
          </div>
        </div>

        <!-- Search button -->
        <button type="button" class="text-[14px] font-medium tracking-widest text-gray-900 uppercase hover:text-[#d62873] transition-colors hidden md:block" onclick="window.location='/search'">
          {{ 'header.search' | t }}
        </button>

        <!-- Cart trigger -->
        <button type="button" 
                class="text-[14px] font-medium tracking-widest text-gray-900 uppercase hover:text-[#d62873] transition-colors flex items-center relative" 
                data-drawer-trigger="cart-drawer">
          <span class="hidden md:inline">{{ 'header.cart' | t }}</span>
          <svg class="md:hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="text-[#d62873] ml-1 font-bold">(0)</span>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu (Hidden by default) -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-white border-t border-[#F5F5F5] shadow-lg z-50">
    <nav class="flex flex-col py-4 px-6 text-left rtl:text-right">
      <a href="/" class="py-4 text-[14px] font-medium tracking-widest text-gray-900 uppercase border-b border-[#F5F5F5] hover:text-[#d62873] transition-colors">{{ 'header.home' | t }}</a>
      <a href="/catalog" class="py-4 text-[14px] font-medium tracking-widest text-gray-900 uppercase border-b border-[#F5F5F5] hover:text-[#d62873] transition-colors">{{ 'header.catalog' | t }}</a>
      <a href="/popular" class="py-4 text-[14px] font-medium tracking-widest text-gray-900 uppercase hover:text-[#d62873] transition-colors">{{ 'header.popular' | t }}</a>
    </nav>
  </div>
</header>
