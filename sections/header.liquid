{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "collection",
      "id": "recommended_collection",
      "label": "Recommended Products Collection",
      "info": "Used in the mobile menu"
    }
  ],
  "blocks": [
    {
      "type": "unpacking_image",
      "name": "Unpacking Media",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ]
}
{% endschema %}

<header
  id="site-header"
  class="fixed top-0 w-full z-50 transition-all duration-300 {% if template.name == 'index' %}bg-transparent header-transparent md:bg-white{% else %}bg-white{% endif %} text-gray-900"
  style="box-shadow: none !important; border: none !important;"
  {% if request.locale.iso_code == 'he' %}dir="rtl"{% endif %}
>
  <div class="w-full max-w-[1280px] mx-auto px-[20px] header-desktop-padding">
    <div class="relative flex justify-between items-center h-[57px] md:h-[102px]">
      <!-- Burger button wrapper -->
      <div id="burger-desktop-remover" class="md:hidden hide-on-desktop flex-1 flex items-center relative z-[70]">
        <button
          type="button"
          class="mobile-menu-toggle header-mobile-icon relative w-6 h-6 focus:outline-none"
          aria-label="Menu"
          onclick="toggleMobileMenu(this)"
        >
          <span
            class="absolute block h-[1px] w-6 bg-current transform transition duration-300 ease-in-out top-1/2 -translate-y-2"
          ></span>
          <span
            class="absolute block h-[1px] w-6 bg-current transform transition duration-300 ease-in-out top-1/2"
          ></span>
          <span
            class="absolute block h-[1px] w-6 bg-current transform transition duration-300 ease-in-out top-1/2 translate-y-2"
          ></span>
        </button>
      </div>

      <!-- Search icon (mobile) - fixed position, stays in place -->
      <button
        type="button"
        class="md:hidden hide-on-desktop header-mobile-icon absolute {% if request.locale.iso_code == 'he' %}right-[36px]{% else %}left-[36px]{% endif %} top-1/2 -translate-y-1/2 z-[70]"
        onclick="window.location='{{ routes.root_url | append: '/search' | replace: '//', '/' }}'"
      >
        <img src="{{ 'Search.svg' | asset_url }}" width="24" height="24" alt="search" class="cart-icon-img">
      </button>
      <style>
        .mobile-menu-toggle.menu-open span:nth-child(1) {
          transform: translateY(0) rotate(45deg);
        }
        .mobile-menu-toggle.menu-open span:nth-child(2) {
          opacity: 0;
        }
        .mobile-menu-toggle.menu-open span:nth-child(3) {
          transform: translateY(0) rotate(-45deg);
        }
        #mobile-menu-backdrop {
          opacity: 0;
          pointer-events: none;
          transition: opacity 0.3s ease;
        }
        #mobile-menu-backdrop.is-open {
          opacity: 1;
          pointer-events: auto;
        }
        #mobile-menu {
          transform: translateY(-12px);
          opacity: 0;
          pointer-events: none;
          transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
        }
        #mobile-menu.is-open {
          transform: translateY(0);
          opacity: 1;
          pointer-events: auto;
        }
        @media (max-width: 767px) {
          #site-header.header-transparent .header-mobile-icon {
            color: white;
          }
          #site-header.header-transparent .cart-icon-img {
            filter: brightness(0) invert(1);
          }
          /* When menu is open, force icons to be dark */
          #mobile-menu.is-open ~ #mobile-menu-backdrop {
            pointer-events: auto;
          }
          body:has(#mobile-menu.is-open) #site-header .cart-icon-img {
            filter: brightness(0) !important;
          }
        }
        .cart-icon-img {
          filter: brightness(0);
          transition: filter 0.3s;
        }
        .mobile-menu-toggle.menu-open span {
          background-color: #111827;
        }
        #site-header {
          box-shadow: none !important;
          border: none !important;
        }
        @media (min-width: 768px) {
          .header-desktop-padding {
            padding-left: 160px !important;
            padding-right: 160px !important;
          }
        }
        /* Force-hide ALL mobile-only elements on desktop */
        @media (min-width: 768px) {
          .hide-on-desktop,
          .md\:hidden {
            display: none !important;
            pointer-events: none !important;
            visibility: hidden !important;
          }
        }
        .scrollbar-hide::-webkit-scrollbar {
          display: none;
        }
        .scrollbar-hide {
          -ms-overflow-style: none;
          scrollbar-width: none;
        }
      </style>

      <!-- Desktop Left Navigation -->
      <nav class="hidden md:flex items-center flex-1 space-x-12 rtl:space-x-reverse">
        <a
          href="{{ routes.root_url }}"
          class="text-[14px] font-normal tracking-widest text-gray-900 uppercase hover:text-[#d62873] transition-colors"
          style="font-family: Montserrat, sans-serif;"
        >
          {{ 'header.home' | t }}
        </a>

        <div class="relative group" id="catalog-nav-group">
          <a
            href="{{ routes.all_products_collection_url }}"
            class="flex items-center text-[14px] font-normal tracking-widest text-gray-900 uppercase hover:text-[#d62873] transition-colors py-8"
            style="font-family: Montserrat, sans-serif;"
          >
            {{ 'header.catalog' | t }}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="ml-1 w-3 h-3"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </a>
          <!-- Mega Menu Dropdown -->
          <div class="absolute top-full left-0 rtl:right-0 pt-0 hidden group-hover:block z-50" id="catalog-mega-menu">
            <div class="pt-4">
              <div class="bg-white border border-gray-100 w-[600px] p-8 grid grid-cols-4 gap-6 text-left rtl:text-right shadow-xl">
              <div class="flex flex-col space-y-3">
                <a href="{{ routes.all_products_collection_url }}" class="text-sm text-gray-800 hover:text-[#d62873]">
                  {{- 'header.menu.all' | t -}}
                </a>
                <a
                  href="{{ routes.root_url | append: '/collections/bestsellers' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.bestsellers' | t -}}
                </a>
                <a
                  href="{{ routes.root_url | append: '/collections/kepi' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.kepi' | t -}}
                </a>
              </div>
              <div class="flex flex-col space-y-3">
                <a
                  href="{{ routes.root_url | append: '/collections/hats' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.hats' | t -}}
                </a>
                <a
                  href="{{ routes.root_url | append: '/collections/beretes' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.beretes' | t -}}
                </a>
                <a
                  href="{{ routes.root_url | append: '/collections/beanies' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.beanies' | t -}}
                </a>
              </div>
              <div class="flex flex-col space-y-3">
                <a
                  href="{{ routes.root_url | append: '/collections/caps' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.caps' | t -}}
                </a>
                <a
                  href="{{ routes.root_url | append: '/collections/panamas' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.panamas' | t -}}
                </a>
                <a
                  href="{{ routes.root_url | append: '/collections/scarves' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.scarves' | t -}}
                </a>
              </div>
              <div class="flex flex-col space-y-3">
                <a
                  href="{{ routes.root_url | append: '/collections/scarfs' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.scarfs' | t -}}
                </a>
                <a
                  href="{{ routes.root_url | append: '/collections/headbands' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.headbands' | t -}}
                </a>
                <a
                  href="{{ routes.root_url | append: '/collections/sets' | replace: '//', '/' }}"
                  class="text-sm text-gray-800 hover:text-[#d62873]"
                >
                  {{- 'header.menu.sets' | t -}}
                </a>
              </div>
              </div>
            </div>
          </div>
        </div>

        <a
          href="{{ routes.search_url }}?view=popular"
          class="
            text-[14px] font-normal tracking-widest uppercase transition-colors
            {% if template.suffix == 'popular' or request.query_string contains 'view=popular' %}text-[#e61a7a]{% else %}text-gray-900 hover:text-[#e61a7a]{% endif %}
          "
          style="font-family: Montserrat, sans-serif;"
        >
          {{ 'header.popular' | t }}
        </a>
      </nav>

      <!-- Logo Center -->
      <div class="header-logo-container absolute left-1/2 -translate-x-1/2 flex items-center justify-center z-[70]">
        <a href="{{ routes.root_url }}" class="flex items-center justify-center">
          <img
            id="header-logo"
            src="{{ 'logo-image.svg' | asset_url }}"
            alt="Ester Wugman Logo"
            width="128"
            height="62"
            class="w-[80px] h-auto md:w-[128px] md:h-[62px] object-contain transition-all duration-300"
          >
        </a>
      </div>

      <!-- Header Right: Language, Search, Cart -->
      <div class="flex items-center flex-1 justify-end space-x-[12px] md:space-x-10 rtl:space-x-reverse">
        <!-- Language Selector (Desktop) -->
        <div class="hidden md:block relative" id="lang-switcher-desktop">
          <!-- Trigger button: shows current locale label + caret -->
          <button
            type="button"
            id="lang-btn-desktop"
            onclick="toggleLangMenu()"
            aria-expanded="false"
            class="flex items-center gap-[5px] text-[13px] font-normal tracking-widest text-gray-900 uppercase hover:text-[#e61a7a] transition-colors py-8 select-none"
            style="font-family: Montserrat, sans-serif;"
          >
            {% if request.locale.iso_code == 'he' -%}
              עב
            {% elsif request.locale.iso_code == 'uk' -%}
              UA
            {% elsif request.locale.iso_code == 'fr' -%}
              FR
            {% else -%}
              ENG
            {%- endif %}
            <svg
              id="lang-caret"
              xmlns="http://www.w3.org/2000/svg"
              class="w-[10px] h-[10px] transition-transform duration-200"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>

          <!-- Dropdown: vertical list exactly like reference -->
          <div
            id="lang-menu-desktop"
            class="hidden absolute top-full right-0 bg-white border border-gray-100 z-50 py-5 px-7 min-w-[88px]"
          >
            {% form 'localization', class: 'flex flex-col gap-[14px]' %}
              <button
                type="submit"
                name="locale_code"
                value="en"
                class="
                  text-left rtl:text-right text-[13px] tracking-widest uppercase font-normal leading-none transition-colors
                  {% if request.locale.iso_code == 'en' %}text-[#e61a7a]{% else %}text-gray-800 hover:text-[#e61a7a]{% endif %}
                "
              >
                ENG
              </button>
              <button
                type="submit"
                name="locale_code"
                value="uk"
                class="
                  text-left rtl:text-right text-[13px] tracking-widest uppercase font-normal leading-none transition-colors
                  {% if request.locale.iso_code == 'uk' %}text-[#e61a7a]{% else %}text-gray-800 hover:text-[#e61a7a]{% endif %}
                "
              >
                UA
              </button>
              <button
                type="submit"
                name="locale_code"
                value="fr"
                class="
                  text-left rtl:text-right text-[13px] tracking-widest uppercase font-normal leading-none transition-colors
                  {% if request.locale.iso_code == 'fr' %}text-[#e61a7a]{% else %}text-gray-800 hover:text-[#e61a7a]{% endif %}
                "
              >
                FR
              </button>
              <button
                type="submit"
                name="locale_code"
                value="he"
                class="
                  text-left text-[15px] font-normal leading-none transition-colors
                  {% if request.locale.iso_code == 'he' %}text-[#e61a7a]{% else %}text-gray-800 hover:text-[#e61a7a]{% endif %}
                "
              >
                עב
              </button>
            {% endform %}
          </div>
        </div>

        <!-- Account button (desktop text) -->
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="text-[14px] font-normal tracking-widest text-gray-900 uppercase hover:text-gray-500 transition-colors hidden md:block"
          style="font-family: Montserrat, sans-serif;"
        >
          {{ 'header.account' | t }}
        </a>

        <!-- Account icon (mobile only) -->
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="md:hidden header-mobile-icon relative z-[70] flex items-center justify-center mr-3 mt-[2px]"
        >
          <svg class="text-gray-900" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </a>

        <!-- Cart trigger -->
        <button
          type="button"
          class="header-mobile-icon text-[14px] font-normal tracking-widest text-gray-900 uppercase hover:text-[#d62873] transition-colors flex items-center relative z-[70]"
          style="font-family: Montserrat, sans-serif;"
          data-drawer-trigger="cart-drawer"
        >
          <span class="hidden md:inline">{{ 'header.cart' | t }}</span>
          <span class="text-[#d62873] ml-1 font-bold hidden md:inline"
            >(<span data-cart-count>{{ cart.item_count | default: 0 }}</span>)</span
          >
          <!-- Mobile: bag icon with badge -->
          <span class="md:hidden relative inline-flex items-center justify-center">
            <img src="{{ 'cart.svg' | asset_url }}" width="18" height="24" alt="cart" class="cart-icon-img">
            <span
              data-cart-count-mobile
              class="absolute top-0 -right-[10px] text-[#e61a7a] text-[12px] font-light leading-none tabular-nums"
            >
              {{ cart.item_count | default: 0 }}
            </span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Backdrop -->
  <div id="mobile-menu-backdrop" class="md:hidden hide-on-desktop fixed inset-0 z-40" onclick="closeMobileMenu()"></div>

  <!-- Mobile Menu (full screen overlay) -->
  <div
    id="mobile-menu"
    class="md:hidden hide-on-desktop fixed inset-0 bg-white z-[55] overflow-y-auto"
    {% if request.locale.iso_code == 'he' %}
      dir="rtl"
    {% endif %}
  >
    <!-- Spacing for fixed header -->
    <div class="h-[60px]"></div>

    <!-- Recommended products -->
    <div class="{% if request.locale.iso_code == 'he' %}pr-[32px] pl-[20px]{% else %}pl-[32px] pr-[20px]{% endif %} mb-6">
      <button
        type="button"
        class="flex items-center justify-between w-full text-left mb-3"
        onclick="toggleMobileSection('recommended')"
      >
        <span class="text-[16px] font-normal" style="font-family: Montserrat, sans-serif;">{{ 'header.recommended_products' | t }}</span>
        <svg id="recommended-caret" class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 10 6">
          <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
        </svg>
      </button>
      <div id="recommended-section" class="flex space-x-3 rtl:space-x-reverse overflow-x-auto scrollbar-hide {% if request.locale.iso_code == 'he' %}-ml-[20px] pr-[32px] pl-0{% else %}-mr-[20px] pl-[32px] pr-0{% endif %} snap-x snap-mandatory w-full">
        {% if section.settings.recommended_collection != blank %}
          {% for product in section.settings.recommended_collection.products limit: 3 %}
            <a href="{{ product.url }}" class="flex-shrink-0 w-[calc(50vw-22px)] block snap-start">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="w-full h-[203px] object-cover"/>
              <p class="text-[11px] mt-1" style="font-family: Montserrat, sans-serif;">{{ product.title }}</p>
            </a>
          {% endfor %}
        {% else %}
          <a href="{{ routes.search_url }}?view=demo&product=leopard-print-scarf" class="flex-shrink-0 w-[calc(50vw-22px)] block snap-start">
            <img src="{{ 'product-image-1.png' | asset_url }}" alt="Product" class="w-full h-[203px] object-cover"/>
            <p class="text-[11px] mt-1" style="font-family: Montserrat, sans-serif;">{{ 'products.product_1' | t }}</p>
          </a>
          <a href="{{ routes.search_url }}?view=demo&product=vintage-scarf" class="flex-shrink-0 w-[calc(50vw-22px)] block snap-start">
            <img src="{{ 'product-image-4.png' | asset_url }}" alt="Product" class="w-full h-[203px] object-cover"/>
            <p class="text-[11px] mt-1" style="font-family: Montserrat, sans-serif;">{{ 'products.product_4' | t }}</p>
          </a>
          <a href="{{ routes.search_url }}?view=demo&product=pink-scarf" class="flex-shrink-0 w-[calc(50vw-22px)] block snap-start">
            <img src="{{ 'product-image-3.png' | asset_url }}" alt="Product" class="w-full h-[203px] object-cover"/>
            <p class="text-[11px] mt-1" style="font-family: Montserrat, sans-serif;">{{ 'products.product_3' | t }}</p>
          </a>
        {% endif %}
        <div class="flex-shrink-0 w-[32px]"></div>
      </div>
    </div>

    <!-- Unpacking section -->
    <div class="{% if request.locale.iso_code == 'he' %}pr-[32px] pl-[20px]{% else %}pl-[32px] pr-[20px]{% endif %} mb-6">
      <button
        type="button"
        class="flex items-center justify-between w-full text-left mb-3"
        onclick="toggleMobileSection('unpacking')"
      >
        <span class="text-[16px] font-normal" style="font-family: Montserrat, sans-serif;">{{ 'header.unpacking' | t }}</span>
        <svg id="unpacking-caret" class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 10 6">
          <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
        </svg>
      </button>
      <div id="unpacking-section" class="flex space-x-3 rtl:space-x-reverse overflow-x-auto scrollbar-hide {% if request.locale.iso_code == 'he' %}-ml-[20px] pr-[32px] pl-0{% else %}-mr-[20px] pl-[32px] pr-0{% endif %} snap-x snap-mandatory w-full">
        {% assign unpacking_blocks = section.blocks | where: 'type', 'unpacking_image' %}
        {% if unpacking_blocks.size > 0 %}
          {% for block in unpacking_blocks %}
            <div class="flex-shrink-0 w-[calc(50vw-22px)] block snap-start" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Unpacking" class="w-full h-[203px] object-cover"/>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <div class="flex-shrink-0 w-[calc(50vw-22px)] block snap-start">
            <img src="{{ 'IMG_9734 1(2).png' | asset_url }}" alt="Unpacking" class="w-full h-[203px] object-cover"/>
          </div>
          <div class="flex-shrink-0 w-[calc(50vw-22px)] block snap-start">
            <img src="{{ 'IMG_9734 1.svg' | asset_url }}" alt="Unpacking" class="w-full h-[203px] object-cover"/>
          </div>
          <div class="flex-shrink-0 w-[calc(50vw-22px)] block snap-start">
            <img src="{{ 'IMG_9734 1(1).svg' | asset_url }}" alt="Unpacking" class="w-full h-[203px] object-cover"/>
          </div>
        {% endif %}
        <div class="flex-shrink-0 w-[32px]"></div>
      </div>
    </div>

    <nav
      class="flex flex-col pl-[32px] pr-5 pt-6 pb-10 gap-[20px] {% if request.locale.iso_code == 'he' %}items-start text-right{% else %}items-start text-left{% endif %}"
      style="font-family: Montserrat, sans-serif;"
    >
      <a
        href="{{ routes.all_products_collection_url }}"
        class="text-[20px] font-light text-gray-900 leading-none tracking-[0.05em] hover:text-[#d62873] transition-colors"
      >
        {{- 'header.catalog' | t -}}
      </a>
      <a
        href="{{ routes.root_url }}"
        class="text-[20px] font-light text-gray-900 leading-none tracking-[0.05em] hover:text-[#d62873] transition-colors"
      >
        {{- 'header.home' | t -}}
      </a>
      <a
        href="{{ routes.root_url | append: '/pages/about-us' | replace: '//', '/' }}"
        class="text-[20px] font-light text-gray-900 leading-none tracking-[0.05em] hover:text-[#d62873] transition-colors"
      >
        {{- 'footer.about' | t -}}
      </a>
      <a
        href="{{ routes.root_url | append: '/pages/returns' | replace: '//', '/' }}"
        class="text-[20px] font-light text-gray-900 leading-none tracking-[0.05em] hover:text-[#d62873] transition-colors"
      >
        {{- 'footer.public_offer' | t -}}
      </a>
      <a
        href="{{ routes.root_url | append: '/pages/contacts' | replace: '//', '/' }}"
        class="text-[20px] font-light text-gray-900 leading-none tracking-[0.05em] hover:text-[#d62873] transition-colors"
      >
        {{- 'footer.privacy' | t -}}
      </a>
      <a
        href="{{ routes.root_url | append: '/pages/shipping' | replace: '//', '/' }}"
        class="text-[20px] font-light text-gray-900 leading-none tracking-[0.05em] hover:text-[#d62873] transition-colors"
      >
        {{- 'footer.shipping' | t -}}
      </a>

      <!-- Language Selector -->
      <div class="mt-0">
        {% form 'localization', class: 'flex flex-col items-start gap-[20px]' %}
          <button
            type="button"
            onclick="(function(){var list=document.getElementById('mobile-menu-lang-list');var caret=document.getElementById('mobile-lang-caret');var isOpen=!list.classList.contains('hidden');list.classList.toggle('hidden',isOpen);caret.style.transform=isOpen?'':'rotate(180deg)';})()"
            class="flex items-center justify-between w-[68px] h-[24px] text-[20px] font-light text-[#e61a7a] focus:outline-none leading-none tracking-[0.05em]"
          >
            {% case request.locale.iso_code %}
              {% when 'en' -%}
                ENG
              {% when 'uk' -%}
                UA
              {% when 'fr' -%}
                FR
              {% when 'he' -%}
                עב
            {% endcase %}
            <svg
              id="mobile-lang-caret"
              class="w-3 h-3 transition-transform duration-200"
              fill="none"
              viewBox="0 0 10 6"
            >
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div id="mobile-menu-lang-list" class="flex flex-col items-start gap-[20px] hidden">
            {% if request.locale.iso_code != 'uk' %}
              <button
                type="submit"
                name="locale_code"
                value="uk"
                class="text-[20px] font-light text-gray-900 hover:text-[#e61a7a] transition-colors leading-none tracking-[0.05em]"
              >
                UA
              </button>
            {% endif %}
            {% if request.locale.iso_code != 'en' %}
              <button
                type="submit"
                name="locale_code"
                value="en"
                class="text-[20px] font-light text-gray-900 hover:text-[#e61a7a] transition-colors leading-none tracking-[0.05em]"
              >
                ENG
              </button>
            {% endif %}
            {% if request.locale.iso_code != 'fr' %}
              <button
                type="submit"
                name="locale_code"
                value="fr"
                class="text-[20px] font-light text-gray-900 hover:text-[#e61a7a] transition-colors leading-none tracking-[0.05em]"
              >
                FR
              </button>
            {% endif %}
            {% if request.locale.iso_code != 'he' %}
              <button
                type="submit"
                name="locale_code"
                value="he"
                class="text-[20px] font-light text-gray-900 hover:text-[#e61a7a] transition-colors leading-none tracking-[0.05em]"
              >
                עב
              </button>
            {% endif %}
          </div>
        {% endform %}
      </div>
    </nav>
  </div>
</header>

<script>
  (function() {
    function toggleLangMenu() {
      var menu  = document.getElementById('lang-menu-desktop');
      var caret = document.getElementById('lang-caret');
      var btn   = document.getElementById('lang-btn-desktop');
      if (!menu) return;
      var isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      if (caret) caret.style.transform = isOpen ? '' : 'rotate(180deg)';
      if (btn)   btn.setAttribute('aria-expanded', String(!isOpen));
    }
    window.toggleLangMenu = toggleLangMenu;

    // Close on outside click for language switcher
    document.addEventListener('click', function(e) {
      var switcher = document.getElementById('lang-switcher-desktop');
      if (switcher && !switcher.contains(e.target)) {
        var menu  = document.getElementById('lang-menu-desktop');
        var caret = document.getElementById('lang-caret');
        if (menu && !menu.classList.contains('hidden')) {
          menu.classList.add('hidden');
          if (caret) caret.style.transform = '';
        }
      }
    });

    // Mobile section toggles
    function toggleMobileSection(sectionName) {
      const section = document.getElementById(sectionName + '-section');
      const caret = document.getElementById(sectionName + '-caret');
      if (!section || !caret) return;
      const isOpen = !section.classList.contains('hidden');
      section.classList.toggle('hidden', isOpen);
      caret.style.transform = isOpen ? '' : 'rotate(180deg)';
    }
    window.toggleMobileSection = toggleMobileSection;

    // Mobile Menu Toggle logic
    function toggleMobileMenu(btn) {
      const menu = document.getElementById('mobile-menu');
      const backdrop = document.getElementById('mobile-menu-backdrop');
      const header = document.getElementById('site-header');
      const isOpen = menu.classList.contains('is-open');
      if (isOpen) {
        closeMobileMenu();
      } else {
        btn.classList.add('menu-open');
        menu.classList.add('is-open');
        backdrop.classList.add('is-open');
        header.classList.add('menu-is-open');
        header.classList.remove('header-transparent');
        header.classList.add('bg-white');
        document.body.style.overflow = 'hidden';
      }
    }
    function closeMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const backdrop = document.getElementById('mobile-menu-backdrop');
      const header = document.getElementById('site-header');
      const btn = document.querySelector('.mobile-menu-toggle');
      if (btn) {
        btn.classList.remove('menu-open');
      }
      menu.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      header.classList.remove('menu-is-open');
      document.body.style.overflow = '';
      // Restore transparent header on index if scrolled to top
      {% if template.name == 'index' %}
      if (window.scrollY <= 50 && window.innerWidth < 768) {
        header.classList.add('header-transparent');
        header.classList.remove('bg-white');
      }
      {% endif %}
    }
    window.toggleMobileMenu = toggleMobileMenu;
    window.closeMobileMenu = closeMobileMenu;

    {% if template.name == 'index' %}
      const header = document.getElementById('site-header');
      window.addEventListener('scroll', function() {
        if (window.innerWidth >= 768) return; // desktop is always solid
        if (window.scrollY > 50) {
          header.classList.remove('bg-transparent', 'header-transparent');
          header.classList.add('bg-white', 'border-none');
        } else {
          header.classList.add('bg-transparent', 'header-transparent');
          header.classList.remove('bg-white', 'border-none');
        }
      });
    {% endif %}

  })();
</script>
