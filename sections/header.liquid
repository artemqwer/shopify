{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}

<header class="sticky top-0 w-full z-50 bg-white border-b-2 border-[#F5F5F5] transition-all duration-300 shadow-sm" x-data="{ mobileMenuOpen: false }">
  <div class="w-full max-w-[1920px] mx-auto px-4 md:px-12 lg:px-[160px]">
    <div class="flex justify-between items-center py-4 md:py-5">
      
      <!-- Mobile Header Left: Hamburger Menu -->
      <div class="md:hidden flex-1 flex items-center">
        <button class="text-gray-900" aria-label="Menu" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
           </svg>
        </button>
      </div>

      <!-- Desktop Left Navigation -->
      <nav class="hidden md:flex space-x-12 items-center flex-1">
        <a href="/" class="text-xs font-medium tracking-widest text-gray-900 uppercase hover:text-gray-500 transition-colors">
          Home
        </a>
        
        <div class="relative group">
          <a href="/catalog" class="flex items-center text-xs font-medium tracking-widest text-gray-900 uppercase hover:text-gray-500 transition-colors py-8">
            Catalog <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </a>
          <!-- Mega Menu Dropdown -->
          <div class="absolute top-16 left-0 pt-4 hidden group-hover:block z-50">
            <div class="bg-white border-t border-[#F5F5F5] shadow-lg w-max min-w-[200px] flex flex-col items-start px-8 py-6 gap-4">
              <a href="/catalog/silk" class="text-xs uppercase font-medium tracking-widest text-gray-900 hover:text-gray-500 transition-colors">Silk Scarves</a>
              <a href="/catalog/cotton" class="text-xs uppercase font-medium tracking-widest text-gray-900 hover:text-gray-500 transition-colors">Cotton Scarves</a>
              <a href="/catalog/linen" class="text-xs uppercase font-medium tracking-widest text-gray-900 hover:text-gray-500 transition-colors">Linen Scarves</a>
              <a href="/catalog/accessories" class="text-xs uppercase font-medium tracking-widest text-gray-900 hover:text-gray-500 transition-colors">Accessories</a>
              <a href="/catalog/all" class="text-xs uppercase font-medium tracking-widest pl-4 text-pink-500 hover:text-pink-600 transition-colors mt-2">View All Categories</a>
            </div>
          </div>
        </div>

        <a href="/popular" class="text-xs font-medium tracking-widest text-gray-900 uppercase hover:text-gray-500 transition-colors">
          Popular
        </a>
      </nav>

      <!-- Logo Center -->
      <div class="shrink-0 flex items-center justify-center flex-1 md:flex-none">
        <a href="/" class="flex items-center justify-center">
            <img 
              src="{{ 'logo-image.png' | asset_url }}" 
              alt="Ester Wugman Logo" 
              width="148"
              height="140"
              class="w-[80px] md:w-[148px] h-auto object-contain transition-all duration-300"
            />
        </a>
      </div>

      <!-- Mobile Header Right: Cart Icon -->
      <div class="md:hidden flex-1 flex items-center justify-end">
         <button class="text-gray-900 relative">
           <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
           </svg>
        </button>
      </div>

      <!-- Desktop Right Navigation -->
      <div class="hidden md:flex space-x-10 items-center justify-end flex-1">
        <div class="relative group cursor-pointer py-8 text-xs font-medium tracking-widest text-gray-900 uppercase hover:text-gray-500 flex items-center transition-colors">
          EN <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </div>

        <button class="text-xs font-medium tracking-widest text-gray-900 uppercase hover:text-gray-500 transition-colors flex items-center">
          Search
        </button>

        <button class="text-xs font-medium tracking-widest text-gray-900 uppercase hover:text-gray-500 transition-colors flex items-center">
          Cart <span class="text-pink-500 ml-1">(0)</span>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu (Hidden by default) -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-white border-t border-[#F5F5F5] shadow-lg">
    <nav class="flex flex-col py-4 px-4">
      <a href="/" class="py-3 text-sm font-medium tracking-[0.1em] text-gray-900 uppercase border-b border-[#F5F5F5]">Home</a>
      <a href="/catalog" class="py-3 text-sm font-medium tracking-[0.1em] text-gray-900 uppercase border-b border-[#F5F5F5]">Catalog</a>
      <a href="/popular" class="py-3 text-sm font-medium tracking-[0.1em] text-gray-900 uppercase">Popular</a>
    </nav>
  </div>
</header>
