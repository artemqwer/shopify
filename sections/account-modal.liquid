<!-- Main Account Modal Wrapper (Hidden by default) -->
<div id="main-account-modal" onclick="if(event.target===this) closeAccountModal()" class="fixed inset-0 z-[1000] p-4 bg-black bg-opacity-60" style="display:none; align-items:center; justify-content:center;">

{% if customer %}
  <!-- Modal Content Container for Authenticated User -->
  <div class="account-container relative bg-white w-full max-w-[800px] h-full max-h-[90vh] overflow-y-auto px-4 md:px-8 py-8 md:py-10 shadow-2xl z-10" dir="{{ acc_dir }}">
    
    <!-- Close button for main modal -->
    <button type="button" onclick="closeAccountModal()" class="absolute top-4 right-4 md:top-6 md:right-6 text-[#888] hover:text-[#222] transition-colors" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-8 md:mb-12 pr-6">
      <h1 class="text-[28px] md:text-[38px] font-light text-[#222] tracking-wide">
        {{ txt_account }}
      </h1>
      <a href="{{ routes.account_logout_url }}" class="btn-link hidden md:inline">
        {{ txt_logout }}
      </a>
    </div>

  <!-- Tab Navigation -->
  <div class="account-tabs mb-0">
    <button class="account-tab active" data-tab="orders">{{ txt_orders }}</button>
    <button class="account-tab" data-tab="profile">{{ txt_profile }}</button>
    <a href="{{ routes.account_logout_url }}" class="account-tab md:hidden" style="display:block;">{{ txt_logout }}</a>
  </div>

  <!-- ══════════════════════════════════════
       TAB 1: ORDERS
  ══════════════════════════════════════ -->
  <div class="account-panel active" data-panel="orders">

    {% if customer.orders.size > 0 %}
      <div id="orders-list">
        {% for order in customer.orders %}
          <div class="order-card">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-3">
              <div>
                <h3 class="text-[14px] font-semibold text-[#222] mb-1">{{ txt_order_number }}{{ order.name }}</h3>
                <p class="text-[12px] text-[#888]">{{ txt_date }}: {{ order.created_at | date: "%Y-%m-%d" }}</p>
              </div>
              <span class="order-status {{ order.fulfillment_status | default: 'pending' | downcase }}">{{ order.fulfillment_status_label | default: order.financial_status_label }}</span>
            </div>
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
              <div class="text-[13px] text-[#555]">
                <strong>{{ txt_total }}:</strong> {{ order.total_price | money }}
              </div>
              <a href="{{ order.customer_url }}" class="btn-link text-left md:text-right">
                {{ txt_view_details }}
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <!-- Empty State -->
      <div id="orders-empty" class="empty-state">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <h3>{{ txt_no_orders }}</h3>
        <p>{{ txt_start_shopping }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary">{{ txt_start_shopping }}</a>
      </div>
    {% endif %}

  </div>

  <!-- ══════════════════════════════════════
       TAB 3: PROFILE
  ══════════════════════════════════════ -->
  <div class="account-panel" data-panel="profile">

    <h2 class="text-[20px] font-medium text-[#222] mb-6">{{ txt_profile }}</h2>

    {% form 'customer', id: 'profile-form', class: 'max-w-[600px] space-y-6' %}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="prof-first-name" class="block text-[11px] uppercase tracking-wider text-[#888] mb-1">{{ txt_first_name }}</label>
          <input type="text" id="prof-first-name" name="customer[first_name]" class="acc-input" value="{{ customer.first_name | default: '' }}">
        </div>
        <div>
          <label for="prof-last-name" class="block text-[11px] uppercase tracking-wider text-[#888] mb-1">{{ txt_last_name }}</label>
          <input type="text" id="prof-last-name" name="customer[last_name]" class="acc-input" value="{{ customer.last_name | default: '' }}">
        </div>
      </div>
      <div>
        <label for="prof-email" class="block text-[11px] uppercase tracking-wider text-[#888] mb-1">{{ txt_email }}</label>
        <input type="email" id="prof-email" name="customer[email]" class="acc-input" value="{{ customer.email | default: 'user@example.com' }}">
      </div>
      <div>
        <label for="prof-phone" class="block text-[11px] uppercase tracking-wider text-[#888] mb-1">{{ txt_phone }}</label>
        <input type="tel" id="prof-phone" name="customer[phone]" class="acc-input" value="{{ customer.phone | default: '' }}">
      </div>
      <button type="submit" class="btn-primary">{{ txt_save_changes }}</button>
    {% endform %}

    <hr class="my-10 border-[#e5e5e5]">

    <h3 class="text-[18px] font-medium text-[#222] mb-6">{{ txt_change_password }}</h3>
    {% form 'customer', id: 'password-form', class: 'max-w-[600px] space-y-4' %}
      <input type="hidden" name="form_type" value="change_password">
      <input type="hidden" name="_method" value="put">
      <div>
        <label for="current-password" class="block text-[11px] uppercase tracking-wider text-[#888] mb-1">{{ txt_current_password }}</label>
        <input type="password" name="customer[current_password]" id="current-password" class="acc-input" required>
      </div>
      <div>
        <label for="new-password" class="block text-[11px] uppercase tracking-wider text-[#888] mb-1">{{ txt_new_password }}</label>
        <input type="password" name="customer[password]" id="new-password" class="acc-input" minlength="5" required>
      </div>
      <div>
        <label for="confirm-password" class="block text-[11px] uppercase tracking-wider text-[#888] mb-1">{{ txt_confirm_password }}</label>
        <input type="password" id="confirm-password" class="acc-input" minlength="5" required>
      </div>
      <button type="submit" class="btn-primary">{{ txt_change_password }}</button>
    {% endform %}

  </div>

  </div>
  <!-- End of account-container -->

<script>
(function() {
  'use strict';

  // ══════════════════════════════════════
  // TAB SWITCHING
  // ══════════════════════════════════════
  const tabs = document.querySelectorAll('.account-tab');
  const panels = document.querySelectorAll('.account-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', function() {
      const targetTab = this.getAttribute('data-tab');

      // Special case: logout on mobile
      if (targetTab === 'logout') {
        window.location.href = '{{ routes.account_logout_url }}';
        return;
      }

      // Switch active tab
      tabs.forEach(t => t.classList.remove('active'));
      this.classList.add('active');

      // Switch active panel
      panels.forEach(p => {
        if (p.getAttribute('data-panel') === targetTab) {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });
    });
  });

  // ══════════════════════════════════════
  // MOCK DATA & STORAGE
  // ══════════════════════════════════════
  const ORDERS_KEY = 'ester_account_orders';
  const ADDRESSES_KEY = 'ester_account_addresses';
  const PROFILE_KEY = 'ester_account_profile';

  function getOrders() {
    try { return JSON.parse(localStorage.getItem(ORDERS_KEY)) || []; } catch(e) { return []; }
  }
  function saveOrders(orders) {
    localStorage.setItem(ORDERS_KEY, JSON.stringify(orders));
  }

  function getAddresses() {
    try { return JSON.parse(localStorage.getItem(ADDRESSES_KEY)) || []; } catch(e) { return []; }
  }
  function saveAddresses(addresses) {
    localStorage.setItem(ADDRESSES_KEY, JSON.stringify(addresses));
  }

  function getProfile() {
    try { return JSON.parse(localStorage.getItem(PROFILE_KEY)) || {}; } catch(e) { return {}; }
  }
  function saveProfile(profile) {
    localStorage.setItem(PROFILE_KEY, JSON.stringify(profile));
  }

  // ══════════════════════════════════════
  // ORDERS TAB
  // ══════════════════════════════════════
  function renderOrders() {
    const orders = getOrders();
    const container = document.getElementById('orders-list');
    const emptyState = document.getElementById('orders-empty');

    if (orders.length === 0) {
      container.innerHTML = '';
      emptyState.style.display = 'block';
      return;
    }

    emptyState.style.display = 'none';
    container.innerHTML = orders.map(order => {
      const statusClass = (order.status || 'pending').toLowerCase();
      return `
        <div class="order-card">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-3">
            <div>
              <h3 class="text-[14px] font-semibold text-[#222] mb-1">{{ txt_order_number }}${order.number}</h3>
              <p class="text-[12px] text-[#888]">{{ txt_date }}: ${order.date}</p>
            </div>
            <span class="order-status ${statusClass}">${order.status}</span>
          </div>
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div class="text-[13px] text-[#555]">
              <strong>{{ txt_total }}:</strong> ${order.total}
            </div>
            <button type="button" onclick="viewOrderDetails('${order.id}')" class="btn-link text-left md:text-right">
              {{ txt_view_details }}
            </button>
          </div>
        </div>
      `;
    }).join('');
  }

  window.viewOrderDetails = function(orderId) {
    alert('Order details for ' + orderId + ' - feature in development');
  };

  // Address tab has been removed

  // ══════════════════════════════════════
  // PROFILE TAB
  // ══════════════════════════════════════
  function loadProfile() {
    const profile = getProfile();
    if (profile.firstName) document.getElementById('prof-first-name').value = profile.firstName;
    if (profile.lastName) document.getElementById('prof-last-name').value = profile.lastName;
    if (profile.email) document.getElementById('prof-email').value = profile.email;
    if (profile.phone) document.getElementById('prof-phone').value = profile.phone;
  }

  document.getElementById('profile-form').addEventListener('submit', function(e) {
    e.preventDefault();
    const profile = {
      firstName: document.getElementById('prof-first-name').value,
      lastName: document.getElementById('prof-last-name').value,
      email: document.getElementById('prof-email').value,
      phone: document.getElementById('prof-phone').value
    };
    saveProfile(profile);
    alert('{{ txt_save_changes }} ✓ (Simulation only)');
  });

  document.getElementById('password-form').addEventListener('submit', function(e) {
    e.preventDefault();
    const current = document.getElementById('current-password').value;
    const newPass = document.getElementById('new-password').value;
    const confirm = document.getElementById('confirm-password').value;

    if (newPass !== confirm) {
      alert('Passwords do not match');
      return;
    }
    if (newPass.length < 6) {
      alert('Password must be at least 6 characters');
      return;
    }

    // In real Shopify: use /account endpoint
    alert('Password changed successfully (simulation only)');
    this.reset();
  });

  // ══════════════════════════════════════
  // UTILITIES
  // ══════════════════════════════════════
  function escHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // ══════════════════════════════════════
  // INIT: Load data
  // ══════════════════════════════════════
  function init() {
    loadProfile();
  }

  init();
})();
</script>
{% endif %}

</div>
<!-- End of #main-account-modal -->

<!-- Global Modal Controls -->
<script>
window.openAccountModal = function() {
  var modal = document.getElementById('main-account-modal');
  if (modal) {
    modal.style.display = 'flex';
    modal.style.alignItems = 'center';
    modal.style.justifyContent = 'center';
    document.body.style.overflow = 'hidden';
  }
};

window.closeAccountModal = function() {
  var modal = document.getElementById('main-account-modal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
};
</script>
