{% schema %}
{
  "name": "Account Page",
  "settings": []
}
{% endschema %}

<style>
  /* Base Account Container */
  .account-container {
    font-family: var(--font-montserrat), Montserrat, sans-serif;
  }

  /* Tab Navigation */
  .account-tabs {
    border-bottom: 1px solid #e5e5e5;
    display: flex;
    gap: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .account-tabs::-webkit-scrollbar { display: none; }

  .account-tab {
    padding: 16px 24px;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #888;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
    background: transparent;
    border-left: none;
    border-right: none;
    border-top: none;
    outline: none;
  }
  .account-tab:hover { color: #222; }
  .account-tab.active {
    color: #222;
    border-bottom-color: #222;
    font-weight: 600;
  }

  /* Tab Content Panels */
  .account-panel {
    display: none;
    padding: 32px 0;
  }
  .account-panel.active { display: block; }

  /* Form Inputs */
  .acc-input, .acc-select {
    width: 100%;
    border: 1px solid #d1d1d1;
    padding: 12px 14px;
    font-size: 13px;
    color: #222;
    background: transparent;
    transition: border-color 0.2s;
    outline: none;
    font-family: inherit;
  }
  .acc-input::placeholder { color: #888; }
  .acc-input:focus, .acc-select:focus { border-color: #222; }
  .acc-input:disabled, .acc-select:disabled {
    background: #f8f8f8;
    color: #999;
    cursor: not-allowed;
  }

  /* Buttons */
  .btn-primary {
    background: #222;
    color: #fff;
    font-size: 12px;
    letter-spacing: 0.12em;
    font-weight: 600;
    padding: 14px 32px;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    text-transform: uppercase;
    display: inline-block;
  }
  .btn-primary:hover { background: #000; }
  .btn-primary:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  .btn-secondary {
    background: transparent;
    color: #222;
    font-size: 12px;
    letter-spacing: 0.12em;
    font-weight: 500;
    padding: 14px 32px;
    border: 1px solid #222;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
    display: inline-block;
  }
  .btn-secondary:hover {
    background: #222;
    color: #fff;
  }

  .btn-link {
    background: none;
    border: none;
    color: #222;
    font-size: 12px;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }
  .btn-link:hover { color: #555; }

  /* Order Card */
  .order-card {
    border: 1px solid #e5e5e5;
    padding: 20px;
    margin-bottom: 16px;
    transition: border-color 0.2s;
  }
  .order-card:hover { border-color: #d1d1d1; }

  .order-status {
    display: inline-block;
    padding: 4px 12px;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    font-weight: 600;
  }
  .order-status.pending { background: #fff3cd; color: #856404; }
  .order-status.processing { background: #cfe2ff; color: #084298; }
  .order-status.shipped { background: #d1e7dd; color: #0f5132; }
  .order-status.delivered { background: #d1e7dd; color: #0f5132; }
  .order-status.cancelled { background: #f8d7da; color: #842029; }

  /* Address Card */
  .address-card {
    border: 1px solid #e5e5e5;
    padding: 20px;
    position: relative;
    background: #fff;
  }
  .address-card.default {
    border-color: #222;
    background: #f8f8f8;
  }
  .address-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #222;
    color: #fff;
    font-size: 9px;
    padding: 3px 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #888;
  }
  .empty-state svg {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    opacity: 0.3;
  }
  .empty-state h3 {
    font-size: 18px;
    font-weight: 500;
    color: #222;
    margin-bottom: 8px;
  }
  .empty-state p {
    font-size: 13px;
    margin-bottom: 24px;
  }

  /* Responsive */
  @media (max-width: 767px) {
    .account-tab {
      padding: 14px 16px;
      font-size: 11px;
    }
    .account-panel { padding: 24px 0; }
    .btn-primary, .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>

