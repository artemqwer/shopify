{% schema %}
{
  "name": "Catalog",
  "settings": []
}
{% endschema %}

<style>
  .catalog-card-img {
    transition: transform 0.7s ease;
  }
  .catalog-card:hover .catalog-card-img {
    transform: scale(1.05);
  }
  .catalog-slide {
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .catalog-slide.active {
    opacity: 1;
    pointer-events: auto;
  }
  .pagination-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 28px;
    font-size: 16px;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    letter-spacing: 0.03em;
    color: #000;
    transition: color 0.2s;
    text-decoration: none;
  }
  .pagination-link:hover { color: #9ca3af; }
  .pagination-link.current { color: #f04f98; }
  .pagination-dots { color: #9ca3af; display: inline-block; padding: 0 4px; }
</style>

{% assign products_per_page = 12 %}

{% paginate collection.products by products_per_page %}

<div class="w-full max-w-[1920px] mx-auto px-4 md:px-[160px] pt-[12px] md:pt-[24px] pb-[40px] md:pb-[36px]" {% if request.locale.iso_code == 'he' %}dir="rtl"{% endif %}>

  <!-- Breadcrumb + Filter Row -->
  <div class="flex items-center justify-between mb-[24px]">
    <nav class="flex items-center gap-2" aria-label="Breadcrumb" {% if request.locale.iso_code == 'he' %}style="direction: rtl;"{% endif %}>
      {% if request.locale.iso_code == 'he' %}
        {% unless collection.handle == 'all' %}
          <span class="text-[11px] font-medium tracking-[0.15em] uppercase text-gray-900"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
            {{ collection.title }}
          </span>
          <span class="text-gray-300 text-[11px] font-bold">‹</span>
        {% endunless %}
        <a href="{{ routes.all_products_collection_url }}"
           class="text-[11px] font-medium tracking-[0.15em] uppercase {% if collection.handle == 'all' %}text-gray-900{% else %}text-gray-400 hover:text-gray-700{% endif %} transition-colors"
           style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
           {{ 'header.catalog' | t }}
        </a>
        <span class="text-gray-300 text-[11px] font-bold">‹</span>
        <a href="{{ routes.root_url }}"
           class="text-[11px] font-medium tracking-[0.15em] uppercase text-gray-400 hover:text-gray-700 transition-colors"
           style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
          {{ 'header.home' | t }}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}"
           class="text-[11px] font-medium tracking-[0.15em] uppercase text-gray-400 hover:text-gray-700 transition-colors"
           style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
          {{ 'header.home' | t }}
        </a>
        <span class="text-gray-300 text-[11px] font-bold">›</span>
        <a href="{{ routes.all_products_collection_url }}"
           class="text-[11px] font-medium tracking-[0.15em] uppercase {% if collection.handle == 'all' %}text-gray-900{% else %}text-gray-400 hover:text-gray-700{% endif %} transition-colors"
           style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
          {{ 'header.catalog' | t }}
        </a>
        {% unless collection.handle == 'all' %}
          <span class="text-gray-300 text-[11px] font-bold">›</span>
          <span class="text-[11px] font-medium tracking-[0.15em] uppercase text-gray-900"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
            {{ collection.title }}
          </span>
        {% endunless %}
      {% endif %}
    </nav>

    <button
      class="flex items-center gap-2 text-[11px] font-medium tracking-[0.15em] uppercase text-gray-900 hover:text-gray-500 transition-colors"
      style="font-family: var(--font-montserrat), Montserrat, sans-serif;"
      aria-label="Filter"
      data-drawer-trigger="filter-drawer">
      {% if request.locale.iso_code == 'he' %}
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h18M7 12h10M10.5 19.5h3"/>
        </svg>
        (0) {{ 'catalog.filter' | t }}
      {% else %}
        {{ 'catalog.filter' | t }} (0)
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h18M7 12h10M10.5 19.5h3"/>
        </svg>
      {% endif %}
    </button>
  </div>

  <!-- Page Title -->
  <h1 class="text-[28px] md:text-[36px] font-light text-gray-900 mb-[16px] md:mb-[24px] text-center"
      style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
    {% if collection.handle == 'all' %}{{ 'header.catalog' | t }}{% else %}{{ collection.title }}{% endif %}
  </h1>

  <!-- ============================================================
       REAL SHOPIFY PRODUCTS (shown when products exist in collection)
  ============================================================= -->
  {% if collection.products.size > 0 %}

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-[12px] gap-y-[32px] md:gap-x-6 md:gap-y-[64px]">
      {% for product in collection.products %}
        <div class="catalog-card flex flex-col group">
          <div class="relative aspect-[3/4] mb-3 md:mb-4 overflow-hidden w-full bg-gray-100 catalog-slider" data-product-url="{{ product.url }}">
            {% if product.images.size > 0 %}
              {% for image in product.images %}
                <a href="{{ product.url }}" class="catalog-slide absolute inset-0 w-full h-full no-underline {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
                  <img
                    src="{{ image | image_url: width: 600 }}"
                    alt="{{ image.alt | default: product.title }}"
                    class="catalog-card-img w-full h-full object-cover"
                    loading="lazy"
                  />
                </a>
              {% endfor %}
              {% if product.images.size > 1 %}
                <div class="absolute bottom-2 left-0 right-0 flex justify-center gap-1 z-10 pointer-events-none">
                  {% for image in product.images %}
                    <span class="catalog-dot w-[6px] h-[6px] rounded-full transition-colors" style="background:{% if forloop.first %}#DE2077{% else %}#d1d5db{% endif %}" data-index="{{ forloop.index0 }}"></span>
                  {% endfor %}
                </div>
              {% endif %}
            {% else %}
              {% assign fallback_index = forloop.index0 | modulo: 4 | plus: 1 %}
              <a href="{{ product.url }}" class="absolute inset-0 w-full h-full no-underline">
                <img
                  src="{{ 'product-image-' | append: fallback_index | append: '.png' | asset_url }}"
                  alt="{{ product.title }}"
                  class="catalog-card-img w-full h-full object-cover"
                  loading="lazy"
                />
              </a>
            {% endif %}
          </div>
          <a href="{{ product.url }}" class="flex flex-col space-y-1 md:space-y-1.5 px-0.5 md:px-1 no-underline" {% if request.locale.iso_code == 'he' %}style="text-align: right; direction: rtl;"{% endif %}>
            <h3 class="text-[11px] md:text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              {{ product.title }}
            </h3>
            <p class="text-[11px] font-medium md:text-[13px] md:font-light text-gray-500"
               style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              {{ product.price | money }}
            </p>
          </a>
        </div>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
      <nav class="flex items-center justify-center gap-0.5 mt-[48px] md:mt-[64px]" aria-label="Pagination">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="pagination-link" aria-label="Previous">&lsaquo;</a>
        {% endif %}
        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" class="pagination-link">{{ part.title }}</a>
          {% elsif part.title == paginate.current_page %}
            <span class="pagination-link current">{{ part.title }}</span>
          {% else %}
            <span class="pagination-dots">…</span>
          {% endif %}
        {% endfor %}
        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="pagination-link" aria-label="Next">&rsaquo;</a>
        {% endif %}
      </nav>
    {% endif %}

  {% else %}
  <!-- ============================================================
       PLACEHOLDER LAYOUT (shown when collection is empty)
       Admin: add products in Shopify в†’ Products в†’ Collections
  ============================================================= -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-[12px] gap-y-[32px] md:gap-x-6 md:gap-y-[64px]">
      {% assign placeholder_images = "product-image-1.png,product-image-2.png,product-image-3.png,product-image-4.png" | split: "," %}
      {% assign placeholder_names = "products.product_1,products.product_2,products.product_3,products.product_4" | split: "," %}
      {% assign placeholder_slugs = "leopard-print-scarf,blue-silk-scarf,pink-scarf,vintage-scarf" | split: "," %}

      {% for i in (1..12) %}
        {% assign idx = forloop.index0 | modulo: 4 %}
        <a href="{{ routes.search_url }}?view=demo&product={{ placeholder_slugs[idx] }}" class="catalog-card cursor-pointer flex flex-col group no-underline">
          <div class="relative aspect-[3/4] mb-3 md:mb-4 overflow-hidden w-full bg-gray-100">
            <img
              src="{{ placeholder_images[idx] | asset_url }}"
              alt="{{ placeholder_names[idx] | t }}"
              class="catalog-card-img absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col space-y-1 md:space-y-1.5 px-0.5 md:px-1" {% if request.locale.iso_code == 'he' %}style="text-align: right; direction: rtl;"{% endif %}>
            <h3 class="text-[11px] md:text-[13px] font-medium md:font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors whitespace-nowrap overflow-hidden text-ellipsis"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              {{ placeholder_names[idx] | t }}
            </h3>
            <p class="text-[12px] font-medium md:text-[13px] md:font-light text-gray-800 md:text-gray-500"
               style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              $80
            </p>
          </div>
        </a>
      {% endfor %}
    </div>

    <!-- Static pagination for placeholder -->
    <nav class="flex items-center justify-center gap-0.5 mt-[48px] md:mt-[64px]" aria-label="Pagination">
      <span class="pagination-link current">1</span>
      <a href="{{ routes.all_products_collection_url }}?page=2" class="pagination-link">2</a>
      <a href="{{ routes.all_products_collection_url }}?page=3" class="pagination-link">3</a>
      <a href="{{ routes.all_products_collection_url }}?page=4" class="pagination-link">4</a>
      <a href="{{ routes.all_products_collection_url }}?page=2" class="pagination-link" aria-label="Next">&rsaquo;</a>
    </nav>

  {% endif %}

</div>

{% endpaginate %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.catalog-slider').forEach(function(slider) {
    var slides = slider.querySelectorAll('.catalog-slide');
    var dots = slider.querySelectorAll('.catalog-dot');
    if (slides.length < 2) return;

    var current = 0;
    var startX = 0;
    var diff = 0;

    function goTo(idx) {
      if (idx < 0 || idx >= slides.length) return;
      slides[current].classList.remove('active');
      dots[current].style.background = '#d1d5db';
      current = idx;
      slides[current].classList.add('active');
      dots[current].style.background = '#DE2077';
    }

    slider.addEventListener('touchstart', function(e) {
      startX = e.touches[0].clientX;
      diff = 0;
    }, {passive: true});

    slider.addEventListener('touchmove', function(e) {
      diff = e.touches[0].clientX - startX;
    }, {passive: true});

    slider.addEventListener('touchend', function() {
      if (Math.abs(diff) > 30) {
        if (diff < 0 && current < slides.length - 1) goTo(current + 1);
        else if (diff > 0 && current > 0) goTo(current - 1);
      }
    });
  });
});
</script>
