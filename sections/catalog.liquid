{% schema %}
{
  "name": "Catalog",
  "settings": []
}
{% endschema %}

<style>
  .catalog-card-img {
    transition: transform 0.7s ease;
  }
  .catalog-card:hover .catalog-card-img {
    transform: scale(1.05);
  }
  .pagination-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    font-size: 16px;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    letter-spacing: 0.03em;
    color: #000;
    transition: color 0.2s;
    text-decoration: none;
  }
  .pagination-link:hover { color: #9ca3af; }
  .pagination-link.current { color: #f04f98; }
  .pagination-dots { color: #9ca3af; display: inline-block; padding: 0 4px; }
</style>

{% assign products_per_page = 12 %}

{% paginate collection.products by products_per_page %}

<div class="w-full max-w-[1920px] mx-auto px-4 md:px-[160px] pt-[12px] md:pt-[24px] pb-[40px] md:pb-[36px]">

  <!-- Breadcrumb + Filter Row -->
  <div class="flex items-center justify-between mb-[48px]">
    <nav class="flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/"
         class="text-[11px] font-medium tracking-[0.15em] uppercase text-gray-400 hover:text-gray-700 transition-colors"
         style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        {{ 'header.home' | t }}
      </a>
      <span class="text-gray-300 text-[11px]">›</span>
      <a href="/collections/all"
         class="text-[11px] font-medium tracking-[0.15em] uppercase {% if collection.handle == 'all' %}text-gray-900{% else %}text-gray-400 hover:text-gray-700{% endif %} transition-colors"
         style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        {{ 'header.catalog' | t }}
      </a>
      {% unless collection.handle == 'all' %}
        <span class="text-gray-300 text-[11px]">›</span>
        <span class="text-[11px] font-medium tracking-[0.15em] uppercase text-gray-900"
              style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
          {{ collection.title }}
        </span>
      {% endunless %}
    </nav>

    <button
      class="flex items-center gap-2 text-[11px] font-medium tracking-[0.15em] uppercase text-gray-900 hover:text-gray-500 transition-colors"
      style="font-family: var(--font-montserrat), Montserrat, sans-serif;"
      aria-label="Filter"
      data-drawer-trigger="filter-drawer"
      onclick="openFilter()">
      {{ 'catalog.filter' | t }} (0)
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h18M7 12h10M10.5 19.5h3"/>
      </svg>
    </button>
  </div>

  <!-- ============================================================
       REAL SHOPIFY PRODUCTS (shown when products exist in collection)
  ============================================================= -->
  {% if collection.products.size > 0 %}

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-[48px] md:gap-x-6 md:gap-y-[64px]">
      {% for product in collection.products %}
        <a href="{{ product.url }}" class="catalog-card cursor-pointer flex flex-col group no-underline">
          <div class="relative aspect-[3/4] mb-4 overflow-hidden w-full bg-gray-100">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | default: product.title }}"
                class="catalog-card-img absolute inset-0 w-full h-full object-cover"
                loading="lazy"
              />
            {% else %}
              <!-- Fallback placeholder when product has no image yet -->
              {% assign fallback_index = forloop.index0 | modulo: 4 | plus: 1 %}
              <img
                src="{{ 'product-image-' | append: fallback_index | append: '.png' | asset_url }}"
                alt="{{ product.title }}"
                class="catalog-card-img absolute inset-0 w-full h-full object-cover"
                loading="lazy"
              />
            {% endif %}
          </div>
          <div class="flex flex-col space-y-1.5 px-1">
            <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              {{ product.title }}
            </h3>
            <p class="text-[13px] text-gray-500 font-light"
               style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              {{ product.price | money }}
            </p>
          </div>
        </a>
      {% endfor %}
    </div>

    <!-- Shopify Pagination -->
    {% if paginate.pages > 1 %}
      <div class="flex items-center justify-center gap-1 mt-[64px] md:mt-[80px]">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="pagination-link mr-1" aria-label="Previous">‹</a>
        {% endif %}

        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" class="pagination-link {% if part.title == paginate.current_page %}current{% endif %}">
              {{ part.title }}
            </a>
          {% else %}
            {% if part.title == paginate.current_page %}
              <span class="pagination-link current">{{ part.title }}</span>
            {% else %}
              <span class="pagination-dots">{{ part.title }}</span>
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="pagination-link ml-1" aria-label="Next">›</a>
        {% endif %}
      </div>
    {% endif %}

  {% else %}
  <!-- ============================================================
       PLACEHOLDER LAYOUT (shown when collection is empty)
       Admin: add products in Shopify → Products → Collections
  ============================================================= -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-[48px] md:gap-x-6 md:gap-y-[64px]">
      {% assign placeholder_images = "product-image-1.png,product-image-2.png,product-image-3.png,product-image-4.png" | split: "," %}
      {% assign placeholder_names = "products.product_1,products.product_2,products.product_3,products.product_4" | split: "," %}
      {% assign placeholder_slugs = "leopard-print-scarf,blue-silk-scarf,pink-scarf,vintage-scarf" | split: "," %}

      {% for i in (1..12) %}
        {% assign idx = forloop.index0 | modulo: 4 %}
        <a href="/products/{{ placeholder_slugs[idx] }}" class="catalog-card cursor-pointer flex flex-col group no-underline">
          <div class="relative aspect-[3/4] mb-4 overflow-hidden w-full bg-gray-100">
            <img
              src="{{ placeholder_images[idx] | asset_url }}"
              alt="{{ placeholder_names[idx] | t }}"
              class="catalog-card-img absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col space-y-1.5 px-1">
            <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              {{ placeholder_names[idx] | t }}
            </h3>
            <p class="text-[13px] text-gray-500 font-light"
               style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              $ 80
            </p>
          </div>
        </a>
      {% endfor %}
    </div>

    <!-- Static pagination for placeholder layout -->
    <div class="flex items-center justify-center gap-1 mt-[64px] md:mt-[80px]">
      <a href="/collections/all?page=1" class="pagination-link current">1</a>
      <a href="/collections/all?page=2" class="pagination-link">2</a>
      <a href="/collections/all?page=3" class="pagination-link">3</a>
      <span class="pagination-dots">…</span>
      <a href="/collections/all?page=12" class="pagination-link">12</a>
      <a href="/collections/all?page=2" class="pagination-link ml-1" aria-label="Next">›</a>
    </div>

  {% endif %}

</div>

{% endpaginate %}
