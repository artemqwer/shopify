{% schema %}
{ "name": "Customer Register", "settings": [] }
{% endschema %}

{% assign dir = 'ltr' %}
{% if request.locale.iso_code == 'he' %}{% assign dir = 'rtl' %}{% endif %}

{% if request.locale.iso_code == 'he' %}
  {% assign t_title     = 'יצירת חשבון' %}
  {% assign t_first     = 'שם פרטי' %}
  {% assign t_last      = 'שם משפחה' %}
  {% assign t_email     = 'אימייל' %}
  {% assign t_password  = 'סיסמה' %}
  {% assign t_submit    = 'צור חשבון' %}
  {% assign t_have_acc  = 'כבר יש לך חשבון?' %}
  {% assign t_login     = 'כניסה' %}
{% elsif request.locale.iso_code == 'uk' %}
  {% assign t_title     = 'Створити акаунт' %}
  {% assign t_first     = "Ім'я" %}
  {% assign t_last      = 'Прізвище' %}
  {% assign t_email     = 'Email' %}
  {% assign t_password  = 'Пароль' %}
  {% assign t_submit    = 'Зареєструватись' %}
  {% assign t_have_acc  = 'Вже є акаунт?' %}
  {% assign t_login     = 'Увійти' %}
{% elsif request.locale.iso_code == 'fr' %}
  {% assign t_title     = 'Créer un compte' %}
  {% assign t_first     = 'Prénom' %}
  {% assign t_last      = 'Nom' %}
  {% assign t_email     = 'Email' %}
  {% assign t_password  = 'Mot de passe' %}
  {% assign t_submit    = 'Créer un compte' %}
  {% assign t_have_acc  = 'Déjà un compte?' %}
  {% assign t_login     = 'Se connecter' %}
{% else %}
  {% assign t_title     = 'Create Account' %}
  {% assign t_first     = 'First Name' %}
  {% assign t_last      = 'Last Name' %}
  {% assign t_email     = 'Email' %}
  {% assign t_password  = 'Password' %}
  {% assign t_submit    = 'Create Account' %}
  {% assign t_have_acc  = 'Already have an account?' %}
  {% assign t_login     = 'Sign In' %}
{% endif %}

{% render 'customers-styles' %}

<div class="acc-page-wrap" dir="{{ dir }}">
  <div class="acc-card">
    <h1>{{ t_title }}</h1>

    {% if form.errors %}
      <div class="acc-error">{{ form.errors | default_errors }}</div>
    {% endif %}

    {% form 'create_customer' %}
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0 24px;">
        <div class="acc-field">
          <label class="acc-label" for="reg-first">{{ t_first }}</label>
          <input type="text" id="reg-first" name="customer[first_name]" class="acc-input"
                 autocomplete="given-name" value="{{ form.first_name }}">
        </div>
        <div class="acc-field">
          <label class="acc-label" for="reg-last">{{ t_last }}</label>
          <input type="text" id="reg-last" name="customer[last_name]" class="acc-input"
                 autocomplete="family-name" value="{{ form.last_name }}">
        </div>
      </div>
      <div class="acc-field">
        <label class="acc-label" for="reg-email">{{ t_email }}</label>
        <input type="email" id="reg-email" name="customer[email]" class="acc-input"
               autocomplete="email" value="{{ form.email }}" required>
      </div>
      <div class="acc-field">
        <label class="acc-label" for="reg-password">{{ t_password }}</label>
        <input type="password" id="reg-password" name="customer[password]" class="acc-input"
               autocomplete="new-password" required minlength="5">
      </div>
      <button type="submit" class="acc-btn-submit">{{ t_submit }}</button>
    {% endform %}

    <div class="acc-links">
      <a href="{{ routes.account_login_url }}">{{ t_have_acc }} {{ t_login }}</a>
    </div>
  </div>
</div>
