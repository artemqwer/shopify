{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}

<style>
  .product-gallery-main img { transition: opacity 0.35s ease; }
  .product-thumb { cursor: pointer; border: 2px solid transparent; transition: border-color 0.2s; }
  .product-thumb.active { border-color: #222; }
  .product-thumb:hover { border-color: #aaa; }
  .color-swatch {
    width: 28px; height: 28px; border-radius: 50%;
    border: 2px solid transparent; cursor: pointer;
    transition: border-color 0.2s; outline: none;
  }
  .color-swatch.active, .color-swatch:hover { border-color: #222; }
  .size-btn {
    min-width: 36px; height: 36px; padding: 0 10px;
    border: 1.5px solid #d1d1d1; font-size: 13px; cursor: pointer;
    transition: border-color 0.2s, background 0.2s; background: transparent;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
  }
  .size-btn.active { border-color: #222; background: #222; color: #fff; }
  .size-btn:hover:not(.active) { border-color: #888; }
  .accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .accordion-content.open { max-height: 600px; }
  .accordion-icon { transition: transform 0.3s; font-style: normal; }
  .btn-cart {
    width: 100%; background: #e61a7a; color: #fff; height: 52px;
    font-size: 14px; letter-spacing: 0.08em;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    font-weight: 600; border: none; cursor: pointer; transition: background 0.2s;
  }
  .btn-cart:hover { background: #222; }
  .btn-buy {
    width: 100%; background: transparent; color: #222; height: 52px;
    font-size: 14px; letter-spacing: 0.08em;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    font-weight: 600; border: 1.5px solid #222; cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .btn-buy:hover { background: #222; color: #fff; }
  @media (max-width: 768px) {
    .product-layout { flex-direction: column !important; }
    .product-gallery-col, .product-info-col { width: 100% !important; }
    .product-info-col { padding-top: 24px; }
  }
</style>

{% comment %}
  ─── PRODUCT DATA BY PAGE HANDLE ───────────────────────────────
  Each page handle maps to a specific product configuration.
  Handles: leopard-print-scarf / blue-silk-scarf / pink-scarf / vintage-scarf
{% endcomment %}

{% assign h = page.handle %}
{% if h == blank or h == '' %}
  {% assign query = request.query_string | replace: '&amp;', '&' | split: '&' %}
  {% for param in query %}
    {% if param contains 'product=' %}
      {% assign h = param | split: '=' | last %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if h == 'leopard-print-scarf' %}
  {% assign img_main   = 'product-image-1.png' %}
  {% assign img_thumbs = '' %}
  {% assign title_uk   = 'Хустка Леопард' %}
  {% assign title_he   = 'מטפחת מנומרת' %}
  {% assign desc_uk    = 'Відкрийте стихію дикої природи з нашою хусткою Леопард. Виконана з преміальних матеріалів, вона має благородний матовий блиск та неймовірно приємну на дотик текстуру. Унікальний принт та глибока палітра роблять її не просто аксесуаром, а центральним елементом вашого образу — від ділового костюма до розкішного виходу у світ.' %}
  {% assign desc_he    = 'פתחו את עולם הטבע הפראי עם המטפחת המנומרת שלנו. עשויה מחומרים פרמיה עם ברק מט ומרקם נעים במיוחד למגע. הדוגמה הייחודית ופלטת הצבעים העמוקה הופכות אותה לאקסססוריז מרכזי בכל לוק.' %}

{% elsif h == 'blue-silk-scarf' %}
  {% assign img_main   = 'product-image-2.png' %}
  {% assign img_thumbs = '' %}
  {% assign title_uk   = 'Хустка Синій шовк' %}
  {% assign title_he   = 'מטפחת משי כחולה' %}
  {% assign desc_uk    = 'Витончений синій шовк у чистому вигляді. Ця хустка виготовлена з натурального шовку. Приємна на дотик і неймовірно елегантна — ідеальний вибір для тих, хто цінує якість і стиль.' %}
  {% assign desc_he    = 'משי כחול מעודן בצורתו הטהורה. מטפחת זו עשויה ממשי טבעי. נעימה למגע ואלגנטית להפליא — הבחירה האידיאלית לאלה המעריכים איכות וסטייל.' %}

{% elsif h == 'pink-scarf' %}
  {% assign img_main   = 'product-image-3.png' %}
  {% assign img_thumbs = '' %}
  {% assign title_uk   = 'Хустка Рожева' %}
  {% assign title_he   = 'מטפחת וורודה' %}
  {% assign desc_uk    = 'Яскрава та енергійна — рожева хустка стане найкращим акцентом вашого образу. Виконана з якісного атласу, вона ідеально лягає та зберігає форму протягом усього дня.' %}
  {% assign desc_he    = 'עזה ואנרגטית — המטפחת הוורודה תהיה האקסנט הטוב ביותר בלוקים שלכם. עשויה מסאטן איכותי, שומרת על צורתה לאורך כל היום.' %}

{% else %}
  {% comment %} Default: vintage-scarf {% endcomment %}
  {% assign img_main   = 'product-image-4.png' %}
  {% assign img_thumbs = 'product-image-5.png,product-image-6.png' %}
  {% assign title_uk   = 'Хустинка Вінтаж' %}
  {% assign title_he   = "מטפחת וינטג'" %}
  {% assign desc_uk    = 'Відчуйте естетику минулих десятиліть у сучасному виконанні. Ця хустка натхненна класичними образами 60-х років. Виконана з преміального натурального шовку, вона має благородний матовий блиск та неймовірно приємну на дотик текстуру. Унікальний принт та глибока палітра роблять її не просто аксесуаром, а центральним елементом вашого образу — від ділового костюма до розкішного виходу у світ.' %}
  {% assign desc_he    = "חוו את אסתטיקת העשורים האחרונים בביצוע מודרני. מטפחת זו בהשראת לוקים קלאסיים של שנות ה-60. עשויה ממשי טבעי פרמיה, יש לה ברק מט אצילי ומרקם נעים להפליא למגע. הדוגמה הייחודית ופלטת הצבעים העמוקה הופכות אותה לאלמנט מרכזי של הלוק שלכם." %}
{% endif %}

{% comment %} Locale switching {% endcomment %}
{% if request.locale.iso_code == 'he' %}
  {% assign ui_title      = title_he %}
  {% assign ui_desc       = desc_he %}
  {% assign txt_home      = 'דף הבית' %}
  {% assign txt_catalog   = 'קטלוג' %}
  {% assign txt_add_cart  = 'הוסף לסל' %}
  {% assign txt_buy_now   = 'רכישה עכשיו' %}
  {% assign txt_size_guide= 'מדריך מידות' %}
  {% assign txt_material  = 'חומר' %}
  {% assign txt_care      = 'טיפול' %}
  {% assign care_text     = "- אל תכבסו במכונת כביסה; השתמשו בניקוי יבש או הלבנה עדינה בידיים עם מגבת לחה לסיבים.\n- ייבשו שטוחים ואל תייבשו במייבש; אווררו מרווחים לשמור על הצורה.\n- אחסנו קפוץ ולא תלוי, כדי למנוע עיוות.\n- לגיהוץ: השתמשו בנייר בין הברזל לחומר, ואל תנגעו ישירות בברזל." %}
  {% assign material_text = 'משי טבעי 100%' %}
{% else %}
  {% assign ui_title      = title_uk %}
  {% assign ui_desc       = desc_uk %}
  {% assign txt_home      = 'Головна' %}
  {% assign txt_catalog   = 'Каталог' %}
  {% assign txt_add_cart  = 'Додати в кошик' %}
  {% assign txt_buy_now   = 'Оформити покупку' %}
  {% assign txt_size_guide= 'Розмірна сітка' %}
  {% assign txt_material  = 'Матеріал' %}
  {% assign txt_care      = 'Догляд' %}
  {% assign care_text     = "- Очищення: не прати у машинці; використовуйте сухе чищення або акуратне видалення забруднень вологою серветкою.\n- Сушка: не сушити на батареї; залишайте лежати у добре провітрюваному місці, зберігаючи форму.\n- Зберігайте у сухому місці, подалі від прямого сонця; бажано у коробці, щоб уникнути деформації.\n- Догляд за тканиною: освіжайте матеріал паром з відстані; не торкайтеся праскою безпосередньо." %}
  {% assign material_text = '100% натуральний шовк' %}
{% endif %}

{% assign thumbs_arr = img_thumbs | split: ',' %}

<div class="w-full max-w-[1920px] mx-auto px-4 md:px-[160px] pt-[12px] pb-[64px]"
     {% if request.locale.iso_code == 'he' %}dir="rtl"{% endif %}>

  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 mb-[28px]"
       style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
    {% if request.locale.iso_code == 'he' %}
      <span class="text-[10px] tracking-[0.12em] uppercase text-gray-800">{{ ui_title | upcase }}</span>
      <span class="text-gray-300 text-[10px]">‹</span>
      <a href="/collections/all"
         class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_catalog }}</a>
      <span class="text-gray-300 text-[10px]">‹</span>
      <a href="/"
         class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_home }}</a>
    {% else %}
      <a href="/"
         class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_home }}</a>
      <span class="text-gray-300 text-[10px]">›</span>
      <a href="/collections/all"
         class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_catalog }}</a>
      <span class="text-gray-300 text-[10px]">›</span>
      <span class="text-gray-400 text-[10px] tracking-[0.12em] uppercase">{{ txt_catalog }}</span>
      <span class="text-gray-300 text-[10px]">›</span>
      <span class="text-gray-800 text-[10px] tracking-[0.12em] uppercase">{{ ui_title | upcase }}</span>
    {% endif %}
  </nav>

  <!-- Main Product Layout -->
  <div class="flex gap-[48px] lg:gap-[64px] product-layout">

    <!-- ══ LEFT: GALLERY ══ -->
    <div class="product-gallery-col w-full md:w-[55%] flex-shrink-0">

      <!-- Main image -->
      <div class="product-gallery-main relative w-full overflow-hidden mb-3" style="aspect-ratio: 3/4;">
        <img id="page-main-img"
             src="{{ img_main | asset_url }}"
             alt="{{ ui_title }}"
             class="absolute inset-0 w-full h-full object-cover"
             loading="eager" />
      </div>

      <!-- Thumbnails (if any) -->
      {% if img_thumbs != '' %}
        <div class="grid gap-3" style="grid-template-columns: repeat({{ thumbs_arr.size }}, 1fr);">
          {% for thumb in thumbs_arr %}
            <div class="product-thumb relative overflow-hidden"
                 style="aspect-ratio: 1/1;"
                 onclick="pageSetImg('{{ thumb | asset_url }}', this)">
              <img src="{{ thumb | asset_url }}"
                   alt="{{ ui_title }}"
                   class="absolute inset-0 w-full h-full object-cover" />
            </div>
          {% endfor %}
        </div>
      {% endif %}

    </div><!-- /gallery -->

    <!-- ══ RIGHT: PRODUCT INFO ══ -->
    <div class="product-info-col flex-1 flex flex-col pt-0">

      <!-- Title -->
      <h1 class="text-[28px] md:text-[32px] font-bold text-[#222] tracking-wider uppercase mb-1"
          style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        {{ ui_title }}
      </h1>

      <!-- Price -->
      <p class="text-[18px] text-[#444] mb-5"
         style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        $ 80
      </p>

      <!-- Description -->
      <p class="text-[13px] text-[#555] leading-[1.75] mb-7"
         style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        {{ ui_desc }}
      </p>

      <!-- Color swatches -->
      <div class="flex items-center gap-3 mb-6">
        <button class="color-swatch active" style="background:#1b2536;" aria-label="Dark blue" onclick="swatchClick(this)"></button>
        <button class="color-swatch" style="background:#63141f;" aria-label="Bordeaux" onclick="swatchClick(this)"></button>
        <button class="color-swatch" style="background:#3d2b2b;" aria-label="Dark brown" onclick="swatchClick(this)"></button>
      </div>

      <!-- Size selector -->
      <div class="flex items-center gap-3 mb-2">
        <button class="size-btn" onclick="sizeClick(this)">S</button>
        <button class="size-btn active" onclick="sizeClick(this)">M</button>
        <button class="size-btn" onclick="sizeClick(this)">L</button>
      </div>

      <!-- Size guide -->
      <div class="mb-7 text-right">
        <a href="#" class="text-[12px] text-[#888] underline hover:text-[#333] transition-colors"
           style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
          {{ txt_size_guide }}
        </a>
      </div>

      <!-- Action buttons -->
      <div class="flex flex-col gap-3 mb-8">
        <button type="button" class="btn-cart"
                data-title="{{ ui_title | escape }}"
                data-price="$ 80"
                data-image="{{ img_main | asset_url }}"
                onclick="handlePageAddToCart(this)">{{ txt_add_cart }}</button>
        <button type="button" class="btn-buy">{{ txt_buy_now }}</button>
      </div>

      <!-- Accordion: Material -->
      <div class="border-t border-[#e5e5e5]">
        <button class="w-full flex items-center justify-between py-4 text-left"
                onclick="pageToggle('acc-mat')">
          <span class="text-[13px] font-medium text-[#222] tracking-wider"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ txt_material }}</span>
          <span id="acc-mat-icon" class="accordion-icon text-[20px] font-light text-[#222] leading-none select-none">+</span>
        </button>
        <div id="acc-mat" class="accordion-content">
          <p class="text-[13px] text-[#555] leading-[1.75] pb-4"
             style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ material_text }}</p>
        </div>
      </div>

      <!-- Accordion: Care -->
      <div class="border-t border-[#e5e5e5]">
        <button class="w-full flex items-center justify-between py-4 text-left"
                onclick="pageToggle('acc-care')">
          <span class="text-[13px] font-medium text-[#222] tracking-wider"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ txt_care }}</span>
          <span id="acc-care-icon" class="accordion-icon text-[20px] font-light text-[#e61a7a] leading-none select-none">✕</span>
        </button>
        <div id="acc-care" class="accordion-content open">
          <div class="text-[13px] text-[#555] leading-[1.9] pb-4"
               style="font-family: var(--font-montserrat), Montserrat, sans-serif; white-space: pre-line;">{{ care_text }}</div>
        </div>
      </div>

      <div class="border-t border-[#e5e5e5]"></div>
    </div><!-- /info -->
  </div><!-- /flex -->
</div>

<script>
  function pageSetImg(src, thumbEl) {
    var main = document.getElementById('page-main-img');
    if (!main) return;
    main.style.opacity = '0';
    setTimeout(function() { main.src = src; main.style.opacity = '1'; }, 180);
    document.querySelectorAll('.product-thumb').forEach(function(t){ t.classList.remove('active'); });
    if (thumbEl) thumbEl.classList.add('active');
  }

  function sizeClick(btn) {
    document.querySelectorAll('.size-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
  }

  function swatchClick(sw) {
    document.querySelectorAll('.color-swatch').forEach(function(s){ s.classList.remove('active'); });
    sw.classList.add('active');
  }

  function pageToggle(id) {
    var content = document.getElementById(id);
    var icon    = document.getElementById(id + '-icon');
    if (!content) return;
    var isOpen = content.classList.contains('open');
    content.classList.toggle('open', !isOpen);
    if (icon) {
      if (id === 'acc-mat') {
        icon.textContent = isOpen ? '+' : '–';
      } else {
        icon.style.color = isOpen ? '#222' : '#e61a7a';
      }
    }
  }

  // Add to cart for page (placeholder) products
  function handlePageAddToCart(btn) {
    var title = btn.dataset.title || 'Product';
    var price = btn.dataset.price || '$80';
    var image = btn.dataset.image || '';
    var original = btn.textContent.trim();
    btn.textContent = '...';
    btn.disabled = true;
    btn.style.opacity = '0.7';
    var restore = function() {
      btn.textContent = original;
      btn.disabled = false;
      btn.style.opacity = '';
    };
    if (window.EsterCart) {
      window.EsterCart.add('', 1, { title: title, price: price, image: image })
        .catch(restore)
        .finally(restore);
    } else {
      // EsterCart not yet loaded — retry after a moment
      setTimeout(function() {
        if (window.EsterCart) {
          window.EsterCart.add('', 1, { title: title, price: price, image: image })
            .catch(restore).finally(restore);
        } else { restore(); }
      }, 500);
    }
  }
</script>
