{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "header",
      "content": "About Us Page"
    },
    {
      "type": "image_picker",
      "id": "about_image_1",
      "label": "About Us Image 1"
    },
    {
      "type": "image_picker",
      "id": "about_image_2",
      "label": "About Us Image 2"
    }
  ]
}
{% endschema %}

<style>
  .product-gallery-main img { transition: opacity 0.35s ease; }
  .product-thumb { cursor: pointer; border: 2px solid transparent; transition: border-color 0.2s; }
  .product-thumb.active { border-color: #222; }
  .product-thumb:hover { border-color: #aaa; }
  .color-swatch {
    width: 28px; height: 28px; border-radius: 50%;
    border: 2px solid transparent; cursor: pointer;
    transition: border-color 0.2s; outline: none;
  }
  .color-swatch.active, .color-swatch:hover { border-color: #222; }
  .size-btn {
    min-width: 40px; height: 40px; padding: 0 10px;
    border: 1.5px solid #d1d1d1; font-size: 13px; cursor: pointer;
    transition: border-color 0.2s, background 0.2s; background: transparent;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
  }
  .size-btn.active { border-color: #DE2077 !important; background: #DE2077 !important; color: #fff !important; }
  .size-btn:hover:not(.active) { border-color: #888; }
  .accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .accordion-content.open { max-height: 600px; }
  .accordion-icon { transition: transform 0.3s; font-style: normal; }

  /* ── Size Guide Modal ── */
  #size-guide-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.55);
    z-index: 99990; display: none;
    align-items: center; justify-content: center;
    padding: 16px; overflow-y: auto;
  }
  #size-guide-overlay.active { display: flex; }
  #size-guide-modal {
    background: #fff; width: 100%; max-width: 860px;
    position: relative; overflow: hidden; margin: auto;
  }
  #size-guide-modal .sg-close {
    position: absolute; top: 16px;
    background: none; border: none; cursor: pointer;
    padding: 8px; z-index: 10; display: flex; align-items: center; justify-content: center;
  }
  #size-guide-overlay[dir="ltr"] .sg-close { right: 16px; }
  #size-guide-overlay[dir="rtl"] .sg-close { left: 16px; }
  #size-guide-modal .sg-body { display: flex; min-height: 420px; position: relative; }
  #size-guide-modal .sg-left {
    flex: 1; padding: 60px 40px 60px 60px;
    display: flex; flex-direction: column; justify-content: center;
  }
  #size-guide-overlay[dir="rtl"] .sg-left { padding: 60px 60px 60px 40px; }
  #size-guide-modal .sg-right {
    width: 320px; flex-shrink: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 60px 40px;
  }
  #size-guide-modal .sg-right img { width: 100%; height: auto; display: block; mix-blend-mode: multiply; }
  #size-guide-modal .sg-right-label {
    text-align: center; color: #555; font-size: 11px;
    font-weight: 500; letter-spacing: 0.05em; margin-bottom: 12px;
    text-transform: uppercase;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
  }
  #size-guide-modal h2.sg-title {
    font-size: 22px; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase; color: #111; margin: 0 0 28px;
    line-height: 1.2; font-family: var(--font-montserrat), Montserrat, sans-serif;
  }
  #size-guide-modal .sg-row {
    border: 1px solid #ccc; padding: 14px 20px;
    font-size: 15px; font-weight: 400; color: #111;
    text-align: center; margin-bottom: 10px;
    font-family: var(--font-montserrat), Montserrat, sans-serif; letter-spacing: 0.03em;
  }
  @media (max-width: 640px) {
    #size-guide-modal .sg-body { flex-direction: column; min-height: unset; }
    #size-guide-modal .sg-left { padding: 52px 24px 24px; align-items: flex-start; order: 1; }
    #size-guide-overlay[dir="rtl"] .sg-left { padding: 52px 24px 24px; }
    #size-guide-modal h2.sg-title { font-size: 16px; margin-bottom: 20px; }
    #size-guide-modal .sg-row { font-size: 13px; padding: 12px 16px; }
    #size-guide-modal .sg-right { width: 100%; padding: 0 24px 32px; order: 2; }
    #size-guide-modal .sg-right-label { font-size: 10px; }
    #size-guide-modal .sg-close { top: 10px; }
    #size-guide-overlay[dir="ltr"] .sg-close { right: 10px; }
    #size-guide-overlay[dir="rtl"] .sg-close { left: 10px; }
  }

  /* ── Action Buttons ── */
  .btn-cart {
    width: 100%; background: #DE2077; color: #fff; height: 52px;
    font-size: 14px; letter-spacing: 0.08em;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    font-weight: 600; border: none; cursor: pointer; transition: background 0.2s;
  }
  .btn-cart:hover { background: #333; }
  .btn-buy {
    width: 100%; background: transparent; color: #222; height: 52px;
    display: flex; align-items: center; justify-content: center;
    text-align: center; text-decoration: none;
    font-size: 14px; letter-spacing: 0.08em;
    font-family: var(--font-montserrat), Montserrat, sans-serif;
    font-weight: 600; border: 1.5px solid #222; cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .btn-buy:hover { background: #111; color: #fff; }

  /* ── Layout ── */
  .product-layout { display: flex; gap: 48px; }
  @media (max-width: 768px) {
    .product-layout { flex-direction: column !important; gap: 0; }
    .product-gallery-col, .product-info-col { width: 100% !important; }
    .product-info-col { padding-top: 20px; }
    .product-info-col h1 { font-size: 22px !important; }
  }

  /* Gallery dots — overlaid on image, bottom-left */
  #page-gallery-dots {
    display: none;
    position: absolute;
    bottom: 16px;
    left: 20px;
    right: auto;
    justify-content: flex-start;
    align-items: center;
    gap: 8px;
    z-index: 5;
    pointer-events: none;
  }
  .gallery-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #EDEDED;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.25s;
    pointer-events: auto;
  }
  .gallery-dot.active {
    background: #DE2077 !important;
  }

  @media (max-width: 768px) {
    .product-thumbs-row { display: none !important; }
    .product-gallery-main {
      margin-left: -1rem;
      margin-right: -1rem;
      width: calc(100% + 2rem) !important;
    }
    #page-gallery-dots { display: flex !important; }
  }
</style>

{% comment %}
  ─── PRODUCT DATA BY PAGE HANDLE ───────────────────────────────
  Each page handle maps to a specific product configuration.
  Handles: about-us / leopard-print-scarf / blue-silk-scarf / pink-scarf / vintage-scarf
{% endcomment %}

{% assign h = page.handle %}

{% if h == 'shipping-payment' %}
<div class="w-full bg-white">
  <div class="max-w-[1280px] mx-auto px-5 md:px-[20px] pt-10 pb-16" style="font-family: Montserrat, sans-serif;">

    <p class="text-[15px] text-[#111] leading-[1.65] mb-8">{{ 'shipping.intro' | t }}</p>

    <!-- Оплата -->
    <h2 class="text-[20px] font-bold text-[#111] mb-4">{{ 'shipping.payment_title' | t }}</h2>
    <ol class="flex flex-col gap-5 mb-8 list-none">
      <li>
        <p class="text-[15px] font-semibold text-[#111] mb-1">1. {{ 'shipping.bank_transfer_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.bank_transfer_desc' | t }}</p>
      </li>
      <li>
        <p class="text-[15px] font-semibold text-[#111] mb-1">2. {{ 'shipping.cod_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.cod_desc' | t }}</p>
      </li>
      <li>
        <p class="text-[15px] font-semibold text-[#111] mb-1">3. {{ 'shipping.payment_note_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.payment_note_desc' | t }}</p>
      </li>
    </ol>

    <!-- Самовивіз -->
    <h2 class="text-[20px] font-bold text-[#111] mb-4">{{ 'shipping.pickup_title' | t }}</h2>
    <div class="flex flex-col gap-3 mb-8">
      <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.pickup_address' | t }}</p>
      <p class="text-[15px] text-[#111]">{{ 'shipping.pickup_can' | t }}</p>
      <ul class="flex flex-col gap-1 pl-4 list-disc">
        <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.pickup_item1' | t }}</li>
        <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.pickup_item2' | t }}</li>
        <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.pickup_item3' | t }}</li>
      </ul>
    </div>

    <!-- Доставка -->
    <h2 class="text-[20px] font-bold text-[#111] mb-4">{{ 'shipping.delivery_title' | t }}</h2>
    <p class="text-[15px] text-[#111] leading-[1.65] mb-5">{{ 'shipping.delivery_intro' | t }}</p>
    <ol class="flex flex-col gap-5 list-none">
      <li>
        <p class="text-[15px] font-semibold text-[#111] mb-1">1. {{ 'shipping.zone_title' | t }}</p>
        <ul class="pl-4 list-disc"><li class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.zone_desc' | t }}</li></ul>
      </li>
      <li>
        <p class="text-[15px] font-semibold text-[#111] mb-1">2. {{ 'shipping.carriers_title' | t }}</p>
        <ul class="pl-4 list-disc"><li class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.carriers_desc' | t }}</li></ul>
      </li>
      <li>
        <p class="text-[15px] font-semibold text-[#111] mb-1">3. {{ 'shipping.cost_title' | t }}</p>
        <ul class="pl-4 list-disc"><li class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.cost_desc' | t }}</li></ul>
      </li>
      <li>
        <p class="text-[15px] font-semibold text-[#111] mb-1">4. {{ 'shipping.important_title' | t }}</p>
        <ul class="flex flex-col gap-1 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.important_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'shipping.important_item2' | t }}</li>
        </ul>
      </li>
    </ol>

  </div>
</div>

{% elsif h == 'about-us' %}
<div class="w-full bg-white">

  <div class="max-w-[1280px] mx-auto px-5 md:px-[20px] pt-10 pb-8">
    <h1 class="text-[26px] font-bold text-[#111] mb-7 leading-tight" style="font-family: Montserrat, sans-serif;">
      {{ 'about.title' | t }}
    </h1>
    <div class="flex flex-col gap-5">
      <p class="text-[15px] font-normal text-[#111] leading-[1.65]" style="font-family: Montserrat, sans-serif;">{{ 'about.p1' | t }}</p>
      <p class="text-[15px] font-normal text-[#111] leading-[1.65]" style="font-family: Montserrat, sans-serif;">{{ 'about.p2' | t }}</p>
      <p class="text-[15px] font-normal text-[#111] leading-[1.65]" style="font-family: Montserrat, sans-serif;">{{ 'about.p3' | t }}</p>
    </div>
  </div>

  <div class="w-full mb-8">
    {% if section.settings.about_image_1 != blank %}
      <img src="{{ section.settings.about_image_1 | image_url: width: 1280 }}" alt="{{ section.settings.about_image_1.alt | escape | default: 'About Us' }}" width="800" height="600" class="w-full object-cover" loading="lazy" />
    {% else %}
      <img src="{{ 'product-image-1.png' | asset_url }}" alt="{{ 'about.title' | t }}" width="800" height="600" class="w-full object-cover" loading="lazy" />
    {% endif %}
  </div>

  <div class="max-w-[1280px] mx-auto px-5 md:px-[20px] pb-8">
    <div class="flex flex-col gap-5">
      <p class="text-[15px] font-normal text-[#111] leading-[1.65]" style="font-family: Montserrat, sans-serif;">{{ 'about.p4' | t }}</p>
      <p class="text-[15px] font-normal text-[#111] leading-[1.65]" style="font-family: Montserrat, sans-serif;">{{ 'about.p5' | t }}</p>
    </div>
  </div>

  <div class="w-full pb-16">
    {% if section.settings.about_image_2 != blank %}
      <img src="{{ section.settings.about_image_2 | image_url: width: 1280 }}" alt="{{ section.settings.about_image_2.alt | escape | default: 'About Us' }}" width="800" height="600" class="w-full object-cover" loading="lazy" />
    {% else %}
      <img src="{{ 'product-image-4.png' | asset_url }}" alt="{{ 'about.title' | t }}" width="800" height="600" class="w-full object-cover" loading="lazy" />
    {% endif %}
  </div>

</div>

{% else %}
{% if h == blank or h == '' %}
  {% assign query = request.query_string | replace: '&amp;', '&' | split: '&' %}
  {% for param in query %}
    {% if param contains 'product=' %}
      {% assign h = param | split: '=' | last %}
    {% endif %}
  {% endfor %}
{% endif %}

