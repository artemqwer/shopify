{% assign thumbs_arr = img_thumbs | split: ',' %}

<div class="w-full max-w-[1280px] mx-auto px-4 md:px-[20px] pt-[12px] pb-[64px]"
     {% if request.locale.iso_code == 'he' %}dir="rtl"{% endif %}>

  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 mb-[28px]"
       style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
    {% if request.locale.iso_code == 'he' %}
      <span class="text-[10px] tracking-[0.12em] uppercase text-gray-800">{{ ui_title | upcase }}</span>
      <span class="text-gray-300 text-[10px]">‹</span>
      <span class="text-[10px] tracking-[0.12em] uppercase text-gray-400">{{ txt_scarf }}</span>
      <span class="text-gray-300 text-[10px]">‹</span>
      <a href="{{ routes.all_products_collection_url }}"
         class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_catalog }}</a>
      <span class="text-gray-300 text-[10px]">‹</span>
      <a href="{{ routes.root_url }}"
         class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_home }}</a>
    {% else %}
      <a href="{{ routes.root_url }}"
         class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_home }}</a>
      <span class="text-gray-300 text-[10px]">›</span>
      <a href="{{ routes.all_products_collection_url }}"
         class="text-[10px] tracking-[0.12em] uppercase text-gray-400 hover:text-gray-700 transition-colors">{{ txt_catalog }}</a>
      <span class="text-gray-300 text-[10px]">›</span>
      <span class="text-gray-400 text-[10px] tracking-[0.12em] uppercase">{{ txt_scarf }}</span>
      <span class="text-gray-300 text-[10px]">›</span>
      <span class="text-gray-800 text-[10px] tracking-[0.12em] uppercase">{{ ui_title | upcase }}</span>
    {% endif %}
  </nav>

  <!-- Main Product Layout -->
  <div class="product-layout">

    <!-- ══ LEFT: GALLERY ══ -->
    <div class="product-gallery-col w-full md:w-[55%] flex-shrink-0" style="max-width: 600px;">

      <!-- Main image -->
      <div class="product-gallery-main relative w-full overflow-hidden mb-3" style="aspect-ratio: 920/974;">
        <img id="page-main-img"
             src="{{ img_main | asset_url }}"
             alt="{{ ui_title | escape }}"
             class="absolute inset-0 w-full h-full object-cover"
             loading="eager" />

        <!-- Mobile dot indicators -->
        <div id="page-gallery-dots"></div>
      </div>

      <!-- Thumbnails (if any) — hidden on mobile -->
      {% if img_thumbs != '' %}
        <div class="product-thumbs-row grid gap-3" style="grid-template-columns: repeat({{ thumbs_arr.size }}, 1fr);">
          {% for thumb in thumbs_arr %}
            <div class="product-thumb relative overflow-hidden"
                 style="aspect-ratio: 1/1;"
                 onclick="pageSetImg('{{ thumb | asset_url }}', this)">
              <img src="{{ thumb | asset_url }}"
                   alt="{{ ui_title | escape }}"
                   class="absolute inset-0 w-full h-full object-cover" />
            </div>
          {% endfor %}
        </div>
      {% endif %}

    </div><!-- /gallery -->

    <!-- ══ RIGHT: PRODUCT INFO ══ -->
    <div class="product-info-col flex-1 flex flex-col pt-0">

      <!-- Title -->
      <h1 class="text-[22px] md:text-[32px] font-bold text-[#222] tracking-wider uppercase mb-1"
          style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        {{ ui_title }}
      </h1>

      <!-- Price -->
      <p class="text-[18px] text-[#444] mb-5"
         style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        $ 80
      </p>

      <!-- Description -->
      <p class="text-[13px] text-[#555] leading-[1.75] mb-7"
         style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        {{ ui_desc }}
      </p>

      <!-- Color swatches -->
      <div class="flex items-center gap-3 mb-6">
        <button class="color-swatch active" style="background:#1b2536;" aria-label="Dark blue" onclick="swatchClick(this)"></button>
        <button class="color-swatch" style="background:#63141f;" aria-label="Bordeaux" onclick="swatchClick(this)"></button>
        <button class="color-swatch" style="background:#3d2b2b;" aria-label="Dark brown" onclick="swatchClick(this)"></button>
      </div>

      <!-- Size selector -->
      <div class="hidden md:flex items-center gap-3 mb-2">
        <button class="size-btn" onclick="sizeClick(this)">S</button>
        <button class="size-btn active" onclick="sizeClick(this)">M</button>
        <button class="size-btn" onclick="sizeClick(this)">L</button>
      </div>

      <!-- Size guide -->
      <div class="hidden md:block mb-7 text-right" {% if request.locale.iso_code == 'he' %}style="text-align:left"{% endif %}>
        <button type="button" onclick="openSizeGuide()" class="text-[12px] text-[#888] underline hover:text-[#333] transition-colors bg-transparent border-none cursor-pointer p-0"
           style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
          {{ txt_size_guide }}
        </button>
      </div>

      <!-- Action buttons -->
      <div class="flex flex-col gap-3 mb-8">
        <button type="button" class="btn-cart"
                data-title="{{ ui_title | escape }}"
                data-price="$ 80"
                data-image="{{ img_main | asset_url }}"
                onclick="handlePageAddToCart(this)">{{ txt_add_cart }}</button>
        <a href="{{ routes.search_url }}?view=order" class="btn-buy">{{ txt_buy_now }}</a>
      </div>

      <!-- Accordion: Material -->
      <div class="border-t border-[#e5e5e5]">
        <button class="w-full flex items-center justify-between py-4 text-left"
                onclick="pageToggle('acc-mat')">
          <span class="text-[13px] font-medium text-[#222] tracking-wider"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ txt_material }}</span>
          <span id="acc-mat-icon" class="accordion-icon text-[20px] font-light text-[#222] leading-none select-none">+</span>
        </button>
        <div id="acc-mat" class="accordion-content">
          <p class="text-[13px] text-[#555] leading-[1.75] pb-4"
             style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ material_text }}</p>
        </div>
      </div>

      <!-- Accordion: Care -->
      <div class="border-t border-[#e5e5e5]">
        <button class="w-full flex items-center justify-between py-4 text-left"
                onclick="pageToggle('acc-care')">
          <span class="text-[13px] font-medium text-[#222] tracking-wider"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ txt_care }}</span>
          <span id="acc-care-icon" class="accordion-icon text-[20px] font-light text-[#e61a7a] leading-none select-none">–</span>
        </button>
        <div id="acc-care" class="accordion-content open">
          <div class="text-[13px] text-[#555] leading-[1.9] pb-4"
               style="font-family: var(--font-montserrat), Montserrat, sans-serif; white-space: pre-line;">{{ care_text }}</div>
        </div>
      </div>

      <div class="border-t border-[#e5e5e5]"></div>
    </div><!-- /info -->
  </div><!-- /flex -->
</div>

<script>
  function pageSetImg(src, thumbEl) {
    var main = document.getElementById('page-main-img');
    if (!main) return;
    main.style.opacity = '0';
    setTimeout(function() { main.src = src; main.style.opacity = '1'; }, 180);
    document.querySelectorAll('.product-thumb').forEach(function(t){ t.classList.remove('active'); });
    if (thumbEl) thumbEl.classList.add('active');
  }

  /* ── Mobile gallery: collect all images and build dot slider ── */
  (function() {
    var mainImg = document.getElementById('page-main-img');
    var dotsEl  = document.getElementById('page-gallery-dots');
    if (!mainImg || !dotsEl) return;

    // Build image list: main + thumbs
    var images = [mainImg.src];
    document.querySelectorAll('.product-thumbs-row img').forEach(function(img) {
      images.push(img.src);
    });
    if (images.length <= 1) return;

    var current = 0;
    function goTo(idx) {
      current = idx;
      mainImg.style.opacity = '0';
      setTimeout(function() { mainImg.src = images[idx]; mainImg.style.opacity = '1'; }, 180);
      dotsEl.querySelectorAll('.gallery-dot').forEach(function(d, i) {
        d.classList.toggle('active', i === idx);
        d.style.background = (i === idx) ? '#DE2077' : '#EDEDED';
      });
    }

    images.forEach(function(_, i) {
      var d = document.createElement('button');
      d.className = 'gallery-dot' + (i === 0 ? ' active' : '');
      d.style.background = (i === 0) ? '#DE2077' : '#EDEDED';
      d.setAttribute('aria-label', 'Image ' + (i + 1));
      d.addEventListener('click', function() { goTo(i); });
      dotsEl.appendChild(d);
    });

    // Touch swipe support
    var startX = 0;
    mainImg.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive: true });
    mainImg.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) < 40) return;
      if (dx < 0 && current < images.length - 1) goTo(current + 1);
      else if (dx > 0 && current > 0) goTo(current - 1);
    });
  })();

  function sizeClick(btn) {
    document.querySelectorAll('.size-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
  }

  function swatchClick(sw) {
    document.querySelectorAll('.color-swatch').forEach(function(s){ s.classList.remove('active'); });
    sw.classList.add('active');
  }

  function pageToggle(id) {
    var content = document.getElementById(id);
    var icon    = document.getElementById(id + '-icon');
    if (!content) return;
    var isOpen = content.classList.contains('open');
    content.classList.toggle('open', !isOpen);
    if (icon) {
      icon.textContent = isOpen ? '+' : '–';
      if (id === 'acc-care') {
        icon.style.color = isOpen ? '#222' : '#e61a7a';
      }
    }
  }

  // Add to cart for page (placeholder) products
  function handlePageAddToCart(btn) {
    var title = btn.dataset.title || 'Product';
    var price = btn.dataset.price || '$80';
    var image = btn.dataset.image || '';
    var original = btn.textContent.trim();
    btn.textContent = '...';
    btn.disabled = true;
    btn.style.opacity = '0.7';
    var restore = function() {
      btn.textContent = original;
      btn.disabled = false;
      btn.style.opacity = '';
    };
    if (window.EsterCart) {
      window.EsterCart.add('', 1, { title: title, price: price, image: image })
        .catch(restore)
        .finally(restore);
    } else {
      setTimeout(function() {
        if (window.EsterCart) {
          window.EsterCart.add('', 1, { title: title, price: price, image: image })
            .catch(restore).finally(restore);
        } else { restore(); }
      }, 500);
    }
  }
  function openSizeGuide() {
    var el = document.getElementById('size-guide-overlay');
    if (el) { el.classList.add('active'); document.body.style.overflow = 'hidden'; }
  }
  function closeSizeGuide() {
    var el = document.getElementById('size-guide-overlay');
    if (el) { el.classList.remove('active'); document.body.style.overflow = ''; }
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeSizeGuide();
  });
</script>

<!-- ═══ SIZE GUIDE MODAL ═══ -->
<div id="size-guide-overlay" onclick="if(event.target===this)closeSizeGuide()" dir="{% if request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}">
  <div id="size-guide-modal">
    <button class="sg-close" onclick="closeSizeGuide()" aria-label="Close">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <div class="sg-body">
      <div class="sg-left">
        <h2 class="sg-title">
          {% if request.locale.iso_code == 'he' %}מידה – היקף ראש{% else %}SIZE — HEAD CIRCUMFERENCE{% endif %}
        </h2>
        <div class="sg-row" dir="ltr">S - 56 {% if request.locale.iso_code == 'he' %}ס"מ{% else %}cm{% endif %}</div>
        <div class="sg-row" dir="ltr">M - 57 {% if request.locale.iso_code == 'he' %}ס"מ{% else %}cm{% endif %}</div>
        <div class="sg-row" dir="ltr">L - 58 {% if request.locale.iso_code == 'he' %}ס"מ{% else %}cm{% endif %}</div>
      </div>
      <div class="sg-right">
        <div class="sg-right-label">
          {% if request.locale.iso_code == 'he' %}מדוד לפי הקו הזה{% else %}MEASURE ALONG THIS LINE{% endif %}
        </div>
        <img src="{{ 'image2.svg' | asset_url }}" alt="{% if request.locale.iso_code == 'he' %}מדידת ראש{% else %}Measurement{% endif %}" loading="lazy">
      </div>
    </div>
  </div>
</div>

{% endif %}
