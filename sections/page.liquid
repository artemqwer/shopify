  {% assign ui_desc       = desc_he %}
  {% assign txt_home      = 'דף הבית' %}
  {% assign txt_catalog   = 'קטלוג' %}
  {% assign txt_scarf     = 'מטפחת' %}
  {% assign txt_add_cart  = 'הוסף לסל' %}
  {% assign txt_buy_now   = 'רכישה עכשיו' %}
  {% assign txt_size_guide= 'מדריך מידות' %}
  {% assign txt_material  = 'חומר' %}
  {% assign txt_care      = 'טיפול' %}
  {% assign care_text     = "- אל תכבסו במכונת כביסה; השתמשו בניקוי יבש או הלבנה עדינה בידיים עם מגבת לחה לסיבים.\n- ייבשו שטוחים ואל תייבשו במייבש; אווררו מרווחים לשמור על הצורה.\n- אחסנו קפוץ ולא תלוי, כדי למנוע עיוות.\n- לגיהוץ: השתמשו בנייר בין הברזל לחומר, ואל תנגעו ישירות בברזל." %}
