{% schema %}
{
  "name": "Privacy Policy",
  "settings": []
}
{% endschema %}

<div class="w-full bg-white">
  <div class="max-w-[1280px] mx-auto px-5 md:px-[20px] pt-10 pb-16" style="font-family: Montserrat, sans-serif;">

    <h1 class="text-[32px] md:text-[42px] font-light text-[#111] mb-8 tracking-wide">{{ 'privacy.title' | t }}</h1>

    <p class="text-[15px] text-[#111] leading-[1.65] mb-8">{{ 'privacy.intro' | t }}</p>

    <ol class="flex flex-col gap-7 list-none mb-8">

      <!-- 1. General Information -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">1. {{ 'privacy.general_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.general_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.general_item2' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.general_item3' | t }}</li>
        </ul>
      </li>

      <!-- 2. What Data We Collect -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">2. {{ 'privacy.collect_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65] mb-2 pl-4">{{ 'privacy.collect_intro' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.collect_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.collect_item2' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.collect_item3' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.collect_item4' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.collect_item5' | t }}</li>
        </ul>
      </li>

      <!-- 3. How We Use Your Data -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">3. {{ 'privacy.use_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.use_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.use_item2' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.use_item3' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.use_item4' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.use_item5' | t }}</li>
        </ul>
      </li>

      <!-- 4. Data Storage and Security -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">4. {{ 'privacy.storage_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.storage_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.storage_item2' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.storage_item3' | t }}</li>
        </ul>
      </li>

      <!-- 5. Data Sharing -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">5. {{ 'privacy.sharing_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.sharing_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.sharing_item2' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.sharing_item3' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.sharing_item4' | t }}</li>
        </ul>
      </li>

      <!-- 6. Cookies and Tracking -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">6. {{ 'privacy.cookies_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.cookies_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.cookies_item2' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.cookies_item3' | t }}</li>
        </ul>
      </li>

      <!-- 7. Your Rights -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">7. {{ 'privacy.rights_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65] mb-2 pl-4">{{ 'privacy.rights_intro' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.rights_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.rights_item2' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.rights_item3' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.rights_item4' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.rights_item5' | t }}</li>
        </ul>
      </li>

      <!-- 8. Children's Privacy -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">8. {{ 'privacy.children_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.children_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.children_item2' | t }}</li>
        </ul>
      </li>

      <!-- 9. Changes to Privacy Policy -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">9. {{ 'privacy.changes_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.changes_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.changes_item2' | t }}</li>
        </ul>
      </li>

      <!-- 10. Contact Us -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">10. {{ 'privacy.contact_title' | t }}</p>
        <ul class="flex flex-col gap-2 pl-4 list-disc">
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.contact_item1' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.contact_item2' | t }}</li>
        </ul>
      </li>

    </ol>

    <div class="mt-10 p-6 bg-[#f8f8f8] border-l-4 border-[#e61a7a]">
      <p class="text-[14px] text-[#666] leading-[1.65] mb-2">
        <strong>{{ 'privacy.last_updated' | t }}</strong>
      </p>
      <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.contact_info' | t }}</p>
      <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.contact_email' | t }}</p>
    </div>

  </div>
</div>
