{% schema %}
{
  "name": "Privacy Policy",
  "settings": []
}
{% endschema %}

<div class="w-full bg-white">
  <div class="max-w-[1280px] mx-auto px-5 md:px-[20px] pt-10 pb-16" style="font-family: Montserrat, sans-serif;">

    <h1 class="text-[32px] md:text-[42px] font-light text-[#111] mb-4 tracking-wide">{{ 'privacy.title' | t }}</h1>

    <p class="text-[15px] text-[#111] leading-[1.65] mb-8">{{ 'privacy.intro' | t }}</p>

    <ol class="flex flex-col gap-7 list-none mb-8">

      <!-- 1. Data We Collect -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">1. {{ 'privacy.data_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.data_text' | t }}</p>
      </li>

      <!-- 2. How We Use Your Data -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">2. {{ 'privacy.use_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65] mb-2">{{ 'privacy.use_text1' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.use_text2' | t }}</p>
      </li>

      <!-- 3. Cookies -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">3. {{ 'privacy.cookies_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65] mb-2">{{ 'privacy.cookies_text1' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.cookies_text2' | t }}</p>
      </li>

      <!-- 4. Data Storage and Security -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">4. {{ 'privacy.storage_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.storage_text' | t }}</p>
      </li>

      <!-- 5. Your Rights -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">5. {{ 'privacy.rights_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65] mb-2">{{ 'privacy.rights_text1' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.rights_text2' | t }}</p>
      </li>

      <!-- 6. Third-Party Services -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">6. {{ 'privacy.thirdparty_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65] mb-2">{{ 'privacy.thirdparty_text1' | t }}</p>
        <ul class="flex flex-col gap-1 pl-6 mb-2">
          <li class="text-[15px] text-[#111] leading-[1.65]">• {{ 'privacy.thirdparty_allpay' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">• {{ 'privacy.thirdparty_morning' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">• {{ 'privacy.thirdparty_delivery' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]">• {{ 'privacy.thirdparty_analytics' | t }}</li>
        </ul>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.thirdparty_text2' | t }}</p>
      </li>

      <!-- 7. Children -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">7. {{ 'privacy.children_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.children_text' | t }}</p>
      </li>

      <!-- 8. Changes to This Policy -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">8. {{ 'privacy.changes_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.changes_text' | t }}</p>
      </li>

      <!-- 9. Contact -->
      <li>
        <p class="text-[18px] font-bold text-[#111] mb-3">9. {{ 'privacy.contact_title' | t }}</p>
        <p class="text-[15px] text-[#111] leading-[1.65] mb-2">{{ 'privacy.contact_intro' | t }}</p>
        <ul class="flex flex-col gap-1 pl-4">
          <li class="text-[15px] text-[#111] leading-[1.65]"><strong>{{ 'privacy.email_label' | t }}</strong> {{ 'privacy.email_value' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]"><strong>{{ 'privacy.phone_label' | t }}</strong> {{ 'privacy.phone_value' | t }}</li>
          <li class="text-[15px] text-[#111] leading-[1.65]"><strong>{{ 'privacy.address_label' | t }}</strong> {{ 'privacy.address_value' | t }}</li>
        </ul>
      </li>

    </ol>

    <div class="mt-10 p-6 bg-[#f8f8f8] border-l-4 border-[#e61a7a]">
      <p class="text-[14px] text-[#666] leading-[1.65] mb-3">
        <strong>{{ 'privacy.last_updated' | t }}</strong>
      </p>
      <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.company_name' | t }}</p>
      <p class="text-[15px] text-[#111] leading-[1.65]">{{ 'privacy.contact_email' | t }}</p>
    </div>

  </div>
</div>
