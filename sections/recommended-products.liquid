{% schema %}
{
  "name": "Recommended Products",
  "settings": []
}
{% endschema %}

<style>
  .product-card-img {
    transition: transform 0.7s ease;
  }
  .product-card:hover .product-card-img {
    transform: scale(1.05);
  }
</style>

<section class="w-full px-4 md:px-12 lg:px-[160px]">
  <div class="text-center mb-[32px] md:mb-[48px] flex justify-center">
    <h2 
      class="text-[20px] md:text-[40px] font-light md:font-extralight text-black"
      style="font-family: var(--font-montserrat), Montserrat, sans-serif; line-height: 1.2;"
    >
      Recommended products
    </h2>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-6">

    <!-- Product 1 -->
    <a href="/products/leopard-print-scarf" class="product-card cursor-pointer flex flex-col group no-underline">
      <div class="relative aspect-[3/4] mb-4 overflow-hidden w-full bg-gray-100">
        <img 
          src="{{ 'product-image-1.png' | asset_url }}" 
          alt="Leopard Print Scarf" 
          class="product-card-img absolute inset-0 w-full h-full object-cover"
        />
      </div>
      <div class="flex flex-col space-y-1.5 px-1">
        <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors">Leopard Print Scarf</h3>
        <p class="text-[13px] text-gray-500 font-light">$ 80</p>
      </div>
    </a>

    <!-- Product 2 -->
    <a href="/products/blue-silk-scarf" class="product-card cursor-pointer flex flex-col group no-underline">
      <div class="relative aspect-[3/4] mb-4 overflow-hidden w-full bg-gray-100">
        <img 
          src="{{ 'product-image-2.png' | asset_url }}" 
          alt="Blue Silk Scarf" 
          class="product-card-img absolute inset-0 w-full h-full object-cover"
        />
      </div>
      <div class="flex flex-col space-y-1.5 px-1">
        <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors">Blue Silk Scarf</h3>
        <p class="text-[13px] text-gray-500 font-light">$ 80</p>
      </div>
    </a>

    <!-- Product 3 -->
    <a href="/products/pink-scarf" class="product-card cursor-pointer flex flex-col group no-underline">
      <div class="relative aspect-[3/4] mb-4 overflow-hidden w-full bg-gray-100">
        <img 
          src="{{ 'product-image-3.png' | asset_url }}" 
          alt="Pink Scarf" 
          class="product-card-img absolute inset-0 w-full h-full object-cover"
        />
      </div>
      <div class="flex flex-col space-y-1.5 px-1">
        <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors">Pink Scarf</h3>
        <p class="text-[13px] text-gray-500 font-light">$ 80</p>
      </div>
    </a>

    <!-- Product 4 -->
    <a href="/products/vintage-scarf" class="product-card cursor-pointer flex flex-col group no-underline">
      <div class="relative aspect-[3/4] mb-4 overflow-hidden w-full bg-gray-100">
        <img 
          src="{{ 'product-image-4.png' | asset_url }}" 
          alt="Vintage Scarf" 
          class="product-card-img absolute inset-0 w-full h-full object-cover"
        />
      </div>
      <div class="flex flex-col space-y-1.5 px-1">
        <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors">Vintage Scarf</h3>
        <p class="text-[13px] text-gray-500 font-light">$ 80</p>
      </div>
    </a>

  </div>
</section>
