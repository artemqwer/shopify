        <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide">Blue Silk Scarf</h3>
        <p class="text-[13px] text-gray-500 font-light">$ 80</p>
      </div>
    </div>
    
    <!-- Product 3 -->
