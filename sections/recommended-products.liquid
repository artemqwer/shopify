{% schema %}
{
  "name": "Recommended Products",
  "settings": []
}
{% endschema %}

<style>
  .product-card-img {
    transition: transform 0.7s ease;
  }
  .product-card:hover .product-card-img {
    transform: scale(1.05);
  }
</style>

<section class="max-w-[1280px] mx-auto px-5 md:px-[20px] pb-[30px] pt-10">
  <div class="h-[40px] hidden md:block"></div>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-[12px] gap-y-[32px] md:gap-x-6 md:gap-y-8" id="rec-products-container">
    {% comment %}
    ════════════════════════════════════════════════════════
    REAL MODE: When the store has actual products, 
    Shopify's product_recommendations API will inject
    real products. The section will render them automatically.
    ════════════════════════════════════════════════════════
    {% endcomment %}

    {% if recommendations.performed and recommendations.products.size > 0 %}

      {% for rec in recommendations.products %}
        <a href="{{ rec.url }}" class="product-card cursor-pointer flex flex-col group no-underline">
          <div class="relative aspect-[3/4] mb-4 overflow-hidden w-full bg-gray-100">
            {% if rec.featured_image %}
              <img
                src="{{ rec.featured_image | image_url: width: 600 }}"
                alt="{{ rec.featured_image.alt | default: rec.title | escape }}"
                class="product-card-img absolute inset-0 w-full h-full object-cover"
                loading="lazy"
              />
            {% else %}
              {% assign fb = forloop.index0 | modulo: 4 | plus: 1 %}
              <img
                src="{{ 'product-image-' | append: fb | append: '.png' | asset_url }}"
                alt="{{ rec.title | escape }}"
                class="product-card-img absolute inset-0 w-full h-full object-cover"
                loading="lazy"
              />
            {% endif %}
          </div>
          <div class="flex flex-col space-y-1.5 px-1" {% if request.locale.iso_code == 'he' %}dir="rtl" style="text-align: right;"{% endif %}>
            <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors whitespace-nowrap overflow-hidden text-ellipsis"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              {{ rec.title }}
            </h3>
            <p class="text-[13px] text-gray-500 font-light" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
              {{ rec.price | money }}
            </p>
          </div>
        </a>
      {% endfor %}

    {% elsif product.id %}
      {% comment %}
      ════════════════════════════════════════════════════════
      TRANSITIONAL: On a real product page. Use JS to load 
      real data and replace demo placeholders.
      ════════════════════════════════════════════════════════
      {% endcomment %}
      <div class="rec-products-inner contents">
        {% comment %} DEMO FALLBACK {% endcomment %}
        {% assign demo_names = "products.product_1,products.product_2,products.product_3,products.product_4" | split: "," %}
        {% assign demo_imgs  = "product-image-1.png,product-image-2.png,product-image-3.png,product-image-4.png" | split: "," %}
        {% for i in (0..3) %}
          <div class="product-card cursor-pointer flex flex-col group no-underline" data-demo-card>
            <div class="relative aspect-[3/4] mb-4 overflow-hidden w-full bg-gray-100">
              <img src="{{ demo_imgs[i] | asset_url }}" alt="{{ demo_names[i] | t }}"
                   class="product-card-img absolute inset-0 w-full h-full object-cover" loading="lazy"/>
            </div>
            <div class="flex flex-col space-y-1.5 px-1" {% if request.locale.iso_code == 'he' %}dir="rtl" style="text-align:right;"{% endif %}>
              <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors"
                  style="font-family: 'Montserrat', sans-serif;">{{ demo_names[i] | t }}</h3>
              <p class="text-[13px] text-gray-500 font-light" style="font-family: 'Montserrat', sans-serif;">$ 80</p>
            </div>
          </div>
        {% endfor %}
      </div>

      <script>
      (function() {
        const productId = {{ product.id | json }};
        const locale    = '{{ request.locale.iso_code }}';
        
        // Find the closest inner container to this script
        const script = document.currentScript;
        const inner  = script ? script.previousElementSibling : null;
        if (!productId || !inner) return;
        
        const isHe = locale === 'he';
        const priceFormatter = new Intl.NumberFormat(locale === 'he' ? 'he-IL' : 'en-US', {
          style: 'currency',
          currency: '{{ cart.currency.iso_code }}',
          minimumFractionDigits: 0
        });

        function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

        function renderProducts(products) {
          inner.innerHTML = products.map(p => {
            let imgUrl = '';
            if (typeof p.featured_image === 'string') { imgUrl = p.featured_image; }
            else if (p.featured_image && p.featured_image.url) { imgUrl = p.featured_image.url; }
            else if (p.images && p.images.length > 0) { imgUrl = typeof p.images[0] === 'string' ? p.images[0] : (p.images[0].src || p.images[0].url || ''); }
            
            if (imgUrl) imgUrl = imgUrl.replace('http:', 'https:').replace(/_[a-z0-9]+\.(jpg|png|webp)/i, '.$1');

            const price = priceFormatter.format(p.price / 100);
            const safeTitle = esc(p.title || p.heading || '');
            const safeUrl = esc(p.url || (p.handle ? `/products/${p.handle}` : ''));
            
            return `<a href="${safeUrl}" class="product-card cursor-pointer flex flex-col group no-underline animate-fade-in opacity-0" style="animation: fadeIn 0.8s forwards;">
              <div class="relative aspect-[3/4] mb-4 overflow-hidden w-full bg-gray-100">
                ${imgUrl ? `<img src="${esc(imgUrl)}&width=600" alt="${safeTitle}" class="product-card-img absolute inset-0 w-full h-full object-cover" loading="lazy"/>` : ''}
              </div>
              <div class="flex flex-col space-y-1.5 px-1" ${isHe ? 'dir="rtl" style="text-align:right;"' : ''}>
                <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors whitespace-nowrap overflow-hidden text-ellipsis"
                    style="font-family: 'Montserrat', sans-serif;">${safeTitle}</h3>
                <p class="text-[13px] text-gray-500 font-light" style="font-family: 'Montserrat', sans-serif;">${price}</p>
              </div>
            </a>`;
          }).join('');
        }

        const shopifyRoot = window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/';
        const cleanRoot   = shopifyRoot.endsWith('/') ? shopifyRoot : shopifyRoot + '/';
        const timestamp   = Date.now();
        
        fetch(`${cleanRoot}recommendations/products.json?product_id=${productId}&limit=4&t=${timestamp}`)
          .then(r => r.ok ? r.json() : null)
          .then(data => {
            if (data && data.products && data.products.length > 0) {
              renderProducts(data.products);
            } else {
              fetch(`${cleanRoot}collections/all/products.json?limit=4&t=${timestamp}`)
                .then(r => r.ok ? r.json() : null)
                .then(fallData => {
                  if (fallData && fallData.products && fallData.products.length > 0) {
                    renderProducts(fallData.products);
                  }
                });
            }
          })
          .catch(e => console.error('Recs error:', e));
      })();
      </script>
      <style>
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
      </style>

    {% else %}
      {% comment %}
      ════════════════════════════════════════════════════════
      DEMO MODE: No real products exist yet.
      Shows 4 placeholder product cards.
      Replace these with real products by adding items to
      Shopify Admin → Products → Collections.
      ════════════════════════════════════════════════════════
      {% endcomment %}
      {% assign demo_names = "products.product_1,products.product_2,products.product_3,products.product_4" | split: "," %}
      {% assign demo_imgs  = "product-image-1.png,product-image-2.png,product-image-3.png,product-image-4.png" | split: "," %}
      {% assign demo_slugs = "leopard-print-scarf,blue-silk-scarf,pink-scarf,vintage-scarf" | split: "," %}

      {% for i in (0..3) %}
        <a href="{{ routes.search_url }}?view=demo&product={{ demo_slugs[i] }}"
           class="product-card cursor-pointer flex flex-col group no-underline">
          <div class="relative aspect-[3/4] mb-4 overflow-hidden w-full bg-gray-100">
            <img
              src="{{ demo_imgs[i] | asset_url }}"
              alt="{{ demo_names[i] | t }}"
              class="product-card-img absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col space-y-1.5 px-1" {% if request.locale.iso_code == 'he' %}dir="rtl" style="text-align: right;"{% endif %}>
            <h3 class="text-[13px] font-semibold text-gray-900 tracking-wide group-hover:text-gray-500 transition-colors"
                style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ demo_names[i] | t }}</h3>
            <p class="text-[13px] text-gray-500 font-light" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">$ 80</p>
          </div>
        </a>
      {% endfor %}

    {% endif %}

  </div>


</section>
