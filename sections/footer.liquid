{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}

<style>
  /* Mobile accordion chevron animation */
  details summary svg {
    transition: transform 0.3s ease;
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary::marker {
    display: none;
  }
</style>

<footer class="bg-white shrink-0 border-[#F5F5F5] pt-10 md:pt-[44px] pb-[19px] md:h-[224px] flex flex-col justify-between relative w-full">

  <!-- DESKTOP FOOTER -->
  <div class="hidden md:flex w-full max-w-[1920px] mx-auto px-4 md:px-12 lg:px-[160px] relative h-full flex-col justify-between">
    <div class="flex flex-col md:flex-row justify-between items-start">

      <!-- Columns Container -->
      <div class="flex flex-col md:flex-row gap-8 lg:gap-[60px] w-full md:w-auto">

        <!-- Navigation Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.navigation' | t }}</h3>
          <ul class="space-y-[24px]">
            <li><a href="{{ routes.root_url }}" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.home' | t }}</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.catalog' | t }}</a></li>
            <li><a href="{{ routes.search_url }}?view=popular" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.popular' | t }}</a></li>
            <li><a href="{{ routes.root_url }}pages/about-us" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.about' | t }}</a></li>
            <li><a href="{{ routes.root_url }}pages/contacts" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.contacts_page' | t }}</a></li>
          </ul>
        </div>

        <!-- Contacts Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.contacts' | t }}</h3>
          <ul class="space-y-[24px]">
            <li><a href="tel:+383457895" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.phone' | t }}</a></li>
            <li><a href="mailto:info@hoops.com.ua" class="text-[13px] font-normal text-black underline underline-offset-4 decoration-black/20 hover:decoration-black transition-colors">{{ 'footer.email' | t }}</a></li>
            <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.instagram' | t }}</a></li>
          </ul>
        </div>

        <!-- Legal Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.legal' | t }}</h3>
          <ul class="space-y-[24px]">
            <li><a href="{{ routes.root_url }}pages/public-offer" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.public_offer' | t }}</a></li>
            <li><a href="{{ routes.root_url }}pages/privacy" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.privacy' | t }}</a></li>
            <li><a href="{{ routes.root_url }}pages/shipping-payment" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.shipping' | t }}</a></li>
            <li><a href="{{ routes.root_url }}pages/returns" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.returns' | t }}</a></li>
          </ul>
        </div>
      </div>

      <!-- Payment Methods Desktop -->
      <div class="mt-8 md:mt-0 flex items-center justify-end pointer-events-none" style="gap: 34px;">
        <img
          src="{{ 'apple-pay.svg' | asset_url }}"
          alt="Apple Pay"
          width="56"
          height="28"
          class="h-[28px] w-auto object-contain"
          loading="lazy"
        />
        <img
          src="{{ 'mastercard.svg' | asset_url }}"
          alt="Mastercard"
          width="65" height="39"
          class="w-[65px] h-[39px] object-contain"
          loading="lazy"
        />
        <img
          src="{{ 'googlePay.svg' | asset_url }}"
          alt="Google Pay"
          width="71" height="28"
          class="w-[71px] h-[28px] object-contain"
          loading="lazy"
        />
        <img
          src="{{ 'visa.svg' | asset_url }}"
          alt="Visa"
          width="68" height="21"
          class="w-[68px] h-[21px] object-contain"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Copyright Desktop -->
    <div class="text-center md:absolute w-full left-0 md:top-[204px] pt-[19px] pb-[19px] mt-auto md:p-0 border-t border-[#F5F5F5] md:border-t-0 pointer-events-none">
      <p
        class="text-[11px] font-light tracking-widest text-black uppercase leading-none"
        style="font-family: var(--font-montserrat), Montserrat, sans-serif; direction: ltr; text-align: center;"
      >
        {{ 'footer.copyright' | t }}
      </p>
    </div>
  </div>

  <!-- MOBILE FOOTER -->
  <div class="flex flex-col md:hidden w-full px-5 pb-10 pt-10 items-start rtl:items-end text-left rtl:text-right">

    <!-- Contacts -->
    <div class="flex flex-col gap-[24px] mb-[40px]">
      <a href="tel:+383457895" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.phone' | t }}</a>
      <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.instagram' | t }}</a>
      <a href="mailto:ESTERWUGMAN@gmail.com" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.email' | t }}</a>
    </div>

    <!-- Navigation Links -->
    <ul class="flex flex-col gap-[24px] mb-[40px]">
      <li><a href="{{ routes.root_url }}" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.home' | t }}</a></li>
      <li><a href="{{ routes.all_products_collection_url }}" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.catalog' | t }}</a></li>
      <li><a href="{{ routes.root_url }}pages/about-us" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.about' | t }}</a></li>
      <li><a href="{{ routes.root_url }}pages/contacts" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.contacts_page' | t }}</a></li>
      <li><a href="{{ routes.root_url }}pages/public-offer" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.public_offer' | t }}</a></li>
      <li><a href="{{ routes.root_url }}pages/privacy" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.privacy' | t }}</a></li>
      <li><a href="{{ routes.root_url }}pages/shipping-payment" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.shipping' | t }}</a></li>
      <li><a href="{{ routes.root_url }}pages/returns" class="text-[15px] font-normal text-black" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.returns' | t }}</a></li>
    </ul>

    <!-- Language Selector Accordion -->
    <div class="mb-[40px] w-full">
      {% form 'localization', class: 'flex flex-col items-start rtl:items-end' %}
        <div class="relative inline-block w-full">
          <button type="button"
                  onclick="(function(){var list=document.getElementById('footer-lang-list');var caret=document.getElementById('footer-lang-caret');var isOpen=!list.classList.contains('hidden');list.classList.toggle('hidden',isOpen);caret.style.transform=isOpen?'':'rotate(180deg)';})()"
                  class="flex items-center gap-2 text-[15px] uppercase font-medium text-[#e61a7a] focus:outline-none"
                  style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
            {% case request.locale.iso_code %}
              {% when 'en' %}ENG
              {% when 'uk' %}UA
              {% when 'fr' %}FR
              {% when 'he' %}עב
            {% endcase %}
            <svg id="footer-lang-caret" class="w-3 h-3 transition-transform duration-200" fill="none" viewBox="0 0 10 6">
              <path d="M1 5L5 1L9 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          
          <div id="footer-lang-list" class="flex flex-col items-start rtl:items-end gap-[24px] mt-[24px] hidden">
            {% if request.locale.iso_code != 'uk' %}
              <button type="submit" name="locale_code" value="uk" class="text-[15px] uppercase font-medium text-black/40 hover:text-black transition-colors" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">UA</button>
            {% endif %}
            {% if request.locale.iso_code != 'en' %}
              <button type="submit" name="locale_code" value="en" class="text-[15px] uppercase font-medium text-black/40 hover:text-black transition-colors" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">ENG</button>
            {% endif %}
            {% if request.locale.iso_code != 'fr' %}
              <button type="submit" name="locale_code" value="fr" class="text-[15px] uppercase font-medium text-black/40 hover:text-black transition-colors" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">FR</button>
            {% endif %}
            {% if request.locale.iso_code != 'he' %}
              <button type="submit" name="locale_code" value="he" class="text-[17px] font-medium text-black/40 hover:text-black transition-colors">עב</button>
            {% endif %}
          </div>
        </div>
      {% endform %}
    </div>

    <!-- Copyright and Payments -->
    <div class="flex flex-col items-center gap-[12px] pt-8 w-full border-t border-[#F5F5F5]">
      <p class="text-[10px] font-light tracking-[0.05em] text-[#999] uppercase" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
        {{ 'footer.copyright' | t }}
      </p>
      <div class="flex items-center justify-center gap-5 scale-90">
        <img src="{{ 'apple-pay.svg' | asset_url }}" alt="Apple Pay" width="34" height="14" class="h-[14px] w-auto object-contain" />
        <img src="{{ 'mastercard.svg' | asset_url }}" alt="Mastercard" width="28" height="16" class="h-[16px] w-auto object-contain" />
        <img src="{{ 'googlePay.svg' | asset_url }}" alt="Google Pay" width="34" height="14" class="h-[14px] w-auto object-contain" />
        <img src="{{ 'visa.svg' | asset_url }}" alt="Visa" width="30" height="10" class="h-[10px] w-auto object-contain" />
      </div>
    </div>
  </div>
</footer>
