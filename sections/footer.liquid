{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}

<footer class="bg-white shrink-0 border-[#F5F5F5] pt-10 md:pt-[44px] pb-[19px] md:h-[224px] flex flex-col justify-between relative z-50 w-full">
  <!-- Absolute top border that enforces the Figma structure without messing up internal text padding -->
  <div class="absolute top-0 left-0 w-full h-[1px] bg-[#F5F5F5] pointer-events-none"></div>
  
  <!-- DESKTOP FOOTER (STRICTLY PRESERVED) -->
  <div class="hidden md:flex w-full max-w-[1920px] mx-auto px-4 md:px-12 lg:px-[160px] relative h-full flex-col justify-between">
    <div class="flex flex-col md:flex-row justify-between items-start mb-0 md:mb-0">
      
      <!-- Columns Container -->
      <div class="flex flex-col md:flex-row gap-8 lg:gap-[60px] w-full md:w-auto">
        
        <!-- Navigation Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">NAVIGATION</h3>
          <ul class="space-y-[24px]">
            <li><a href="/" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">Home</a></li>
            <li><a href="/catalog" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">Catalog</a></li>
            <li><a href="/popular" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">Popular</a></li>
            <li><a href="/about" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">About us</a></li>
          </ul>
        </div>
        
        <!-- Contacts Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">CONTACTS</h3>
          <ul class="space-y-[24px]">
            <li><a href="tel:+383457895" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">+38 (345) 78 95</a></li>
            <li><a href="mailto:info@hoops.com.ua" class="text-[13px] font-normal text-black underline underline-offset-4 decoration-black/20 hover:decoration-black transition-colors">info@hoops.com.ua</a></li>
            <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">Instagram</a></li>
          </ul>
        </div>
        
        <!-- Legal Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">LEGAL</h3>
          <ul class="space-y-[24px]">
            <li><a href="/public-offer" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">Public Offer</a></li>
            <li><a href="/privacy" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">Privacy Policy</a></li>
            <li><a href="/shipping" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">Shipping &amp; Payment</a></li>
          </ul>
        </div>
      </div>

      <!-- Payment Methods Desktop - Exact Positioning -->
      <div class="mt-8 md:mt-0 md:absolute md:left-[1027.6px] md:right-[300px] top-0 flex justify-center pointer-events-none">
        <img 
          src="{{ 'pay.png' | asset_url }}" 
          alt="Payment Methods" 
          width="272"
          height="39"
          class="w-[272px] h-[39px] object-contain"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Copyright -->
    <div class="text-center md:absolute w-full left-0 md:top-[204px] pt-[19px] pb-[19px] mt-auto md:p-0 border-t border-[#F5F5F5] md:border-t-0 pointer-events-none">
      <p 
        class="text-[11px] font-light tracking-widest text-black uppercase leading-none"
        style="font-family: var(--font-montserrat), Montserrat, sans-serif;"
      >
        © 2026 ESTER WUGMAN
      </p>
    </div>
  </div>

  <!-- MOBILE FOOTER (ONLY VISIBLE ON PHONES) -->
  <div class="flex flex-col md:hidden w-full px-4 relative pb-4">
    <div class="flex flex-col gap-6 w-full">
      
      <!-- NAVIGATION Accordion -->
      <details class="w-full group pb-6 border-b border-[#F5F5F5]">
        <summary class="cursor-pointer list-none flex justify-between items-center text-left text-black uppercase mb-0 marker:hidden">
          <span style="font-family: var(--font-montserrat), Montserrat, sans-serif;" class="font-medium tracking-widest text-[11px] text-gray-400">NAVIGATION</span>
          <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="pt-6">
          <ul class="space-y-[20px]">
            <li><a href="/" class="text-[13px] font-normal text-black">Home</a></li>
            <li><a href="/catalog" class="text-[13px] font-normal text-black">Catalog</a></li>
            <li><a href="/popular" class="text-[13px] font-normal text-black">Popular</a></li>
            <li><a href="/about" class="text-[13px] font-normal text-black">About us</a></li>
          </ul>
        </div>
      </details>

      <!-- CONTACTS Accordion -->
      <details class="w-full group pb-6 border-b border-[#F5F5F5]">
        <summary class="cursor-pointer list-none flex justify-between items-center text-left text-black uppercase mb-0 marker:hidden">
          <span style="font-family: var(--font-montserrat), Montserrat, sans-serif;" class="font-medium tracking-widest text-[11px] text-gray-400">CONTACTS</span>
          <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="pt-6">
          <ul class="space-y-[20px]">
            <li><a href="tel:+383457895" class="text-[13px] font-normal text-black">+38 (345) 78 95</a></li>
            <li><a href="mailto:info@hoops.com.ua" class="text-[13px] font-normal text-black underline underline-offset-4 decoration-black/20">info@hoops.com.ua</a></li>
            <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-[13px] font-normal text-black">Instagram</a></li>
          </ul>
        </div>
      </details>

      <!-- LEGAL Accordion -->
      <details class="w-full group">
        <summary class="cursor-pointer list-none flex justify-between items-center text-left text-black uppercase mb-0 marker:hidden">
          <span style="font-family: var(--font-montserrat), Montserrat, sans-serif;" class="font-medium tracking-widest text-[11px] text-gray-400">LEGAL</span>
          <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="pt-6">
          <ul class="space-y-[20px]">
            <li><a href="/public-offer" class="text-[13px] font-normal text-black">Public Offer</a></li>
            <li><a href="/privacy" class="text-[13px] font-normal text-black">Privacy Policy</a></li>
            <li><a href="/shipping" class="text-[13px] font-normal text-black">Shipping &amp; Payment</a></li>
          </ul>
        </div>
      </details>
      
    </div>

    <!-- Payment Methods Mobile - Centered -->
    <div class="mt-[48px] mb-[64px] flex justify-center w-full">
      <img 
        src="{{ 'pay.png' | asset_url }}" 
        alt="Payment Methods" 
        class="w-[272px] h-[39px] object-contain"
      />
    </div>

    <!-- Copyright Mobile -->
    <div class="text-center w-full">
      <p 
        class="text-[10px] font-light tracking-widest text-black uppercase"
        style="font-family: var(--font-montserrat), Montserrat, sans-serif;"
      >
        © 2026 ESTER WUGMAN
      </p>
    </div>
  </div>
</footer>
