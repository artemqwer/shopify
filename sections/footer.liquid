{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}

<style>
  /* Mobile accordion chevron animation */
  details summary svg {
    transition: transform 0.3s ease;
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary::marker {
    display: none;
  }
</style>

<footer class="bg-white shrink-0 border-[#F5F5F5] pt-10 md:pt-[44px] pb-[19px] md:h-[224px] flex flex-col justify-between relative z-50 w-full">
  <!-- Absolute top border -->
  <div class="absolute top-0 left-0 w-full h-[1px] bg-[#F5F5F5] pointer-events-none"></div>

  <!-- DESKTOP FOOTER -->
  <div class="hidden md:flex w-full max-w-[1920px] mx-auto px-4 md:px-12 lg:px-[160px] relative h-full flex-col justify-between">
    <div class="flex flex-col md:flex-row justify-between items-start">

      <!-- Columns Container -->
      <div class="flex flex-col md:flex-row gap-8 lg:gap-[60px] w-full md:w-auto">

        <!-- Navigation Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.navigation' | t }}</h3>
          <ul class="space-y-[24px]">
            <li><a href="/" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.home' | t }}</a></li>
            <li><a href="/catalog" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.catalog' | t }}</a></li>
            <li><a href="/popular" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.popular' | t }}</a></li>
            <li><a href="/about" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.about' | t }}</a></li>
          </ul>
        </div>

        <!-- Contacts Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.contacts' | t }}</h3>
          <ul class="space-y-[24px]">
            <li><a href="tel:+383457895" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.phone' | t }}</a></li>
            <li><a href="mailto:info@hoops.com.ua" class="text-[13px] font-normal text-black underline underline-offset-4 decoration-black/20 hover:decoration-black transition-colors">{{ 'footer.email' | t }}</a></li>
            <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.instagram' | t }}</a></li>
          </ul>
        </div>

        <!-- Legal Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.legal' | t }}</h3>
          <ul class="space-y-[24px]">
            <li><a href="/public-offer" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.public_offer' | t }}</a></li>
            <li><a href="/privacy" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.privacy' | t }}</a></li>
            <li><a href="/shipping" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.shipping' | t }}</a></li>
          </ul>
        </div>
      </div>

      <!-- Payment Methods Desktop -->
      <div class="mt-8 md:mt-0 md:absolute top-0 flex justify-center pointer-events-none"
        style="{% if request.locale.iso_code == 'he' %}right: 1027.6px; left: auto;{% else %}left: 1027.6px; right: 300px;{% endif %}">
        <img
          src="{{ 'pay.png' | asset_url }}"
          alt="Payment Methods"
          width="272"
          height="39"
          class="w-[272px] h-[39px] object-contain"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Copyright Desktop -->
    <div class="text-center md:absolute w-full left-0 md:top-[204px] pt-[19px] pb-[19px] mt-auto md:p-0 border-t border-[#F5F5F5] md:border-t-0 pointer-events-none">
      <p
        class="text-[11px] font-light tracking-widest text-black uppercase leading-none"
        style="font-family: var(--font-montserrat), Montserrat, sans-serif; direction: ltr; text-align: center;"
      >
        {{ 'footer.copyright' | t }}
      </p>
    </div>
  </div>

  <!-- MOBILE FOOTER -->
  <div class="flex flex-col md:hidden w-full px-4 relative pb-4">
    <div class="flex flex-col gap-6 w-full">

      <!-- NAVIGATION Accordion -->
      <details class="w-full group pb-6 border-b border-[#F5F5F5]">
        <summary class="cursor-pointer list-none flex justify-between items-center text-left text-black uppercase mb-0 marker:hidden">
          <span style="font-family: var(--font-montserrat), Montserrat, sans-serif;" class="font-medium tracking-widest text-[11px] text-gray-400">{{ 'footer.navigation' | t }}</span>
          <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="pt-6">
          <ul class="space-y-[20px]">
            <li><a href="/" class="text-[13px] font-normal text-black">{{ 'footer.home' | t }}</a></li>
            <li><a href="/catalog" class="text-[13px] font-normal text-black">{{ 'footer.catalog' | t }}</a></li>
            <li><a href="/popular" class="text-[13px] font-normal text-black">{{ 'footer.popular' | t }}</a></li>
            <li><a href="/about" class="text-[13px] font-normal text-black">{{ 'footer.about' | t }}</a></li>
          </ul>
        </div>
      </details>

      <!-- CONTACTS Accordion -->
      <details class="w-full group pb-6 border-b border-[#F5F5F5]">
        <summary class="cursor-pointer list-none flex justify-between items-center text-left text-black uppercase mb-0 marker:hidden">
          <span style="font-family: var(--font-montserrat), Montserrat, sans-serif;" class="font-medium tracking-widest text-[11px] text-gray-400">{{ 'footer.contacts' | t }}</span>
          <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="pt-6">
          <ul class="space-y-[20px]">
            <li><a href="tel:+383457895" class="text-[13px] font-normal text-black">{{ 'footer.phone' | t }}</a></li>
            <li><a href="mailto:info@hoops.com.ua" class="text-[13px] font-normal text-black underline underline-offset-4 decoration-black/20">{{ 'footer.email' | t }}</a></li>
            <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-[13px] font-normal text-black">{{ 'footer.instagram' | t }}</a></li>
          </ul>
        </div>
      </details>

      <!-- LEGAL Accordion -->
      <details class="w-full group">
        <summary class="cursor-pointer list-none flex justify-between items-center text-left text-black uppercase mb-0 marker:hidden">
          <span style="font-family: var(--font-montserrat), Montserrat, sans-serif;" class="font-medium tracking-widest text-[11px] text-gray-400">{{ 'footer.legal' | t }}</span>
          <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="pt-6">
          <ul class="space-y-[20px]">
            <li><a href="/public-offer" class="text-[13px] font-normal text-black">{{ 'footer.public_offer' | t }}</a></li>
            <li><a href="/privacy" class="text-[13px] font-normal text-black">{{ 'footer.privacy' | t }}</a></li>
            <li><a href="/shipping" class="text-[13px] font-normal text-black">{{ 'footer.shipping' | t }}</a></li>
          </ul>
        </div>
      </details>

    </div>

    <!-- Payment Methods Mobile -->
    <div class="mt-[48px] mb-[64px] flex justify-center w-full">
      <img
        src="{{ 'pay.png' | asset_url }}"
        alt="Payment Methods"
        class="w-[272px] h-[39px] object-contain"
      />
    </div>

    <!-- Copyright Mobile -->
    <div class="text-center w-full">
      <p
        class="text-[10px] font-light tracking-widest text-black uppercase"
        style="font-family: var(--font-montserrat), Montserrat, sans-serif; direction: ltr; text-align: center;"
      >
        {{ 'footer.copyright' | t }}
      </p>
    </div>
  </div>
</footer>
