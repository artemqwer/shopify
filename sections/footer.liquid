{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}

<style>
  /* Mobile accordion chevron animation */
  details summary svg {
    transition: transform 0.3s ease;
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary::marker {
    display: none;
  }
</style>

<footer class="bg-white shrink-0 border-[#F5F5F5] pt-10 md:pt-[44px] pb-[19px] md:h-[224px] flex flex-col justify-between relative z-50 w-full">
  <!-- Absolute top border -->
  <div class="absolute top-0 left-0 w-full h-[1px] bg-[#F5F5F5] pointer-events-none"></div>

  <!-- DESKTOP FOOTER -->
  <div class="hidden md:flex w-full max-w-[1920px] mx-auto px-4 md:px-12 lg:px-[160px] relative h-full flex-col justify-between">
    <div class="flex flex-col md:flex-row justify-between items-start">

      <!-- Columns Container -->
      <div class="flex flex-col md:flex-row gap-8 lg:gap-[60px] w-full md:w-auto">

        <!-- Navigation Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.navigation' | t }}</h3>
          <ul class="space-y-[24px]">
            <li><a href="{{ routes.root_url }}" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.home' | t }}</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.catalog' | t }}</a></li>
            <li><a href="{{ routes.search_url }}?view=popular" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.popular' | t }}</a></li>
            <li><a href="{{ routes.root_url }}about" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.about' | t }}</a></li>
          </ul>
        </div>

        <!-- Contacts Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.contacts' | t }}</h3>
          <ul class="space-y-[24px]">
            <li><a href="tel:+383457895" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.phone' | t }}</a></li>
            <li><a href="mailto:info@hoops.com.ua" class="text-[13px] font-normal text-black underline underline-offset-4 decoration-black/20 hover:decoration-black transition-colors">{{ 'footer.email' | t }}</a></li>
            <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.instagram' | t }}</a></li>
          </ul>
        </div>

        <!-- Legal Column -->
        <div class="w-full md:w-[240px]">
          <h3 class="text-gray-400 text-[11px] font-medium tracking-widest uppercase mb-[24px]" style="font-family: var(--font-montserrat), Montserrat, sans-serif;">{{ 'footer.legal' | t }}</h3>
          <ul class="space-y-[24px]">
            <li><a href="{{ routes.root_url }}public-offer" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.public_offer' | t }}</a></li>
            <li><a href="{{ routes.root_url }}privacy" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.privacy' | t }}</a></li>
            <li><a href="{{ routes.root_url }}shipping" class="text-[13px] font-normal text-black hover:text-gray-500 transition-colors">{{ 'footer.shipping' | t }}</a></li>
          </ul>
        </div>
      </div>

      <!-- Payment Methods Desktop -->
      <div class="mt-8 md:mt-0 flex items-center justify-end pointer-events-none" style="gap: 34px;">
        <img
          src="{{ 'apple-pay.svg' | asset_url }}"
          alt="Apple Pay"
          width="56"
          height="28"
          class="h-[28px] w-auto object-contain"
          loading="lazy"
        />
        <img
          src="{{ 'mastercard.svg' | asset_url }}"
          alt="Mastercard"
          width="65" height="39"
          class="w-[65px] h-[39px] object-contain"
          loading="lazy"
        />
        <img
          src="{{ 'googlePay.svg' | asset_url }}"
          alt="Google Pay"
          width="71" height="28"
          class="w-[71px] h-[28px] object-contain"
          loading="lazy"
        />
        <img
          src="{{ 'visa.svg' | asset_url }}"
          alt="Visa"
          width="68" height="21"
          class="w-[68px] h-[21px] object-contain"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Copyright Desktop -->
    <div class="text-center md:absolute w-full left-0 md:top-[204px] pt-[19px] pb-[19px] mt-auto md:p-0 border-t border-[#F5F5F5] md:border-t-0 pointer-events-none">
      <p
        class="text-[11px] font-light tracking-widest text-black uppercase leading-none"
        style="font-family: var(--font-montserrat), Montserrat, sans-serif; direction: ltr; text-align: center;"
      >
        {{ 'footer.copyright' | t }}
      </p>
    </div>
  </div>

  <!-- MOBILE FOOTER -->
  <div class="flex flex-col md:hidden w-full px-5 relative pb-6 pt-2">

    <!-- Flat links list as per reference -->
    <ul class="flex flex-col gap-0 w-full">
      <!-- Phone -->
      <li class="border-b border-[#F5F5F5] py-[14px]">
        <a href="tel:+383457895" class="text-[13px] font-normal text-black">{{ 'footer.phone' | t }}</a>
      </li>
      <!-- Instagram -->
      <li class="border-b border-[#F5F5F5] py-[14px]">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-[13px] font-normal text-black">{{ 'footer.instagram' | t }}</a>
      </li>
      <!-- Catalog -->
      <li class="border-b border-[#F5F5F5] py-[14px]">
        <a href="{{ routes.all_products_collection_url }}" class="text-[13px] font-normal text-black">{{ 'footer.catalog' | t }}</a>
      </li>
      <!-- About Us -->
      <li class="border-b border-[#F5F5F5] py-[14px]">
        <a href="{{ routes.root_url }}about" class="text-[13px] font-normal text-black">{{ 'footer.about' | t }}</a>
      </li>
      <!-- Public Offer -->
      <li class="border-b border-[#F5F5F5] py-[14px]">
        <a href="{{ routes.root_url }}public-offer" class="text-[13px] font-normal text-black">{{ 'footer.public_offer' | t }}</a>
      </li>
      <!-- Privacy Policy -->
      <li class="border-b border-[#F5F5F5] py-[14px]">
        <a href="{{ routes.root_url }}privacy" class="text-[13px] font-normal text-black">{{ 'footer.privacy' | t }}</a>
      </li>
      <!-- Shipping & Payment -->
      <li class="border-b border-[#F5F5F5] py-[14px]">
        <a href="{{ routes.root_url }}shipping" class="text-[13px] font-normal text-black">{{ 'footer.shipping' | t }}</a>
      </li>
    </ul>

    <!-- Language Switcher -->
    <div class="mt-[20px] mb-[6px]">
      {% form 'localization', class: 'flex items-center gap-6' %}
        <button type="submit" name="locale_code" value="en"
                class="text-[13px] tracking-widest uppercase font-medium leading-none
                       {% if request.locale.iso_code == 'en' %}text-[#e61a7a]{% else %}text-gray-800 hover:text-[#e61a7a]{% endif %}">
          EN
        </button>
        <button type="submit" name="locale_code" value="uk"
                class="text-[13px] tracking-widest uppercase font-medium leading-none
                       {% if request.locale.iso_code == 'uk' %}text-[#e61a7a]{% else %}text-gray-800 hover:text-[#e61a7a]{% endif %}">
          UA
        </button>
        <button type="submit" name="locale_code" value="fr"
                class="text-[13px] tracking-widest uppercase font-medium leading-none
                       {% if request.locale.iso_code == 'fr' %}text-[#e61a7a]{% else %}text-gray-800 hover:text-[#e61a7a]{% endif %}">
          FR
        </button>
        <button type="submit" name="locale_code" value="he"
                class="text-[15px] font-medium leading-none
                       {% if request.locale.iso_code == 'he' %}text-[#e61a7a]{% else %}text-gray-800 hover:text-[#e61a7a]{% endif %}">
          עב
        </button>
      {% endform %}
    </div>

    <!-- Payment Methods Mobile -->
    <div class="mt-[24px] mb-[32px] flex flex-wrap justify-start items-center w-full gap-5">
      <img src="{{ 'apple-pay.svg' | asset_url }}" alt="Apple Pay" width="56" height="20" class="h-[20px] w-auto object-contain" />
      <img src="{{ 'mastercard.svg' | asset_url }}" alt="Mastercard" width="44" height="26" class="h-[26px] w-auto object-contain" />
      <img src="{{ 'googlePay.svg' | asset_url }}" alt="Google Pay" width="55" height="20" class="h-[20px] w-auto object-contain" />
      <img src="{{ 'visa.svg' | asset_url }}" alt="Visa" width="45" height="14" class="h-[14px] w-auto object-contain" />
    </div>

    <!-- Copyright Mobile -->
    <div class="text-left w-full">
      <p
        class="text-[10px] font-light tracking-widest text-black uppercase"
        style="font-family: var(--font-montserrat), Montserrat, sans-serif; direction: ltr;"
      >
        {{ 'footer.copyright' | t }}
      </p>
    </div>
  </div>
</footer>
