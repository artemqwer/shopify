{% schema %}
{ "name": "Customer Login", "settings": [] }
{% endschema %}

{% assign dir = 'ltr' %}
{% if request.locale.iso_code == 'he' %}{% assign dir = 'rtl' %}{% endif %}

{% if request.locale.iso_code == 'he' %}
  {% assign t_title    = 'כניסה לחשבון' %}
  {% assign t_email    = 'אימייל' %}
  {% assign t_password = 'סיסמה' %}
  {% assign t_forgot   = 'שכחתי סיסמה' %}
  {% assign t_login    = 'כניסה' %}
  {% assign t_no_acc   = 'אין לך חשבון?' %}
  {% assign t_register = 'הרשמה' %}
{% elsif request.locale.iso_code == 'uk' %}
  {% assign t_title    = 'Вхід до акаунту' %}
  {% assign t_email    = 'Email' %}
  {% assign t_password = 'Пароль' %}
  {% assign t_forgot   = 'Забули пароль?' %}
  {% assign t_login    = 'Увійти' %}
  {% assign t_no_acc   = 'Немає акаунту?' %}
  {% assign t_register = 'Зареєструватись' %}
{% elsif request.locale.iso_code == 'fr' %}
  {% assign t_title    = 'Connexion' %}
  {% assign t_email    = 'Email' %}
  {% assign t_password = 'Mot de passe' %}
  {% assign t_forgot   = 'Mot de passe oublié?' %}
  {% assign t_login    = 'Se connecter' %}
  {% assign t_no_acc   = 'Pas de compte?' %}
  {% assign t_register = "S'inscrire" %}
{% else %}
  {% assign t_title    = 'Sign In' %}
  {% assign t_email    = 'Email' %}
  {% assign t_password = 'Password' %}
  {% assign t_forgot   = 'Forgot password?' %}
  {% assign t_login    = 'Sign In' %}
  {% assign t_no_acc   = 'No account yet?' %}
  {% assign t_register = 'Create Account' %}
{% endif %}

{% render 'customers-styles' %}

<div class="acc-page-wrap" dir="{{ dir }}">
  <div class="acc-card">
    <h1>{{ t_title }}</h1>

    {% if form.errors %}
      <div class="acc-error">
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

    {% form 'customer_login' %}
      <div class="acc-field">
        <label class="acc-label" for="login-email">{{ t_email }}</label>
        <input type="email" id="login-email" name="customer[email]" class="acc-input"
               autocomplete="email" autofocus
               value="{{ form.email }}" required>
      </div>
      <div class="acc-field">
        <label class="acc-label" for="login-password">{{ t_password }}</label>
        <input type="password" id="login-password" name="customer[password]" class="acc-input"
               autocomplete="current-password" required>
      </div>
      <button type="submit" class="acc-btn-submit">{{ t_login }}</button>
    {% endform %}

    <div class="acc-links">
      <a href="{{ routes.account_recover_url }}">{{ t_forgot }}</a>
      <a href="{{ routes.account_register_url }}">{{ t_no_acc }} {{ t_register }}</a>
    </div>
  </div>
</div>
