<!doctype html>
<html lang="{{ request.locale.iso_code }}" {% if request.locale.iso_code == 'he' %}dir="rtl"{% else %}dir="ltr"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@100..900&display=swap" rel="stylesheet">
  
  <!-- Add Tailwind CDN for exact pixel-perfect match without build steps -->
  <script src="https://cdn.tailwindcss.com"></script>

  {{ content_for_header }}
  
  <style>
    :root {
      --font-montserrat: 'Montserrat', sans-serif;
    }
    body {
      font-family: 'Inter', sans-serif;
    }

    /* ==========================================
       RTL STYLES — Hebrew only
       - Header: dir="rtl" naturally reverses flex → nav goes RIGHT, cart goes LEFT
       - Grids (hero, products): forced LTR order via direction:ltr
       - Footer columns: forced LTR visual order
    =========================================== */

    /* 1. HEADER — NO overrides needed.
       dir="rtl" on <html> makes the main header flex container go right-to-left:
       - Left nav (Home/Catalog/Popular) appears on the RIGHT side ✅
       - Logo stays in center ✅
       - Right nav (EN/Search/Cart) appears on the LEFT side ✅
       The INTERNAL order within each nav group is also correct via RTL. */

    /* 2. GRID — hero images and product cards stay in LTR visual order */
    [dir="rtl"] .grid { direction: ltr; }
    [dir="rtl"] .grid > * { direction: rtl; }

    /* 3. FOOTER — columns keep LTR visual order (ניווט | צור קשר | מידע משפטי) */
    [dir="rtl"] footer > div { flex-direction: column !important; }
    [dir="rtl"] footer .md\:flex-row { flex-direction: row !important; }
    [dir="rtl"] footer ul { direction: rtl; padding: 0; }
    [dir="rtl"] footer li,
    [dir="rtl"] footer h3,
    [dir="rtl"] footer a { text-align: right; display: block; }

    /* Text alignment only */
    [dir="rtl"] h1, [dir="rtl"] h2 { text-align: center; }
    [dir="rtl"] h3 { text-align: right; }
    [dir="rtl"] p  { text-align: right; }

    /* Product card text — right aligned */
    [dir="rtl"] .product-card h3,
    [dir="rtl"] .product-card p { text-align: right; }
    [dir="rtl"] .product-card > div:last-child { direction: rtl; }

    /* Phone and email — keep LTR direction so numbers don't reverse */
    [dir="rtl"] a[href^="tel:"],
    [dir="rtl"] a[href^="mailto:"] {
      direction: ltr;
      display: inline-block;
      text-align: right;
      unicode-bidi: embed;
    }

    /* Copyright is always centred */
    [dir="rtl"] .text-center { text-align: center !important; }

    /* Hebrew font stack */
    [dir="rtl"] {
      font-family: 'Inter', Arial, 'Noto Sans Hebrew', sans-serif;
    }
  </style>
</head>
<body class="antialiased bg-white text-neutral-900 min-h-screen flex flex-col relative max-w-[1920px] mx-auto">
  {% section 'header' %}
  
  <main class="flex-1 w-full relative" id="MainContent" role="main">
    <div class="pt-0 pb-[36px] md:pb-[120px] max-w-[1920px] mx-auto w-full">
      {{ content_for_layout }}
    </div>
  </main>
  
  <div class="w-full mt-auto">
    {% section 'footer' %}
  </div>

  {% section 'drawers' %}
  <script src="{{ 'drawers.js' | asset_url }}"></script>
</body>
</html>
