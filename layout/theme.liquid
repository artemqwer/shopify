<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>{{ page_title }}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

  <!-- Google Fonts: Montserrat -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Add Tailwind CDN for exact pixel-perfect match without build steps -->
  <script src="https://cdn.tailwindcss.com"></script>

  {{ content_for_header }}

  <script>
    window.Shopify = window.Shopify || {};
    window.Shopify.routes = window.Shopify.routes || {};
    window.Shopify.routes.root = "{{ routes.root_url }}";
  </script>
  
  <style>
    :root {
      --font-montserrat: 'Montserrat', sans-serif;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    /* Reset for shopify top bar */
    #shopify-section-header { z-index: 50; }

    /* Tailwind CDN may not generate responsive utilities — force them here */
    @media (min-width: 768px) {
      .md\:hidden { display: none !important; }
      .hidden.md\:flex { display: flex !important; }
      .hidden.md\:block { display: block !important; }
      .md\:flex { display: flex !important; }
    }

    /* Keep drawers fixed and z-indexed correctly */
    #shopify-section-drawers {
      position: fixed;
      top: 0;
      left: 0;
      width: 0;
      height: 0;
      z-index: 10001;
      pointer-events: none;
      overflow: visible;
    }
    #shopify-section-drawers > * {
      pointer-events: auto;
    }
  </style>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="antialiased bg-white text-neutral-900 min-h-screen flex flex-col relative">
  {% section 'header' %}

  <main class="flex-1 w-full relative" id="MainContent" role="main">
    <div class="{% unless template.name == 'index' %}pt-[60px] md:pt-[102px] pb-[36px] md:pb-[120px]{% else %}pb-0{% endunless %} w-full">
      {{ content_for_layout }}
    </div>
  </main>
  
  {% unless template.name == 'collection' or template.name == 'list-collections' %}
  <!-- Catalog link -->
  <div class="flex md:hidden justify-center pt-[4px] pb-[4px]">
    <a href="{{ routes.all_products_collection_url }}"
       class="text-[13px] md:text-[15px] font-medium text-gray-900 underline underline-offset-4 hover:text-gray-500 transition-colors tracking-wide"
       style="font-family: var(--font-montserrat), Montserrat, sans-serif;">
      {{ 'header.catalog' | t }}
    </a>
  </div>
  {% endunless %}

  <div class="w-full">
    {% section 'footer' %}
  </div>

  {% section 'drawers' %}
  {% section 'cookie-consent' %}
  {% section 'lang-modal' %}

  {% render 'integration-scripts' %}

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('video').forEach(function(v) {
        v.setAttribute('playsinline', '');
        v.setAttribute('webkit-playsinline', '');
        if (v.paused) { v.play().catch(function(){}); }
      });
    });
  </script>

</body>
</html>
