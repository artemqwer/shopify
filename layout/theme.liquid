<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>{{ page_title }}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

  <!-- Add Tailwind CDN for exact pixel-perfect match without build steps -->
  <script src="https://cdn.tailwindcss.com"></script>

  {{ content_for_header }}
  
  <style>
    :root {
      --font-montserrat: 'Montserrat', sans-serif;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    /* Reset for shopify top bar */
    #shopify-section-header { z-index: 50; position: sticky; top: 0; }
  </style>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="antialiased bg-white text-neutral-900 min-h-screen flex flex-col relative max-w-[1920px] mx-auto">
  {% section 'header' %}
  
  <main class="flex-1 w-full relative" id="MainContent" role="main">
    <div class="{% unless template.name == 'index' %}pt-[60px] md:pt-[102px] pb-[36px] md:pb-[120px]{% endunless %} max-w-[1920px] mx-auto w-full">
      {{ content_for_layout }}
    </div>
  </main>
  
  <div class="w-full mt-auto">
    {% section 'footer' %}
  </div>

  {% section 'drawers' %}
  {% section 'cookie-consent' %}

  {% render 'integration-scripts' %}

</body>
</html>
